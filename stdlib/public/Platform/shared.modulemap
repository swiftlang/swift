module WinSDK.Shared [system] {
  module AFUnix {
    header "shared/afunix.h"
    export *
  }

  module DXGI {
    header "shared/dxgi1_6.h"
    export *

    link "dxgi.lib"
  }

  module GUIDDef {
    header "shared/guiddef.h"
    export *
  }

  module APIFamily {
    header "shared/winapifamily.h"
    export *
  }

  module MinWinDef {
    header "shared/minwindef.h"
    export *
  }

  module RPC {
    header "shared/rpc.h"
    export *

    link "RpcRT4.Lib"
  }

  module RPCNDR {
    header "shared/rpcndr.h"
    export *
  }

  module SDDL {
    header "shared/sddl.h"
    export *
  }

  module SDKDDKVer {
    header "shared/sdkddkver.h"
    export *
  }

  module WinError {
    header "shared/winerror.h"
    export *
  }

  module WTypesBase {
    header "shared/wtypesbase.h"
    export *
  }

  module WTypes {
    header "shared/wtypes.h"
    export *
  }
}
