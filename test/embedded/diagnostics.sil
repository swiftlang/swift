// RUN: %target-sil-opt -enable-experimental-feature Embedded -embedded-swift-diagnostics -I %test-resource-dir/embedded -verify %s -o /dev/null

// REQUIRES: swift_feature_Embedded

sil_stage canonical

import Builtin
import Swift
import SwiftShims

struct MyStruct: ~Copyable {
  deinit
}

sil [ossa] @testit : $@convention(thin) (@owned MyStruct) -> @owned MyStruct {
bb0(%0 : @owned $MyStruct):
  cond_br undef, bb1, bb2

bb1:
  destroy_value [dead_end] %0
  unreachable

bb2:
  return %0
}

sil [ossa] @tuple_pack_element_addr : $@convention(thin) (@in_guaranteed (Int, Int)) -> () {
bb0(%0 : $*(Int, Int)):
  %zero = scalar_pack_index 0 of $Pack{Int, Int}
  %addr = tuple_pack_element_addr %zero of %0 as $*Int // expected-error{{cannot specialize pack expression or statement in embedded Swift. This is a compiler bug. Please file a bug with a small example of the bug}}
  %res = tuple ()
  return %res
}

sil [ossa] @open_pack_element : $@convention(thin) (@in_guaranteed (Int, Int)) -> () {
bb0(%0 : $*(Int, Int)):
  %zero = scalar_pack_index 0 of $Pack{Int, Int}
  %ope = open_pack_element %zero of <each U> at <Pack{Int, Int}>, shape $each U, id 1 // expected-error{{cannot specialize pack expression or statement in embedded Swift. This is a compiler bug. Please file a bug with a small example of the bug}}
  %res = tuple ()
  return %res
}
