// RUN: %target-sil-opt -sil-ownership-verifier-enable-testing %s -o /dev/null 2>&1 | %FileCheck %s

class Klass {}

public struct Wrapper {
  @_hasStorage var _k: Klass { get set }
  var k: Klass
}

sil [ossa] @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass {
bb0(%0 : @guaranteed $Wrapper):
  %2 = struct_extract %0, #Wrapper._k             
  return %2                                       
}

sil @get_wrapper : $@convention(thin) () -> @owned Klass
sil @use_klass : $@convention(thin) (@guaranteed Klass) -> ()

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_missing_end_borrow'
// CHECK: Non trivial values, non address values, and non guaranteed function args must have at least one lifetime ending use?!
// CHECK: Value:   %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_missing_end_borrow'
sil [ossa] @test_missing_end_borrow : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  %1 = begin_borrow %0
  %2 = function_ref @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %4 = function_ref @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
  %5 = apply %4(%3) : $@convention(thin) (@guaranteed Klass) -> ()
  end_borrow %1
  destroy_value %0
  %8 = tuple ()
  return %8
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_use_after_end_borrow'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
// CHECK: Consuming User:   end_borrow %3 : $Klass
// CHECK: Non Consuming User:   %6 = apply %5(%3) : $@convention(thin) (@guaranteed Klass) -> ()
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_use_after_end_borrow'
sil [ossa] @test_use_after_end_borrow : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  %1 = begin_borrow %0
  %2 = function_ref @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  end_borrow %3
  %5 = function_ref @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
  %6 = apply %5(%3) : $@convention(thin) (@guaranteed Klass) -> ()
  end_borrow %1
  destroy_value %0
  %9 = tuple ()
  return %9
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_self_scope_ends_before_result_scope'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %1 = begin_borrow %0 : $Wrapper
// CHECK: Consuming User:   end_borrow %1 : $Wrapper
// CHECK: Non Consuming User:   end_borrow %3 : $Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_self_scope_ends_before_result_scope'
sil [ossa] @test_self_scope_ends_before_result_scope : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  %1 = begin_borrow %0
  %2 = function_ref @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %4 = function_ref @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
  %5 = apply %4(%3) : $@convention(thin) (@guaranteed Klass) -> ()
  end_borrow %1
  end_borrow %3
  destroy_value %0
  %9 = tuple ()
  return %9
}

// CHECK-NOT: Function: 'test_reborrow_result'
// A borrow accessor result is a borrow introducer, which may be reborrowed.
sil [ossa] @test_reborrow_result : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  %1 = begin_borrow %0
  cond_br undef, bb1, bb2

bb1:
  %3 = function_ref @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %4 = apply %3(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  br bb3(%4)

bb2:
  %6 = struct_extract %1, #Wrapper._k
  %7 = begin_borrow %6
  br bb3(%7)

bb3(%9 : @reborrow $Klass):
  %10 = borrowed %9 from (%1)
  end_borrow %10
  end_borrow %1
  destroy_value %0
  %14 = tuple ()
  return %14
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_use_after_free_owned_self'
// CHECK: Found outside of lifetime use?!
// CHECK: Value: %0 = argument of bb0 : $Wrapper
// CHECK: Consuming User:   destroy_value %0 : $Wrapper
// CHECK: Non Consuming User:   end_borrow %2 : $Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_use_after_free_owned_self'
// Like begin_borrow, a borrow accessor may borrow an owned self.
sil [ossa] @test_use_after_free_owned_self : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  %1 = function_ref @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %2 = apply %1(%0) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  destroy_value %0
  %4 = function_ref @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
  %5 = apply %4(%2) : $@convention(thin) (@guaranteed Klass) -> ()
  end_borrow %2
  %7 = tuple ()
  return %7
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_use_after_free_guaranteed_self'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %1 = begin_borrow %0 : $Wrapper
// CHECK: Consuming User:   end_borrow %1 : $Wrapper
// CHECK: Non Consuming User:   end_borrow %3 : $Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_use_after_free_guaranteed_self'
sil [ossa] @test_use_after_free_guaranteed_self : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  %1 = begin_borrow %0
  %2 = function_ref @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  end_borrow %1
  %4 = function_ref @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
  %5 = apply %4(%3) : $@convention(thin) (@guaranteed Klass) -> ()
  end_borrow %3
  destroy_value %0
  %6 = tuple ()
  return %6
}

sil @borrow_with_index : $@convention(method) (@guaranteed Klass, @guaranteed Wrapper) -> @guaranteed Klass

// CHECK-NOT: Function: 'test_index_is_not_borrowed'
// Only self is borrowed over the scope of the result. An index is an
// instantaneous use.
sil [ossa] @test_index_is_not_borrowed : $@convention(thin) (@owned Wrapper, @owned Klass) -> () {
bb0(%0 : @owned $Wrapper, %1 : @owned $Klass):
  %2 = function_ref @borrow_with_index : $@convention(method) (@guaranteed Klass, @guaranteed Wrapper) -> @guaranteed Klass
  %3 = apply %2(%1, %0) : $@convention(method) (@guaranteed Klass, @guaranteed Wrapper) -> @guaranteed Klass
  destroy_value %1
  %5 = function_ref @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
  %6 = apply %5(%3) : $@convention(thin) (@guaranteed Klass) -> ()
  end_borrow %3
  destroy_value %0
  %9 = tuple ()
  return %9
}

sil @borrow_without_self : $@convention(thin) () -> @guaranteed Klass

// The result of a borrow accessor without self is also a borrow introducer.
// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_missing_end_borrow_without_self'
// CHECK: Non trivial values, non address values, and non guaranteed function args must have at least one lifetime ending use?!
// CHECK: Value:   %1 = apply %0() : $@convention(thin) () -> @guaranteed Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_missing_end_borrow_without_self'
sil [ossa] @test_missing_end_borrow_without_self : $@convention(thin) () -> () {
bb0:
  %0 = function_ref @borrow_without_self : $@convention(thin) () -> @guaranteed Klass
  %1 = apply %0() : $@convention(thin) () -> @guaranteed Klass
  %2 = function_ref @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
  %3 = apply %2(%1) : $@convention(thin) (@guaranteed Klass) -> ()
  %4 = tuple ()
  return %4
}

class WrapperBox {
  @_hasStorage var w: Wrapper
}

sil @borrow_klass_from_address : $@convention(method) (@in_guaranteed Wrapper) -> @guaranteed Klass
struct KlassPair {
  var k: Klass
}

sil @use_klass_pair : $@convention(thin) (@guaranteed KlassPair) -> ()

// The class reference that contains an @in_guaranteed self must be borrowed over the scope of
// the result.
// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_address_self_outlives_result'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %1 = begin_borrow %0 : $WrapperBox
// CHECK: Consuming User:   end_borrow %1 : $WrapperBox
// CHECK: Non Consuming User:   end_borrow %4 : $Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_address_self_outlives_result'
sil [ossa] @test_address_self_outlives_result : $@convention(thin) (@owned WrapperBox) -> () {
bb0(%0 : @owned $WrapperBox):
  %1 = begin_borrow %0
  %2 = ref_element_addr %1, #WrapperBox.w
  %3 = function_ref @borrow_klass_from_address : $@convention(method) (@in_guaranteed Wrapper) -> @guaranteed Klass
  %4 = apply %3(%2) : $@convention(method) (@in_guaranteed Wrapper) -> @guaranteed Klass
  end_borrow %1
  end_borrow %4
  destroy_value %0
  %8 = tuple ()
  return %8
}

// A guaranteed phi of a value forwarded from the result is used within the scope of the result.
// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_forwarded_result_phi_outlives_result'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
// CHECK: Consuming User:   end_borrow %3 : $Klass
// CHECK: Non Consuming User:   %10 = apply %9(%7) : $@convention(thin) (@guaranteed KlassPair) -> ()
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_forwarded_result_phi_outlives_result'
sil [ossa] @test_forwarded_result_phi_outlives_result : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  %1 = begin_borrow %0
  %2 = function_ref @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %4 = struct $KlassPair (%3)
  br bb1(%4)

bb1(%6 : @guaranteed $KlassPair):
  %7 = borrowed %6 from (%3)
  end_borrow %3
  %8 = function_ref @use_klass_pair : $@convention(thin) (@guaranteed KlassPair) -> ()
  %9 = apply %8(%7) : $@convention(thin) (@guaranteed KlassPair) -> ()
  end_borrow %1
  destroy_value %0
  %12 = tuple ()
  return %12
}

sil @borrow_address_of_object_self : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
sil @mutate_address_of_object_self : $@convention(method) (@guaranteed Wrapper) -> @inout Klass

// The address result of an accessor with an object self is an interior pointer
// of self.
// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_address_result_use_after_end_borrow'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %2 = begin_borrow %0 : $Wrapper
// CHECK: Consuming User:   end_borrow %2 : $Wrapper
// CHECK: Non Consuming User:   store %1 to [assign] %4 : $*Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_address_result_use_after_end_borrow'
sil [ossa] @test_address_result_use_after_end_borrow : $@convention(thin) (@owned Wrapper, @owned Klass) -> () {
bb0(%0 : @owned $Wrapper, %1 : @owned $Klass):
  %2 = begin_borrow %0
  %3 = function_ref @mutate_address_of_object_self : $@convention(method) (@guaranteed Wrapper) -> @inout Klass
  %4 = apply %3(%2) : $@convention(method) (@guaranteed Wrapper) -> @inout Klass
  end_borrow %2
  store %1 to [assign] %4
  destroy_value %0
  %8 = tuple ()
  return %8
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_address_result_returned_after_end_borrow'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %2 = load_borrow %0 : $*Wrapper
// CHECK: Consuming User:   end_borrow %2 : $Wrapper
// CHECK: Non Consuming User:   return %3 : $*Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_address_result_returned_after_end_borrow'
sil [ossa] @test_address_result_returned_after_end_borrow : $@convention(method) (@in_guaranteed Wrapper) -> @guaranteed_address Klass {
bb0(%0 : $*Wrapper):
  %1 = function_ref @borrow_address_of_object_self : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
  %2 = load_borrow %0
  %3 = apply %1(%2) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
  end_borrow %2
  return %3
}

// CHECK-NOT: Function: 'test_address_result_return_borrow'
// The address result may be returned from within the borrow scope of self.
sil [ossa] @test_address_result_return_borrow : $@convention(method) (@in_guaranteed Wrapper) -> @guaranteed_address Klass {
bb0(%0 : $*Wrapper):
  %1 = function_ref @borrow_address_of_object_self : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
  %2 = load_borrow %0
  %3 = apply %1(%2) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
  return_borrow %3 : $*Klass from_scopes (%2 : $Wrapper)
}

// An owned self may be passed directly to an accessor with an address result.
// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_address_result_use_after_destroy_owned_self'
// CHECK: Found outside of lifetime use?!
// CHECK: Value: %0 = argument of bb0 : $Wrapper
// CHECK: Consuming User:   destroy_value %0 : $Wrapper
// CHECK: Non Consuming User:   %4 = load [copy] %2 : $*Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_address_result_use_after_destroy_owned_self'
sil [ossa] @test_address_result_use_after_destroy_owned_self : $@convention(thin) (@owned Wrapper) -> @owned Klass {
bb0(%0 : @owned $Wrapper):
  %1 = function_ref @borrow_address_of_object_self : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
  %2 = apply %1(%0) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
  destroy_value %0
  %4 = load [copy] %2
  return %4
}

// CHECK-NOT: Function: 'test_address_result_owned_self'
sil [ossa] @test_address_result_owned_self : $@convention(thin) (@owned Wrapper) -> @owned Klass {
bb0(%0 : @owned $Wrapper):
  %1 = function_ref @borrow_address_of_object_self : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
  %2 = apply %1(%0) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed_address Klass
  %3 = load [copy] %2
  destroy_value %0
  return %3
}

class KlassHolder {
  @_hasStorage let k: Klass
}

public struct HolderWrapper {
  @_hasStorage var _h: KlassHolder { get set }
}

sil @borrow_holder : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder

// The address result of a borrow accessor is an interior pointer of the scopes
// it is projected from, which return_borrow must end.
// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_projection_returned_without_scope'
// CHECK: Non trivial values, non address values, and non guaranteed function args must have at least one lifetime ending use?!
// CHECK: Value:   %1 = load_borrow %0 : $*HolderWrapper
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_projection_returned_without_scope'
sil [ossa] @test_projection_returned_without_scope : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = struct_extract %1, #HolderWrapper._h
  %3 = ref_element_addr %2, #KlassHolder.k
  return %3
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_projection_returned_after_end_borrow'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %1 = load_borrow %0 : $*HolderWrapper
// CHECK: Consuming User:   end_borrow %1 : $HolderWrapper
// CHECK: Non Consuming User:   return %3 : $*Klass
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_projection_returned_after_end_borrow'
sil [ossa] @test_projection_returned_after_end_borrow : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = struct_extract %1, #HolderWrapper._h
  %3 = ref_element_addr %2, #KlassHolder.k
  end_borrow %1
  return %3
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_projection_returned_from_other_scope'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %1 = load_borrow %0 : $*HolderWrapper
// CHECK: Consuming User:   end_borrow %1 : $HolderWrapper
// CHECK: Non Consuming User:   return_borrow %3 : $*Klass from_scopes (%5 : $HolderWrapper)
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_projection_returned_from_other_scope'
sil [ossa] @test_projection_returned_from_other_scope : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = struct_extract %1, #HolderWrapper._h
  %3 = ref_element_addr %2, #KlassHolder.k
  end_borrow %1
  %5 = load_borrow %0
  return_borrow %3 from_scopes (%5)
}

// CHECK-NOT: Function: 'test_nested_projection_return_borrow'
sil [ossa] @test_nested_projection_return_borrow : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = begin_borrow %1
  %3 = struct_extract %2, #HolderWrapper._h
  %4 = ref_element_addr %3, #KlassHolder.k
  return_borrow %4 from_scopes (%2, %1)
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_nested_projection_returned_after_inner_end_borrow'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %2 = begin_borrow %1 : $HolderWrapper
// CHECK: Consuming User:   end_borrow %2 : $HolderWrapper
// CHECK: Non Consuming User:   return_borrow %4 : $*Klass from_scopes (%1 : $HolderWrapper)
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_nested_projection_returned_after_inner_end_borrow'
sil [ossa] @test_nested_projection_returned_after_inner_end_borrow : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = begin_borrow %1
  %3 = struct_extract %2, #HolderWrapper._h
  %4 = ref_element_addr %3, #KlassHolder.k
  end_borrow %2
  return_borrow %4 from_scopes (%1)
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_nested_projection_returned_without_outer_scope'
// CHECK: Non trivial values, non address values, and non guaranteed function args must have at least one lifetime ending use?!
// CHECK: Value:   %1 = load_borrow %0 : $*HolderWrapper
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_nested_projection_returned_without_outer_scope'
sil [ossa] @test_nested_projection_returned_without_outer_scope : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = begin_borrow %1
  %3 = struct_extract %2, #HolderWrapper._h
  %4 = ref_element_addr %3, #KlassHolder.k
  return_borrow %4 from_scopes (%2)
}

// The result of another borrow accessor is a borrow scope.
// CHECK-NOT: Function: 'test_accessor_result_projection_return_borrow'
sil [ossa] @test_accessor_result_projection_return_borrow : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = function_ref @borrow_holder : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder
  %3 = apply %2(%1) : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder
  %4 = ref_element_addr %3, #KlassHolder.k
  return_borrow %4 from_scopes (%3, %1)
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_accessor_result_projection_returned_after_end_borrow'
// CHECK: Found outside of lifetime use?!
// CHECK: Value:   %3 = apply %2(%1) : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder
// CHECK: Consuming User:   end_borrow %3 : $KlassHolder
// CHECK: Non Consuming User:   return_borrow %4 : $*Klass from_scopes (%1 : $HolderWrapper)
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_accessor_result_projection_returned_after_end_borrow'
sil [ossa] @test_accessor_result_projection_returned_after_end_borrow : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = function_ref @borrow_holder : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder
  %3 = apply %2(%1) : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder
  %4 = ref_element_addr %3, #KlassHolder.k
  end_borrow %3
  return_borrow %4 from_scopes (%1)
}

// CHECK-LABEL: Error#: 0. Begin Error in Function: 'test_accessor_result_projection_returned_without_scope'
// CHECK: Non trivial values, non address values, and non guaranteed function args must have at least one lifetime ending use?!
// CHECK: Value:   %3 = apply %2(%1) : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder
// CHECK-LABEL: Error#: 0. End Error in Function: 'test_accessor_result_projection_returned_without_scope'
sil [ossa] @test_accessor_result_projection_returned_without_scope : $@convention(method) (@in_guaranteed HolderWrapper) -> @guaranteed_address Klass {
bb0(%0 : $*HolderWrapper):
  %1 = load_borrow %0
  %2 = function_ref @borrow_holder : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder
  %3 = apply %2(%1) : $@convention(method) (@guaranteed HolderWrapper) -> @guaranteed KlassHolder
  %4 = ref_element_addr %3, #KlassHolder.k
  return_borrow %4 from_scopes (%1)
}
