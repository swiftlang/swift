// RUN: %target-sil-opt -enable-experimental-feature OnceFunctions -verify-continue-on-failure -enable-sil-verify-all=0 %s 2>&1 | %FileCheck %s

// REQUIRES: swift_feature_OnceFunctions

sil_stage canonical

import Swift

// Without the attribute, a conversion can't drop the exactly-once guarantee.
// CHECK: Begin Error in function ordinary_conversion_drops_exactly_once
// CHECK: SIL verification failed: convert_function cannot drop execution semantics
// CHECK: End Error in function ordinary_conversion_drops_exactly_once
sil [ossa] @ordinary_conversion_drops_exactly_once : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> () {
bb0(%0 : @owned $@once @callee_owned () -> ()):
  %1 = convert_function %0 : $@once @callee_owned () -> () to $@callable(once) @callee_owned () -> ()
  return %1 : $@callable(once) @callee_owned () -> ()
}

// A noncopyable function owns its context, so only a thunk can form one from a
// copyable function, whose context can be shared.
// CHECK: Begin Error in function ordinary_conversion_forms_at_most_once
// CHECK: SIL verification failed: convert_function cannot form a noncopyable value; a thunk must form it
// CHECK: End Error in function ordinary_conversion_forms_at_most_once
sil [ossa] @ordinary_conversion_forms_at_most_once : $@convention(thin) (@owned @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> () {
bb0(%0 : @owned $@callee_owned () -> ()):
  %1 = convert_function %0 : $@callee_owned () -> () to $@callable(once) @callee_owned () -> ()
  return %1 : $@callable(once) @callee_owned () -> ()
}

// CHECK: Begin Error in function noescape_conversion_forms_at_most_once
// CHECK: SIL verification failed: convert_escape_to_noescape cannot change execution semantics
// CHECK: End Error in function noescape_conversion_forms_at_most_once
sil [ossa] @noescape_conversion_forms_at_most_once : $@convention(thin) (@owned @callee_owned () -> ()) -> () {
bb0(%0 : @owned $@callee_owned () -> ()):
  %1 = convert_escape_to_noescape %0 : $@callee_owned () -> () to $@noescape @callable(once) @callee_owned () -> ()
  destroy_value %1 : $@noescape @callable(once) @callee_owned () -> ()
  %3 = tuple ()
  return %3 : $()
}

// The attribute only converts an exactly-once function.
// CHECK: Begin Error in function discard_from_at_most_once
// CHECK: SIL verification failed: convert_function [without_actually_deiniting] must convert an exactly-once function to an at-most-once function
// CHECK: End Error in function discard_from_at_most_once
sil [ossa] @discard_from_at_most_once : $@convention(thin) (@owned @callable(once) @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> () {
bb0(%0 : @owned $@callable(once) @callee_owned () -> ()):
  %1 = convert_function %0 : $@callable(once) @callee_owned () -> () to [without_actually_deiniting] $@callable(once) @callee_owned () -> ()
  return %1 : $@callable(once) @callee_owned () -> ()
}

// CHECK: Begin Error in function discard_from_plain
// CHECK: SIL verification failed: convert_function [without_actually_deiniting] must convert an exactly-once function to an at-most-once function
// CHECK: End Error in function discard_from_plain
sil [ossa] @discard_from_plain : $@convention(thin) (@owned @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> () {
bb0(%0 : @owned $@callee_owned () -> ()):
  %1 = convert_function %0 : $@callee_owned () -> () to [without_actually_deiniting] $@callable(once) @callee_owned () -> ()
  return %1 : $@callable(once) @callee_owned () -> ()
}

// The attribute only produces an at-most-once function.
// CHECK: Begin Error in function discard_to_exactly_once
// CHECK: SIL verification failed: convert_function [without_actually_deiniting] must convert an exactly-once function to an at-most-once function
// CHECK: End Error in function discard_to_exactly_once
sil [ossa] @discard_to_exactly_once : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @once @callee_owned () -> () {
bb0(%0 : @owned $@once @callee_owned () -> ()):
  %1 = convert_function %0 : $@once @callee_owned () -> () to [without_actually_deiniting] $@once @callee_owned () -> ()
  return %1 : $@once @callee_owned () -> ()
}

// CHECK: Begin Error in function discard_to_plain
// CHECK: SIL verification failed: convert_function [without_actually_deiniting] must convert an exactly-once function to an at-most-once function
// CHECK: End Error in function discard_to_plain
sil [ossa] @discard_to_plain : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @callee_owned () -> () {
bb0(%0 : @owned $@once @callee_owned () -> ()):
  %1 = convert_function %0 : $@once @callee_owned () -> () to [without_actually_deiniting] $@callee_owned () -> ()
  return %1 : $@callee_owned () -> ()
}
