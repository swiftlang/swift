// RUN: %target-sil-opt -sil-print-types -enable-experimental-feature OnceFunctions %s | %FileCheck %s

// REQUIRES: swift_feature_OnceFunctions

// Check that the convert_function [without_actually_discarding] attribute is
// parsed and printed.
// CHECK-LABEL: sil hidden [ossa] @testWithoutActuallyDiscarding : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> () {
// CHECK: convert_function %0 : $@once @callee_owned () -> () to [without_actually_discarding] $@callable(once) @callee_owned () -> ()
sil hidden [ossa] @testWithoutActuallyDiscarding : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> () {
bb0(%0 : @owned $@once @callee_owned () -> ()):
  %1 = convert_function %0 : $@once @callee_owned () -> () to [without_actually_discarding] $@callable(once) @callee_owned () -> ()
  return %1 : $@callable(once) @callee_owned () -> ()
}

// The attribute also works on a non-escaping function.
// CHECK-LABEL: sil hidden [ossa] @testWithoutActuallyDiscardingNoEscape : $@convention(thin) (@guaranteed @noescape @once @callee_guaranteed () -> ()) -> () {
// CHECK: convert_function %0 : $@noescape @once @callee_guaranteed () -> () to [without_actually_discarding] $@noescape @callable(once) @callee_guaranteed () -> ()
sil hidden [ossa] @testWithoutActuallyDiscardingNoEscape : $@convention(thin) (@guaranteed @noescape @once @callee_guaranteed () -> ()) -> () {
bb0(%0 : @guaranteed $@noescape @once @callee_guaranteed () -> ()):
  %1 = convert_function %0 : $@noescape @once @callee_guaranteed () -> () to [without_actually_discarding] $@noescape @callable(once) @callee_guaranteed () -> ()
  %2 = tuple ()
  return %2 : $()
}
