// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all=true %s | %FileCheck %s

sil_stage canonical

import Builtin
import Swift

// CHECK-LABEL: sil [ossa] @take_called_once : $@convention(thin) (@owned @called(once) @callee_guaranteed () -> ()) -> () {
// CHECK: bb0(%0 : @owned $@called(once) @callee_guaranteed () -> ()):
// CHECK:   destroy_value %0 : $@called(once) @callee_guaranteed () -> ()
// CHECK: } // end sil function 'take_called_once'
sil [ossa] @take_called_once : $@convention(thin) (@owned @called(once) @callee_guaranteed () -> ()) -> () {
bb0(%0 : @owned $@called(once) @callee_guaranteed () -> ()):
  destroy_value %0 : $@called(once) @callee_guaranteed () -> ()
  %1 = tuple ()
  return %1 : $()
}

// CHECK-LABEL: sil [ossa] @produce_called_once : $@convention(thin) () -> @owned @called(once) @callee_guaranteed () -> () {
// CHECK:   [[F:%.*]] = function_ref @thin_callee : $@convention(thin) () -> ()
// CHECK:   [[PA:%.*]] = partial_apply [callee_guaranteed] [[F]]() : $@convention(thin) () -> ()
// CHECK:   [[R:%.*]] = convert_function [[PA]] : $@callee_guaranteed () -> () to $@called(once) @callee_guaranteed () -> ()
// CHECK:   return [[R]] : $@called(once) @callee_guaranteed () -> ()
// CHECK: } // end sil function 'produce_called_once'
sil [ossa] @produce_called_once : $@convention(thin) () -> @owned @called(once) @callee_guaranteed () -> () {
bb0:
  %f = function_ref @thin_callee : $@convention(thin) () -> ()
  %pa = partial_apply [callee_guaranteed] %f() : $@convention(thin) () -> ()
  %r = convert_function %pa : $@callee_guaranteed () -> () to $@called(once) @callee_guaranteed () -> ()
  return %r : $@called(once) @callee_guaranteed () -> ()
}

sil @thin_callee : $@convention(thin) () -> ()
