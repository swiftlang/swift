// RUN: %target-sil-opt %s | %FileCheck %s

class Klass {}

public struct Wrapper {
  @_hasStorage var _k: Klass { get set }
  var k: Klass
}

public struct GenWrapper<T> {
  @_hasStorage var _prop: T { get set }
  public var prop: T
}

// CHECK-LABEL: sil [ossa] @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass {
sil [ossa] @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass {
bb0(%0 : @guaranteed $Wrapper):
  %2 = struct_extract %0, #Wrapper._k             
  return %2                                       
}

// CHECK-LABEL: sil [ossa] @borrow_addressonly_prop : $@convention(method) <T> (@in_guaranteed GenWrapper<T>) -> @guaranteed_address T {
sil [ossa] @borrow_addressonly_prop : $@convention(method) <T> (@in_guaranteed GenWrapper<T>) -> @guaranteed_address T {
bb0(%0 : $*GenWrapper<T>):
  %2 = struct_element_addr %0, #GenWrapper._prop  
  return %2                                       
}

// CHECK-LABEL: sil [ossa] @mutate_loadable_prop : $@convention(method) (@inout Wrapper) -> @inout Klass {
sil [ossa] @mutate_loadable_prop : $@convention(method) (@inout Wrapper) -> @inout Klass {
bb0(%0 : $*Wrapper):
  %2 = struct_element_addr %0, #Wrapper._k
  return %2
}

// CHECK-LABEL: sil [ossa] @mutate_addressonly_prop : $@convention(method) <T> (@inout GenWrapper<T>) -> @inout T {
sil [ossa] @mutate_addressonly_prop : $@convention(method) <T> (@inout GenWrapper<T>) -> @inout T {
bb0(%0 : $*GenWrapper<T>):
  %2 = struct_element_addr %0, #GenWrapper._prop
  return %2
}

sil @get_wrapper : $@convention(thin) () -> @owned Klass
sil @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
sil @use_T : $@convention(thin) <T> (@in_guaranteed T) -> ()

sil [ossa] @test1 : $@convention(thin) (@owned Wrapper) -> () {
bb0(%0 : @owned $Wrapper):
  %1 = begin_borrow %0
  %2 = function_ref @borrow_loadable_prop : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %3 = apply %2(%1) : $@convention(method) (@guaranteed Wrapper) -> @guaranteed Klass
  %4 = copy_value %3
  end_borrow %3
  %5 = function_ref @use_klass : $@convention(thin) (@guaranteed Klass) -> ()
  %6 = apply %5(%4) : $@convention(thin) (@guaranteed Klass) -> ()
  destroy_value %4
  end_borrow %1
  destroy_value %0
  %10 = tuple ()
  return %10
}

sil [ossa] @test2 : $@convention(thin) <T> (@in GenWrapper<T>) -> () {
bb0(%0 : $*GenWrapper<T>):
  %1 = function_ref @borrow_addressonly_prop : $@convention(method) <τ_0_0> (@in_guaranteed GenWrapper<τ_0_0>) -> @guaranteed_address τ_0_0
  %2 = apply %1<T>(%0) : $@convention(method) <τ_0_0> (@in_guaranteed GenWrapper<τ_0_0>) -> @guaranteed_address τ_0_0
  %3 = function_ref @use_T : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  %4 = apply %3<T>(%2) : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  destroy_addr %0
  %6 = tuple ()
  return %6
}


class C {
  @_hasStorage final let _k: Klass { get }
  init(_ k: Klass)
  var k: Klass { borrow }
  var m: Klass { borrow mutate }
}

protocol P {
  var k: Klass { borrow mutate }
}

struct S : P {
  @_hasStorage var _k: Klass { get set }
  var k: Klass { borrow mutate }
}

sil @C_k_borrow : $@convention(method) (@guaranteed C) -> @guaranteed Klass
sil @C_m_borrow : $@convention(method) (@guaranteed C) -> @guaranteed Klass
sil @C_m_mutate : $@convention(method) (@guaranteed C) -> @inout Klass
sil @S_k_borrow : $@convention(witness_method: P) (@in_guaranteed S) -> @guaranteed Klass
sil @S_k_mutate : $@convention(witness_method: P) (@inout S) -> @inout Klass

// CHECK-LABEL: sil [ossa] @class_method_borrow : $@convention(thin) (@guaranteed C) -> () {
// CHECK:         class_method %0, #C.k!borrow : (C) -> () -> Klass, $@convention(method) (@guaranteed C) -> @guaranteed Klass
// CHECK-LABEL: } // end sil function 'class_method_borrow'
sil [ossa] @class_method_borrow : $@convention(thin) (@guaranteed C) -> () {
bb0(%0 : @guaranteed $C):
  %1 = class_method %0, #C.k!borrow : (C) -> () -> Klass, $@convention(method) (@guaranteed C) -> @guaranteed Klass
  %2 = tuple ()
  return %2
}

// CHECK-LABEL: sil [ossa] @class_method_mutate : $@convention(thin) (@guaranteed C) -> () {
// CHECK:         class_method %0, #C.m!mutate : (C) -> () -> Klass, $@convention(method) (@guaranteed C) -> @inout Klass
// CHECK-LABEL: } // end sil function 'class_method_mutate'
sil [ossa] @class_method_mutate : $@convention(thin) (@guaranteed C) -> () {
bb0(%0 : @guaranteed $C):
  %1 = class_method %0, #C.m!mutate : (C) -> () -> Klass, $@convention(method) (@guaranteed C) -> @inout Klass
  %2 = tuple ()
  return %2
}

// CHECK-LABEL: sil [ossa] @witness_method_borrow_mutate : $@convention(thin) <T where T : P> () -> () {
// CHECK:         witness_method $T, #P.k!borrow : <Self where Self : P> (Self) -> () -> Klass : $@convention(witness_method: P) <τ_0_0 where τ_0_0 : P> (@in_guaranteed τ_0_0) -> @guaranteed Klass
// CHECK:         witness_method $T, #P.k!mutate : <Self where Self : P> (inout Self) -> () -> Klass : $@convention(witness_method: P) <τ_0_0 where τ_0_0 : P> (@inout τ_0_0) -> @inout Klass
// CHECK-LABEL: } // end sil function 'witness_method_borrow_mutate'
sil [ossa] @witness_method_borrow_mutate : $@convention(thin) <T where T : P> () -> () {
bb0:
  %0 = witness_method $T, #P.k!borrow : <Self where Self : P> (Self) -> () -> Klass : $@convention(witness_method: P) <τ_0_0 where τ_0_0 : P> (@in_guaranteed τ_0_0) -> @guaranteed Klass
  %1 = witness_method $T, #P.k!mutate : <Self where Self : P> (inout Self) -> () -> Klass : $@convention(witness_method: P) <τ_0_0 where τ_0_0 : P> (@inout τ_0_0) -> @inout Klass
  %2 = tuple ()
  return %2
}

// CHECK-LABEL: sil_vtable C {
// CHECK-NEXT:    #C.k!borrow: (C) -> () -> Klass : @C_k_borrow
// CHECK-NEXT:    #C.m!borrow: (C) -> () -> Klass : @C_m_borrow
// CHECK-NEXT:    #C.m!mutate: (C) -> () -> Klass : @C_m_mutate
// CHECK-NEXT:  }
sil_vtable C {
  #C.k!borrow: (C) -> () -> Klass : @C_k_borrow
  #C.m!borrow: (C) -> () -> Klass : @C_m_borrow
  #C.m!mutate: (C) -> () -> Klass : @C_m_mutate
}

// CHECK-LABEL: sil_witness_table S: P module main {
// CHECK-NEXT:    method #P.k!borrow: <Self where Self : P> (Self) -> () -> Klass : @S_k_borrow
// CHECK-NEXT:    method #P.k!mutate: <Self where Self : P> (inout Self) -> () -> Klass : @S_k_mutate
// CHECK-NEXT:  }
sil_witness_table S: P module main {
  method #P.k!borrow: <Self where Self : P> (Self) -> () -> Klass : @S_k_borrow
  method #P.k!mutate: <Self where Self : P> (inout Self) -> () -> Klass : @S_k_mutate
}
