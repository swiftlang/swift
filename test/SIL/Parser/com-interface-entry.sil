// RUN: %empty-directory(%t)
// RUN: %target-swift-frontend -enable-experimental-com-interop -module-name COM -emit-module-path %t/COM.swiftmodule %S/../../Inputs/COM.swift
// RUN: %target-swift-frontend -enable-experimental-com-interop -I %t -module-name main -parse-sil -emit-sil -sil-verify-all %s | %FileCheck %s

sil_stage canonical

import Builtin
import Swift
import COM

@com(interface: "20000000-0000-0000-0000-000000000001")
protocol IInterface {
  func method()
}

@com
final class Implementation : IInterface {
  func method()
  deinit
}

sil hidden_external @witness : $@convention(witness_method: IInterface) <τ_0_0 where τ_0_0 : IInterface> (@in_guaranteed τ_0_0) -> ()
sil hidden_external @interface : $@convention(com_method) (@guaranteed Implementation) -> ()

// A COM existential can be opened directly from its one-word address.

// CHECK-LABEL: sil @open_interface
// CHECK: [[OPENED:%.*]] = open_existential_addr mutable_access %0 to $*@opened({{.*}}, any IInterface) Self
// CHECK: return
sil @open_interface : $@convention(thin) (@inout any IInterface) -> () {
bb0(%0 : $*any IInterface):
  %1 = open_existential_addr mutable_access %0 to $*@opened(1, any IInterface) Self
  %2 = tuple ()
  return %2 : $()
}

// CHECK-LABEL: sil_witness_table hidden Implementation: IInterface module main {
// CHECK: method #IInterface.method:
// CHECK-SAME: : @witness
// CHECK-SAME: , com @interface
// CHECK: }
sil_witness_table hidden Implementation: IInterface module main {
  method #IInterface.method: <Self where Self : IInterface> (Self) -> () -> () : @witness, com @interface
}
