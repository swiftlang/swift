// RUN: %target-sil-opt %s -module-name WitnessTableWithGP | %target-sil-opt -module-name WitnessTableWithGP | %FileCheck %s

// Tests parsing and printing of witness tables for generic conformances whose
// associated conformances are specialized conformances of other generic types,
// substituted with the conforming type's (inherited) generic parameters.
//
// This test intentionally defines all of its own protocols instead of
// importing the standard library, so that it does not depend on stdlib
// implementation details.

sil_stage raw

import Builtin

public protocol _SequenceBase {}

public protocol IteratorProtocol {
  associatedtype Element
}

public protocol _Sequence : _SequenceBase {
  associatedtype Iterator : IteratorProtocol
}

public protocol Collection : _Sequence {
  associatedtype Element
  associatedtype Index
}

// A generic iterator whose generic parameter is itself constrained to a
// protocol with an associated type.
public struct mmEnumerateIterator<Base : IteratorProtocol> : IteratorProtocol {
  public typealias Element = (index: Builtin.Int64, element: Base.Element)
  var base: Base
  var count: Builtin.Int64
}

// A generic sequence whose associated Iterator type is a specialization of
// another generic type, using a dependent member type (Base.Iterator).
public struct mmEnumerateSequence<Base : _Sequence> : _Sequence {
  public typealias Iterator = mmEnumerateIterator<Base.Iterator>
  var base: Base
}

// CHECK-LABEL: sil_witness_table <Base where Base : _Sequence> mmEnumerateSequence<Base>: _Sequence module WitnessTableWithGP {
// CHECK-NEXT:    base_protocol _SequenceBase: <Base where Base : _Sequence> mmEnumerateSequence<Base>: _SequenceBase module WitnessTableWithGP
// CHECK-NEXT:    associated_type Iterator: mmEnumerateIterator<Base.Iterator>
// CHECK-NEXT:    associated_conformance (Iterator: IteratorProtocol): mmEnumerateIterator<Base.Iterator>: specialize <Base.Iterator> (<Base where Base : IteratorProtocol> mmEnumerateIterator<Base>: IteratorProtocol module WitnessTableWithGP)
// CHECK-NEXT:  }
sil_witness_table <Base : _Sequence> mmEnumerateSequence<Base>: _Sequence module WitnessTableWithGP {
  base_protocol _SequenceBase: <Base : _Sequence> mmEnumerateSequence<Base>: _SequenceBase module WitnessTableWithGP
  associated_type Iterator: mmEnumerateIterator<Base.Iterator>
  associated_conformance (Iterator: IteratorProtocol): mmEnumerateIterator<Base.Iterator>: specialize <Base.Iterator> (<Base : IteratorProtocol> mmEnumerateIterator<Base>: IteratorProtocol module WitnessTableWithGP)
}

// A locally-defined stand-in for the stdlib's IndexingIterator.
public struct mmIndexingIterator<Elements : Collection> : IteratorProtocol {
  public typealias Element = Elements.Element
  var _elements: Elements
  var _position: Elements.Index
}

// A generic collection whose associated Iterator is a specialization of
// mmIndexingIterator with the collection type itself.
public struct _mmArrayBuffer<T> : Collection {
  public typealias Element = T
  public typealias Index = Builtin.Int64
  public typealias Iterator = mmIndexingIterator<_mmArrayBuffer<T>>
}

// CHECK-LABEL: sil_witness_table <T> _mmArrayBuffer<T>: _Sequence module WitnessTableWithGP {
// CHECK-NEXT:    base_protocol _SequenceBase: <T> _mmArrayBuffer<T>: _SequenceBase module WitnessTableWithGP
// CHECK-NEXT:    associated_type Iterator: mmIndexingIterator<_mmArrayBuffer<T>>
// CHECK-NEXT:    associated_conformance (Iterator: IteratorProtocol): mmIndexingIterator<_mmArrayBuffer<T>>: specialize <_mmArrayBuffer<T>> (<Elements where Elements : Collection> mmIndexingIterator<Elements>: IteratorProtocol module WitnessTableWithGP)
// CHECK-NEXT:  }
sil_witness_table <T> _mmArrayBuffer<T>: _Sequence module WitnessTableWithGP {
  base_protocol _SequenceBase: <T> _mmArrayBuffer<T>: _SequenceBase module WitnessTableWithGP
  associated_type Iterator: mmIndexingIterator<_mmArrayBuffer<T>>
  associated_conformance (Iterator: IteratorProtocol): mmIndexingIterator<_mmArrayBuffer<T>>: specialize <_mmArrayBuffer<T>> (<Elements : Collection> mmIndexingIterator<Elements>: IteratorProtocol module WitnessTableWithGP)
}
