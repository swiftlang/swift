// RUN: %target-sil-opt -enable-experimental-feature CalledAttribute -verify-continue-on-failure -enable-sil-verify-all=0 %s 2>&1 | %FileCheck %s

// REQUIRES: swift_feature_CalledAttribute

sil_stage canonical

import Swift

// Without the attribute, a conversion can't drop the exactly-once guarantee.
// CHECK: Begin Error in function ordinary_conversion_drops_exactly_once
// CHECK: SIL verification failed: convert_function cannot drop execution semantics
// CHECK: End Error in function ordinary_conversion_drops_exactly_once
sil [ossa] @ordinary_conversion_drops_exactly_once : $@convention(thin) (@owned @called(exactlyOnce) @callee_owned () -> ()) -> @owned @called(atMostOnce) @callee_owned () -> () {
bb0(%0 : @owned $@called(exactlyOnce) @callee_owned () -> ()):
  %1 = convert_function %0 : $@called(exactlyOnce) @callee_owned () -> () to $@called(atMostOnce) @callee_owned () -> ()
  return %1 : $@called(atMostOnce) @callee_owned () -> ()
}

// The attribute only converts an exactly-once function.
// CHECK: Begin Error in function discard_from_at_most_once
// CHECK: SIL verification failed: convert_function [without_actually_discarding] must convert an exactly-once function to an at-most-once function
// CHECK: End Error in function discard_from_at_most_once
sil [ossa] @discard_from_at_most_once : $@convention(thin) (@owned @called(atMostOnce) @callee_owned () -> ()) -> @owned @called(atMostOnce) @callee_owned () -> () {
bb0(%0 : @owned $@called(atMostOnce) @callee_owned () -> ()):
  %1 = convert_function %0 : $@called(atMostOnce) @callee_owned () -> () to [without_actually_discarding] $@called(atMostOnce) @callee_owned () -> ()
  return %1 : $@called(atMostOnce) @callee_owned () -> ()
}

// CHECK: Begin Error in function discard_from_plain
// CHECK: SIL verification failed: convert_function [without_actually_discarding] must convert an exactly-once function to an at-most-once function
// CHECK: End Error in function discard_from_plain
sil [ossa] @discard_from_plain : $@convention(thin) (@owned @callee_owned () -> ()) -> @owned @called(atMostOnce) @callee_owned () -> () {
bb0(%0 : @owned $@callee_owned () -> ()):
  %1 = convert_function %0 : $@callee_owned () -> () to [without_actually_discarding] $@called(atMostOnce) @callee_owned () -> ()
  return %1 : $@called(atMostOnce) @callee_owned () -> ()
}

// The attribute only produces an at-most-once function.
// CHECK: Begin Error in function discard_to_exactly_once
// CHECK: SIL verification failed: convert_function [without_actually_discarding] must convert an exactly-once function to an at-most-once function
// CHECK: End Error in function discard_to_exactly_once
sil [ossa] @discard_to_exactly_once : $@convention(thin) (@owned @called(exactlyOnce) @callee_owned () -> ()) -> @owned @called(exactlyOnce) @callee_owned () -> () {
bb0(%0 : @owned $@called(exactlyOnce) @callee_owned () -> ()):
  %1 = convert_function %0 : $@called(exactlyOnce) @callee_owned () -> () to [without_actually_discarding] $@called(exactlyOnce) @callee_owned () -> ()
  return %1 : $@called(exactlyOnce) @callee_owned () -> ()
}

// CHECK: Begin Error in function discard_to_plain
// CHECK: SIL verification failed: convert_function [without_actually_discarding] must convert an exactly-once function to an at-most-once function
// CHECK: End Error in function discard_to_plain
sil [ossa] @discard_to_plain : $@convention(thin) (@owned @called(exactlyOnce) @callee_owned () -> ()) -> @owned @callee_owned () -> () {
bb0(%0 : @owned $@called(exactlyOnce) @callee_owned () -> ()):
  %1 = convert_function %0 : $@called(exactlyOnce) @callee_owned () -> () to [without_actually_discarding] $@callee_owned () -> ()
  return %1 : $@callee_owned () -> ()
}
