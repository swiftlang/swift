// Round-trip `checked_cast_addr_br test_only` through the printer, the parser,
// and the serializer, independently of SILGen.
//
// RUN: %empty-directory(%t)
//
// Print/parse: parse this file, print it, parse the result again.
// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all=true %s \
// RUN:   | %target-sil-opt -sil-print-types -enable-sil-verify-all=true -emit-sorted-sil \
// RUN:   | %FileCheck %s
//
// Serialize: parse, write a .sib, read it back, write another, print that.
// RUN: %target-sil-opt -sil-print-types %s -emit-sib -o %t/tmp.sib -module-name test_only_roundtrip
// RUN: %target-sil-opt -sil-print-types %t/tmp.sib -o %t/tmp.2.sib -module-name test_only_roundtrip
// RUN: %target-sil-opt -sil-print-types %t/tmp.2.sib -module-name test_only_roundtrip \
// RUN:   -emit-sorted-sil | %FileCheck %s

// `test_only` reports whether a cast would succeed without producing a value.
// Its destination operand must be `undef`, which the SIL verifier enforces --
// `-enable-sil-verify-all=true` above is what exercises that. The negative case
// (a `test_only` cast naming real storage) is not tested here because a verifier
// `require()` failure aborts the process rather than emitting a diagnostic.
//
// Note the contrast with take_always_undef_dest below: an undef destination is
// *not* by itself a marker for test_only. Undef propagates into arbitrary
// operands during optimization (replaceAllUsesWithUndef), so the verifier
// deliberately checks only one direction.

sil_stage canonical

import Builtin
import Swift

class C {}
class D: C {}

protocol P: ~Copyable {}

struct NC: ~Copyable, P {
  var value: Builtin.Int64
}

// An undef destination on a *consuming* cast stays legal, which is what rules
// out treating undef alone as the marker for test_only. (test/SIL/Parser/undef.sil
// has relied on this since long before test_only existed.)
//
// CHECK-LABEL: sil @take_always_undef_dest : $@convention(thin) (@in C) -> () {
// CHECK:         checked_cast_addr_br take_always C in %0 : $*C to D in undef : $*D, {{bb[0-9]+}}, {{bb[0-9]+}}
// CHECK:       } // end sil function 'take_always_undef_dest'
sil @take_always_undef_dest : $@convention(thin) (@in C) -> () {
bb0(%0 : $*C):
  checked_cast_addr_br take_always C in %0 : $*C to D in undef : $*D, bb1, bb2

bb1:
  br bb3

bb2:
  br bb3

bb3:
  %r = tuple ()
  return %r : $()
}

// The simplest shape: a class-to-subclass test that produces no value.
//
// CHECK-LABEL: sil @test_only_class : $@convention(thin) (@in C) -> () {
// CHECK:         checked_cast_addr_br test_only C in %0 : $*C to D in undef : $*D, {{bb[0-9]+}}, {{bb[0-9]+}}
// CHECK:       } // end sil function 'test_only_class'
sil @test_only_class : $@convention(thin) (@in C) -> () {
bb0(%0 : $*C):
  checked_cast_addr_br test_only C in %0 : $*C to D in undef : $*D, bb1, bb2

bb1:
  br bb3

bb2:
  br bb3

bb3:
  destroy_addr %0 : $*C
  %r = tuple ()
  return %r : $()
}

// The case this kind exists for: a noncopyable existential, where extracting the
// payload to answer the question would be a copy the type forbids.
//

// The case this kind exists for: a noncopyable existential, where extracting the
// payload to answer the question would be a copy the type forbids.
//
// CHECK-LABEL: sil @test_only_noncopyable_existential : $@convention(thin) (@in_guaranteed any P & ~Copyable) -> () {
// CHECK:         checked_cast_addr_br test_only any P & ~Copyable in %0 : $*any P & ~Copyable to NC in undef : $*NC, {{bb[0-9]+}}, {{bb[0-9]+}}
// CHECK:       } // end sil function 'test_only_noncopyable_existential'
sil @test_only_noncopyable_existential : $@convention(thin) (@in_guaranteed any P & ~Copyable) -> () {
bb0(%0 : $*any P & ~Copyable):
  checked_cast_addr_br test_only any P & ~Copyable in %0 : $*any P & ~Copyable to NC in undef : $*NC, bb1, bb2

bb1:
  br bb3

bb2:
  br bb3

bb3:
  %r = tuple ()
  return %r : $()
}

// The source is only read, so the same address can be tested repeatedly and is
// still live afterwards.
//

// The source is only read, so the same address can be tested repeatedly and is
// still live afterwards -- something no consuming kind permits.
//
// CHECK-LABEL: sil @test_only_repeated : $@convention(thin) (@in_guaranteed any P & ~Copyable) -> () {
// CHECK:         checked_cast_addr_br test_only any P & ~Copyable in %0 : $*any P & ~Copyable to NC in undef : $*NC, {{bb[0-9]+}}, {{bb[0-9]+}}
// CHECK:         checked_cast_addr_br test_only any P & ~Copyable in %0 : $*any P & ~Copyable to NC in undef : $*NC, {{bb[0-9]+}}, {{bb[0-9]+}}
// CHECK:       } // end sil function 'test_only_repeated'
sil @test_only_repeated : $@convention(thin) (@in_guaranteed any P & ~Copyable) -> () {
bb0(%0 : $*any P & ~Copyable):
  checked_cast_addr_br test_only any P & ~Copyable in %0 : $*any P & ~Copyable to NC in undef : $*NC, bb1, bb2

bb1:
  br bb5

bb2:
  br bb5

bb5:
  checked_cast_addr_br test_only any P & ~Copyable in %0 : $*any P & ~Copyable to NC in undef : $*NC, bb3, bb4

bb3:
  br bb6

bb4:
  br bb6

bb6:
  %r = tuple ()
  return %r : $()
}

// An undef destination on a *consuming* cast stays legal: see the note at the
// top of this file. This is what rules out treating undef as the marker.
//
