@LIT_SITE_CFG_IN_HEADER@

config.llvm_src_root = path(r"@LLVM_MAIN_SRC_DIR@")
config.llvm_obj_root = path(r"@LLVM_BINARY_DIR@")
config.llvm_tools_dir = path(r"@LLVM_TOOLS_DIR@")
config.llvm_libs_dir = path(r"@LLVM_LIBS_DIR@")
config.shlibdir = path(r"@SHLIBDIR@")
config.build_mode = lit_config.params.get('build_mode', "@SWIFT_BUILD_MODE@")
config.swift_obj_root = path(r"@SWIFT_BINARY_DIR@")
config.target_triple = "@LLVM_TARGET_TRIPLE@"
config.swiftlib_dir = path(r"@LIT_SWIFTLIB_DIR@")
config.swift_test_results_dir = \
    lit_config.params.get("swift_test_results_dir", path(r"@SWIFT_TEST_RESULTS_DIR@"))
config.lit_site_config_folder = os.path.dirname(os.path.realpath(__file__))

config.coverage_mode = "@SWIFT_ANALYZE_CODE_COVERAGE@"

# Let the main config do the real work.
lit_config.load_config(config, "@SWIFT_SOURCE_DIR@/test/Unit/lit.cfg")
