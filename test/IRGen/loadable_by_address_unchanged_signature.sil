// RUN: %target-sil-opt -enable-sil-verify-all %s -loadable-address | %FileCheck %s

sil_stage canonical

import Builtin
import Swift

struct Large {
  var a: UInt64
  var b: UInt64
  var c: UInt64
  var d: UInt64
  var e: UInt64
  var f: UInt64
  var g: UInt64
  var h: UInt64
}

struct TupleBox {
  var t: (UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64)
}

sil [noinline] @make_large : $@convention(thin) (UInt64) -> Large {
bb0(%0 : $UInt64):
  %1 = struct $Large (%0, %0, %0, %0, %0, %0, %0, %0)
  return %1 : $Large
}

// Calls @make_large (creating an alloc_stack via allocateForApply), but its
// own signature does not change and must not be added to modFuncs.
// CHECK-LABEL: sil @caller_unchanged_sig : $@convention(thin) (UInt64) -> () {
// CHECK:         [[OUT:%.*]] = alloc_stack $Large
// CHECK:         [[FN:%.*]] = function_ref @make_large : $@convention(thin) (UInt64) -> @out Large
// CHECK:         apply [[FN]]([[OUT]], %0)
// CHECK:         dealloc_stack [[OUT]]
sil @caller_unchanged_sig : $@convention(thin) (UInt64) -> () {
bb0(%0 : $UInt64):
  %1 = function_ref @make_large : $@convention(thin) (UInt64) -> Large
  %2 = apply %1(%0) : $@convention(thin) (UInt64) -> Large
  %3 = tuple ()
  return %3 : $()
}

// CHECK-LABEL: sil @tuple_unchanged_fn : $@convention(thin) (UInt64) -> (@convention(thin) (UInt64) -> (), UInt64) {
// CHECK:         [[FN:%.*]] = function_ref @caller_unchanged_sig : $@convention(thin) (UInt64) -> ()
// CHECK:         [[TUP:%.*]] = tuple ([[FN]], %0)
// CHECK:         return [[TUP]]
sil @tuple_unchanged_fn : $@convention(thin) (UInt64) -> (@convention(thin) (UInt64) -> (), UInt64) {
bb0(%0 : $UInt64):
  %1 = function_ref @caller_unchanged_sig : $@convention(thin) (UInt64) -> ()
  %2 = tuple (%1 : $@convention(thin) (UInt64) -> (), %0 : $UInt64)
  return %2 : $(@convention(thin) (UInt64) -> (), UInt64)
}

// CHECK-LABEL: sil @return_unchanged_fn : $@convention(thin) () -> @convention(thin) (UInt64) -> () {
// CHECK:         [[FN:%.*]] = function_ref @caller_unchanged_sig : $@convention(thin) (UInt64) -> ()
// CHECK:         return [[FN]]
sil @return_unchanged_fn : $@convention(thin) () -> @convention(thin) (UInt64) -> () {
bb0:
  %0 = function_ref @caller_unchanged_sig : $@convention(thin) (UInt64) -> ()
  return %0 : $@convention(thin) (UInt64) -> ()
}

// Already returns @out Large; must not be spuriously marked as modified.
// CHECK-LABEL: sil @already_indirect_return : $@convention(thin) (UInt64) -> @out Large {
sil @already_indirect_return : $@convention(thin) (UInt64) -> @out Large {
bb0(%0 : $*Large, %1 : $UInt64):
  %2 = struct $Large (%1, %1, %1, %1, %1, %1, %1, %1)
  store %2 to %0 : $*Large
  %4 = tuple ()
  return %4 : $()
}

// CHECK-LABEL: sil @tuple_already_indirect_fn : $@convention(thin) (UInt64) -> (@convention(thin) (UInt64) -> @out Large, UInt64) {
// CHECK:         [[FN:%.*]] = function_ref @already_indirect_return : $@convention(thin) (UInt64) -> @out Large
// CHECK:         [[TUP:%.*]] = tuple ([[FN]], %0)
// CHECK:         return [[TUP]]
sil @tuple_already_indirect_fn : $@convention(thin) (UInt64) -> (@convention(thin) (UInt64) -> @out Large, UInt64) {
bb0(%0 : $UInt64):
  %1 = function_ref @already_indirect_return : $@convention(thin) (UInt64) -> @out Large
  %2 = tuple (%1 : $@convention(thin) (UInt64) -> @out Large, %0 : $UInt64)
  return %2 : $(@convention(thin) (UInt64) -> @out Large, UInt64)
}

// Borrow accessor returning a large @guaranteed tuple while also calling
// @make_large must still be marked as modified and rewritten to
// @guaranteed_address.
// CHECK-LABEL: sil @borrow_large_tuple_with_call : $@convention(thin) (@in_guaranteed TupleBox, UInt64) -> @guaranteed_address (UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64) {
// CHECK:         [[ADDR:%.*]] = struct_element_addr %0, #TupleBox.t
// CHECK:         return [[ADDR]]
sil @borrow_large_tuple_with_call : $@convention(thin) (@in_guaranteed TupleBox, UInt64) -> @guaranteed (UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64) {
bb0(%0 : $*TupleBox, %1 : $UInt64):
  %2 = function_ref @make_large : $@convention(thin) (UInt64) -> Large
  %3 = apply %2(%1) : $@convention(thin) (UInt64) -> Large
  %4 = struct_element_addr %0 : $*TupleBox, #TupleBox.t
  %5 = load %4 : $*(UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64)
  return %5 : $(UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64, UInt64)
}
