// RUN: %target-swift-frontend -disable-objc-interop -emit-ir -primary-file %s | %FileCheck %s --check-prefix=CHECK --check-prefix=CHECK-%target-ptrsize -DWORD=i%target-ptrsize

sil_stage canonical

import Builtin
import Swift

class C { }
sil_vtable C { }

struct S {
  @_hasStorage unowned(unsafe) var uu: @sil_unmanaged C? { get set }
}

func example(_ os: S?)

// CHECK-LABEL: define hidden swiftcc void @"$s35reference_storage_extra_inhabitants7exampleyyAA1SVSgF"
// CHECK-NEXT:  entry:
// CHECK-NEXT:    %1 = icmp eq ptr %0, inttoptr ([[WORD]] 1 to ptr)
sil hidden @$s35reference_storage_extra_inhabitants7exampleyyAA1SVSgF : $@convention(thin) (Optional<S>) -> () {
bb0(%0 : $Optional<S>):
  switch_enum %0 : $Optional<S>, case #Optional.some!enumelt: bb2, case #Optional.none!enumelt: bb1 // id: %2

bb1:                                              // Preds: bb0
  br bb4                                          // id: %3

bb2(%4 : $S):                                     // Preds: bb0
  br bb4                                          // id: %9

bb4:                                              // Preds: bb3 bb1
  %10 = tuple ()                                  // user: %11
  return %10 : $()                                // id: %11
}

// The value witnesses must agree with the inline code above: null is a valid
// payload, so extra inhabitant indices are offset by one.
// CHECK-LABEL: define internal i32 @"$s35reference_storage_extra_inhabitants1SVwet"
// CHECK:       is-invalid-pointer:
// CHECK-NEXT:    [[NONNULL:%.*]] = icmp ne [[WORD]] [[VAL:%.*]], 0
// CHECK-NEXT:    br i1 [[NONNULL]], label %is-nonnull-pointer, label %is-valid-pointer
// CHECK:       is-nonnull-pointer:
// CHECK-NEXT:    sub [[WORD]] [[VAL]], 1

// CHECK-LABEL: define internal void @"$s35reference_storage_extra_inhabitants1SVwst"
// CHECK:         %value.uu = getelementptr
// CHECK-64-NEXT:    [[IDX:%.*]] = zext i32 {{%.*}} to [[WORD]]
// CHECK-64-NEXT:    [[STORED:%.*]] = add [[WORD]] [[IDX]], 1
// CHECK-32-NEXT:    [[STORED:%.*]] = add [[WORD]] {{%.*}}, 1
// CHECK-NEXT:    store [[WORD]] [[STORED]], ptr %value.uu
