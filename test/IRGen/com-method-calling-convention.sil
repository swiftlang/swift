// RUN: %target-swift-frontend -enable-experimental-com-interop -com-interop-model=microsoft -parse-stdlib -target i686-unknown-windows-msvc -module-name M -emit-ir %s | %FileCheck %s --check-prefix=WIN32
// RUN: %target-swift-frontend -enable-experimental-com-interop -com-interop-model=microsoft -parse-stdlib -target x86_64-unknown-windows-msvc -module-name M -emit-ir %s | %FileCheck %s --check-prefix=WIN64
// RUN: %target-swift-frontend -enable-experimental-com-interop -com-interop-model=microsoft -parse-stdlib -target aarch64-unknown-windows-msvc -module-name M -emit-ir %s | %FileCheck %s --check-prefix=WIN64

// REQUIRES: CODEGENERATOR=AArch64
// REQUIRES: CODEGENERATOR=X86

sil_stage canonical

import Builtin

// A COM method receives its interface pointer before its declared arguments.
// Microsoft COM uses stdcall where it is distinct from the platform C
// convention: 32-bit x86 Windows.

// WIN32-LABEL: define{{.*}} x86_stdcallcc i32 @com_method(ptr {{%.*}}, i32 {{%.*}})
// WIN64-LABEL: define{{.*}} i32 @com_method(ptr {{%.*}}, i32 {{%.*}})
sil @com_method : $@convention(com_method) (Builtin.Int32, Builtin.RawPointer) -> Builtin.Int32 {
bb0(%value : $Builtin.Int32, %interface : $Builtin.RawPointer):
  return %value : $Builtin.Int32
}
