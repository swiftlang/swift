sil [ossa] @com_native_conditional : $@convention(thin) (@owned any ISource) -> @owned Optional<NativeBase> {
bb0(%source : @owned $any ISource):
  checked_cast_br any ISource in %source : $any ISource to NativeBase, bb1, bb2
bb1(%target : @owned $NativeBase):
  %some = enum $Optional<NativeBase>, #Optional.some!enumelt, %target : $NativeBase
  br bb3(%some : $Optional<NativeBase>)
bb2(%failed : @owned $any ISource):
  destroy_value %failed : $any ISource
  %none = enum $Optional<NativeBase>, #Optional.none!enumelt
  br bb3(%none : $Optional<NativeBase>)
bb3(%result : @owned $Optional<NativeBase>):
  return %result : $Optional<NativeBase>
}

