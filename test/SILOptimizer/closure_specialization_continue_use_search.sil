// applyAndVisit(_:_:_:)
sil hidden [noinline] [ossa] @$s2CS13applyAndVisityS2f_S2fXEAA7Visitor_ptF : $@convention(thin) (Float, @guaranteed @noescape @callee_guaranteed (Float) -> Float, @in_guaranteed any Visitor) -> Float {
bb0(%0 : $Float, %1 : @guaranteed $@noescape @callee_guaranteed (Float) -> Float, %2 : $*any Visitor):
  %3 = apply %1(%0) : $@noescape @callee_guaranteed (Float) -> Float
  %4 = open_existential_addr immutable_access %2 to $*@opened(2, any Visitor) Self
  %5 = alloc_stack $Float
  store %0 to [trivial] %5
  // function_ref thunk for @callee_guaranteed (@unowned Float) -> (@unowned Float)
  %6 = function_ref @$sS2fIgyd_S2fIegnr_TR : $@convention(thin) (@in_guaranteed Float, @guaranteed @noescape @callee_guaranteed (Float) -> Float) -> @out Float
  %7 = partial_apply [callee_guaranteed] [on_stack] %6(%1) : $@convention(thin) (@in_guaranteed Float, @guaranteed @noescape @callee_guaranteed (Float) -> Float) -> @out Float
  %8 = convert_function %7 to $@noescape @callee_guaranteed @substituted <τ_0_0, τ_0_1> (@in_guaranteed τ_0_0) -> @out τ_0_1 for <Float, Float>
  %9 = witness_method $@opened(2, any Visitor) Self, #Visitor.visit : <Self where Self : Visitor><T> (Self) -> (T, (T) -> T) -> (), %4 : $*@opened(2, any Visitor) Self : $@convention(witness_method: Visitor) <τ_0_0 where τ_0_0 : Visitor><τ_1_0> (@in_guaranteed τ_1_0, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0, τ_0_1> (@in_guaranteed τ_0_0) -> @out τ_0_1 for <τ_1_0, τ_1_0>, @in_guaranteed τ_0_0) -> ()
  %10 = apply %9<@opened(2, any Visitor) Self, Float>(%5, %8, %4) : $@convention(witness_method: Visitor) <τ_0_0 where τ_0_0 : Visitor><τ_1_0> (@in_guaranteed τ_1_0, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0, τ_0_1> (@in_guaranteed τ_0_0) -> @out τ_0_1 for <τ_1_0, τ_1_0>, @in_guaranteed τ_0_0) -> ()
  destroy_value %8
  dealloc_stack %5
  return %3
}

// thunk for @callee_guaranteed (@unowned Float) -> (@unowned Float)
sil shared [transparent] [reabstraction_thunk] [ossa] @$sS2fIgyd_S2fIegnr_TR : $@convention(thin) (@in_guaranteed Float, @guaranteed @noescape @callee_guaranteed (Float) -> Float) -> @out Float {
bb0(%0 : $*Float, %1 : $*Float, %2 : @guaranteed $@noescape @callee_guaranteed (Float) -> Float):
  %3 = load [trivial] %1
  %4 = apply %2(%3) : $@noescape @callee_guaranteed (Float) -> Float
  store %4 to [trivial] %0
  %5 = tuple ()
  return %5
}

