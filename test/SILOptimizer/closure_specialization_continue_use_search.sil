// transform(_:_:observer:)
sil [ossa] @$s2CS9transform__8observerS2f_SfAA8Observer_ptF : $@convention(thin) (Float, Float, @in_guaranteed any Observer) -> Float {
bb0(%0 : $Float, %1 : $Float, %2 : $*any Observer):
  // function_ref closure #1 in transform(_:_:observer:)
  %3 = function_ref @$s2CS9transform__8observerS2f_SfAA8Observer_ptFS2fXEfU_ : $@convention(thin) (Float, Float) -> Float
  %4 = partial_apply [callee_guaranteed] [on_stack] %3(%1) : $@convention(thin) (Float, Float) -> Float
  // function_ref applyAndObserve(_:_:observer:)
  %5 = function_ref @$s2CS15applyAndObserve__8observerS2f_S2fXEAA8Observer_ptF : $@convention(thin) (Float, @guaranteed @noescape @callee_guaranteed (Float) -> Float, @in_guaranteed any Observer) -> Float
  %6 = apply %5(%0, %4, %2) : $@convention(thin) (Float, @guaranteed @noescape @callee_guaranteed (Float) -> Float, @in_guaranteed any Observer) -> Float
  destroy_value %4
  return %6
}

// closure #1 in transform(_:_:observer:)
sil private [ossa] @$s2CS9transform__8observerS2f_SfAA8Observer_ptFS2fXEfU_ : $@convention(thin) (Float, Float) -> Float {
bb0(%0 : $Float, %1 : @closureCapture $Float):
  %2 = struct_extract %0, #Float._value
  %3 = struct_extract %1, #Float._value
  %4 = builtin "fmul_FPIEEE32"(%2, %3) : $Builtin.FPIEEE32
  %5 = struct $Float (%4)
  return %5
}

