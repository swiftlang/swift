// RUN: %target-sil-opt -enable-sil-verify-all -closure-specialization %s | %FileCheck %s

// This SIL is derived from the following Swift:
//
// public protocol Observer {
//   func observe(_ result: Float, recompute: () -> Float)
// }
//
// @inline(never)
// func applyAndObserve(_ value: Float, _ body: (Float) -> Float, observer: any Observer) -> Float {
//   let result = body(value)
//   observer.observe(result, recompute: { body(value) })
//   return result
// }
//
// public func transform(_ value: Float, _ factor: Float, observer: any Observer) -> Float {
//   applyAndObserve(value, { $0 * factor }, observer: observer)
// }
//
// public protocol Visitor {
//   func visit<T>(_ value: T, transform: (T) -> T)
// }
//
// @inline(never)
// func applyAndVisit(_ value: Float, _ transform: (Float) -> Float, _ visitor: any Visitor) -> Float {
//   let result = transform(value)
//   visitor.visit(value, transform: transform)
//   return result
// }
//
// public func updateVisited(_ value: Float, _ factor: Float, _ visitor: any Visitor) -> Float {
//   applyAndVisit(value, { $0 * factor }, visitor)
// }

sil_stage canonical

import Builtin
import Swift

public protocol Observer {
  func observe(_ result: Float, recompute: () -> Float)
}

public protocol Visitor {
  func visit<T>(_ value: T, transform: (T) -> T)
}

// CHECK:       {{^}}// specialized applyAndObserve(_:_:observer:)
// CHECK-LABEL: {{^}}sil shared [noinline] [ossa] @$s2CS15applyAndObserve__8observerS2f_S2fXEAA8Observer_ptF018$s2CS9transform__8e9S2f_SfAA8F12_ptFS2fXEfU_SfTf1ncn_n : $@convention(thin) (Float, @in_guaranteed any Observer, Float) -> Float {
// CHECK:       bb0(%0 : $Float, %1 : $*any Observer, %2 : $Float):
// CHECK:         // function_ref closure #1 in transform(_:_:observer:)
// CHECK-NEXT:    %[[#OBS_CLOSURE:]] = function_ref @$s2CS9transform__8observerS2f_SfAA8Observer_ptFS2fXEfU_ : $@convention(thin) (Float, Float) -> Float
// CHECK:         %[[#OBS_RESULT:]] = apply %[[#OBS_CLOSURE]](%0, %2) : $@convention(thin) (Float, Float) -> Float
// CHECK:         return %[[#OBS_RESULT]]
// CHECK-NEXT:  {{^}}} // end sil function

// applyAndObserve(_:_:observer:)
sil hidden [noinline] [ossa] @$s2CS15applyAndObserve__8observerS2f_S2fXEAA8Observer_ptF : $@convention(thin) (Float, @guaranteed @noescape @callee_guaranteed (Float) -> Float, @in_guaranteed any Observer) -> Float {
bb0(%0 : $Float, %1 : @guaranteed $@noescape @callee_guaranteed (Float) -> Float, %2 : $*any Observer):
  %3 = apply %1(%0) : $@noescape @callee_guaranteed (Float) -> Float
  %4 = open_existential_addr immutable_access %2 to $*@opened(1, any Observer) Self
  // function_ref closure #1 in applyAndObserve(_:_:observer:)
  %5 = function_ref @$s2CS15applyAndObserve__8observerS2f_S2fXEAA8Observer_ptFSfyXEfU_ : $@convention(thin) (@guaranteed @noescape @callee_guaranteed (Float) -> Float, Float) -> Float
  %6 = partial_apply [callee_guaranteed] [on_stack] %5(%1, %0) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed (Float) -> Float, Float) -> Float
  %7 = witness_method $@opened(1, any Observer) Self, #Observer.observe : <Self where Self : Observer> (Self) -> (Float, () -> Float) -> (), %4 : $*@opened(1, any Observer) Self : $@convention(witness_method: Observer) <τ_0_0 where τ_0_0 : Observer> (Float, @guaranteed @noescape @callee_guaranteed () -> Float, @in_guaranteed τ_0_0) -> ()
  %8 = apply %7<@opened(1, any Observer) Self>(%3, %6, %4) : $@convention(witness_method: Observer) <τ_0_0 where τ_0_0 : Observer> (Float, @guaranteed @noescape @callee_guaranteed () -> Float, @in_guaranteed τ_0_0) -> ()
  destroy_value %6
  return %3
}

// closure #1 in applyAndObserve(_:_:observer:)
sil private [ossa] @$s2CS15applyAndObserve__8observerS2f_S2fXEAA8Observer_ptFSfyXEfU_ : $@convention(thin) (@guaranteed @noescape @callee_guaranteed (Float) -> Float, Float) -> Float {
bb0(%0 : @closureCapture @guaranteed $@noescape @callee_guaranteed (Float) -> Float, %1 : @closureCapture $Float):
  %2 = apply %0(%1) : $@noescape @callee_guaranteed (Float) -> Float
