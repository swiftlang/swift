// RUN: %target-sil-opt \
// RUN:   -lifetime-dependence-insertion \
// RUN:   -enable-sil-opaque-values \
// RUN:   -sil-verify-all \
// RUN:   -enable-experimental-feature Lifetimes \
// RUN:   -enable-experimental-feature AddressableTypes \
// RUN:   %s | %FileCheck %s

// REQUIRES: swift_feature_Lifetimes
// REQUIRES: swift_feature_AddressableTypes

// An addressable dependence is created on the address of the variable that is
// passed to the call. With opaque values, SILGen passes a loadable
// @in_guaranteed argument by value, as a load of the variable's access. The
// dependence must still be on the access and not on the loaded copy, which has
// no access scope, so that the access can be extended over the dependent value.

sil_stage raw

import Swift

struct NE: ~Escapable {
  var p: UnsafeRawPointer

  @_lifetime(immortal)
  init()
}

@_addressableForDependencies
struct AddressableForDeps {}

sil @getDep : $@convention(thin) (@in_guaranteed AddressableForDeps) -> @lifetime(borrow address_for_deps 0) @owned NE

// CHECK-LABEL: sil hidden [ossa] [opaque] @loaded_argument : $@convention(thin) (@inout AddressableForDeps) -> () {
// CHECK:         [[ACCESS:%.*]] = begin_access [read] [static] %0
// CHECK:         [[LOAD:%.*]] = load [trivial] [[ACCESS]]
// CHECK:         [[NE:%.*]] = apply %{{.*}}([[LOAD]]) : $@convention(thin) (@in_guaranteed AddressableForDeps) -> @lifetime(borrow address_for_deps 0) @owned NE
// CHECK:         mark_dependence [unresolved] [[NE]] on [[ACCESS]]
// CHECK:         end_access [[ACCESS]]
// CHECK-LABEL: } // end sil function 'loaded_argument'
sil hidden [ossa] @loaded_argument : $@convention(thin) (@inout AddressableForDeps) -> () {
bb0(%0 : $*AddressableForDeps):
  %1 = begin_access [read] [static] %0
  %2 = load [trivial] %1
  %3 = function_ref @getDep : $@convention(thin) (@in_guaranteed AddressableForDeps) -> @lifetime(borrow address_for_deps 0) @owned NE
  %4 = apply %3(%2) : $@convention(thin) (@in_guaranteed AddressableForDeps) -> @lifetime(borrow address_for_deps 0) @owned NE
  destroy_value %4
  end_access %1
  %6 = tuple ()
  return %6
}
