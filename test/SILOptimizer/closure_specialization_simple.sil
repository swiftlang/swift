  %9999 = tuple()
  return %9999 : $()
}



class ClosureCaptureClass {}

struct ClosureCaptureNoncopyable: ~Copyable {
  var c: ClosureCaptureClass
}

sil @exactly_once_closure_class_fun : $@convention(thin) (@guaranteed ClosureCaptureClass) -> Builtin.Int1
sil @exactly_once_closure_inout_fun : $@convention(thin) (@inout_aliasable Builtin.Int1) -> Builtin.Int1
sil @at_most_once_closure_noncopyable_fun : $@convention(thin) (@owned ClosureCaptureNoncopyable) -> Builtin.Int1
sil @closure_specialization_fatal : $@convention(thin) () -> Never

sil [ossa] @call_escaping_exactly_once_closure_indirect : $@convention(thin) (@owned @once @callee_owned @substituted <τ_0_0> () -> @out τ_0_0 for <Builtin.Int1>) -> Builtin.Int1 {
bb0(%0 : @owned $@once @callee_owned @substituted <τ_0_0> () -> @out τ_0_0 for <Builtin.Int1>):
  %1 = alloc_stack $Builtin.Int1
  %2 = apply %0(%1) : $@once @callee_owned @substituted <τ_0_0> () -> @out τ_0_0 for <Builtin.Int1>
  %3 = load [trivial] %1
  dealloc_stack %1
  return %3
}

sil [ossa] @call_escaping_at_most_once_closure_indirect : $@convention(thin) (@owned @callable(once) @callee_owned @substituted <τ_0_0> () -> @out τ_0_0 for <Builtin.Int1>) -> Builtin.Int1 {
