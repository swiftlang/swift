// RUN: %target-sil-opt -sil-print-types -enable-experimental-feature OnceFunctions -enable-sil-verify-all -sil-combine %s | %FileCheck %s

// REQUIRES: swift_feature_OnceFunctions

sil_stage canonical

import Swift

// Folding `(convert_function (convert_function x))` into one conversion would
// lose the attribute, and a plain conversion can't drop the exactly-once
// guarantee. Both conversions have to stay.
//
// CHECK-LABEL: sil [ossa] @test_fold_through_discard :
// CHECK:         [[DISCARDED:%.*]] = convert_function %0 : $@once @callee_owned () -> () to [without_actually_discarding] $@callable(once) @callee_owned () -> ()
// CHECK-NEXT:    [[SENDABLE:%.*]] = convert_function [[DISCARDED]] : $@callable(once) @callee_owned () -> () to $@Sendable @callable(once) @callee_owned () -> ()
// CHECK-NEXT:    return [[SENDABLE]]
// CHECK:       } // end sil function 'test_fold_through_discard'
sil [ossa] @test_fold_through_discard : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @Sendable @callable(once) @callee_owned () -> () {
bb0(%0 : @owned $@once @callee_owned () -> ()):
  %1 = convert_function %0 : $@once @callee_owned () -> () to [without_actually_discarding] $@callable(once) @callee_owned () -> ()
  %2 = convert_function %1 : $@callable(once) @callee_owned () -> () to $@Sendable @callable(once) @callee_owned () -> ()
  return %2 : $@Sendable @callable(once) @callee_owned () -> ()
}
