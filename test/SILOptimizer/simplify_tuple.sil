// RUN: %target-sil-opt -enable-sil-verify-all %s -onone-simplification -simplify-instruction=tuple | %FileCheck %s --check-prefix=CHECK --check-prefix=CHECK-ONONE
// RUN: %target-sil-opt -enable-sil-verify-all %s -simplification -simplify-instruction=tuple | %FileCheck %s --check-prefix=CHECK --check-prefix=CHECK-O


import Swift
import Builtin

// CHECK-LABEL: sil [ossa] @forward_owned :
// CHECK-NOT:     tuple
// CHECK:         return %0
// CHECK:       } // end sil function 'forward_owned'
sil [ossa] @forward_owned : $@convention(thin) (@owned (String, Int)) -> @owned (String, Int) {
bb0(%0 : @owned $(String, Int)):
  (%3, %4) = destructure_tuple %0 : $(String, Int)
  %2 = tuple (%3 : $String, %4 : $Int)
  return %2 : $(String, Int)
}

// CHECK-LABEL: sil [ossa] @forward_borrowed :
// CHECK-NOT:     tuple
// CHECK:         fix_lifetime %0
// CHECK:       } // end sil function 'forward_borrowed'
sil [ossa] @forward_borrowed : $@convention(thin) (@guaranteed (String, Int)) -> () {
bb0(%0 : @guaranteed $(String, Int)):
  (%3, %4) = destructure_tuple %0 : $(String, Int)
  %2 = tuple (%3 : $String, %4 : $Int)
  fix_lifetime %2 : $(String, Int)
   %7 = tuple ()
  return %7 : $()
}

// CHECK-LABEL: sil [ossa] @dont_forward_owned_with_uses :
// CHECK:         destructure_tuple
// CHECK:         tuple
// CHECK:       } // end sil function 'dont_forward_owned_with_uses'
sil [ossa] @dont_forward_owned_with_uses : $@convention(thin) (@owned (String, Int)) -> @owned (String, Int) {
bb0(%0 : @owned $(String, Int)):
  (%5, %6) = destructure_tuple %0 : $(String, Int)
  %3 = begin_borrow %5 : $String
  end_borrow %3 : $String
  %2 = tuple (%5 : $String, %6 : $Int)
  return %2 : $(String, Int)
}

// CHECK-LABEL: sil [ossa] @forward_owned_with_debug_use :
// CHECK-ONONE:   destructure_tuple
// CHECK-ONONE:   tuple
// CHECK-O:       return %0
// CHECK:       } // end sil function 'forward_owned_with_debug_use'
sil [ossa] @forward_owned_with_debug_use : $@convention(thin) (@owned (String, Int)) -> @owned (String, Int) {
bb0(%0 : @owned $(String, Int)):
  (%4, %5) = destructure_tuple %0 : $(String, Int)
  debug_value %4 : $String, let, name "t"
  %2 = tuple (%4 : $String, %5 : $Int)
  return %2 : $(String, Int)
}

// CHECK-LABEL: sil [ossa] @dont_forward_label_change :
// CHECK:         destructure_tuple
// CHECK:         tuple
// CHECK-LABEL: } // end sil function 'dont_forward_label_change'
sil [ossa] @dont_forward_label_change : $@convention(thin) (@owned (s: String, i: Int)) -> @owned (String, Int) {
bb0(%0 : @owned $(s: String, i: Int)):
  (%4, %5) = destructure_tuple %0 : $(s: String, i: Int)
  %2 = tuple (%4 : $String, %5 : $Int)
  return %2 : $(String, Int)
}

// CHECK-LABEL: sil [ossa] @dont_forward_flipped_arguments :
// CHECK:         destructure_tuple
// CHECK:         tuple
// CHECK-LABEL: } // end sil function 'dont_forward_flipped_arguments'
sil [ossa] @dont_forward_flipped_arguments : $@convention(thin) (@owned (String, String)) -> @owned (String, String) {
bb0(%0 : @owned $(String, String)):
  (%4, %5) = destructure_tuple %0 : $(String, String)
  %2 = tuple (%5 : $String, %4 : $String)
  return %2 : $(String, String)
}

// CHECK-LABEL: sil [ossa] @split_borrowed_tuple :
// CHECK-O:       bb0
// CHECK-O-NEXT:    [[B:%.*]] = begin_borrow %0
// CHECK-O-NEXT:    fix_lifetime [[B]]
// CHECK-O-NEXT:    fix_lifetime %1
// CHECK-O-NEXT:    end_borrow [[B]]
// CHECK-O-NEXT:    [[T:%.*]] = tuple (%0, %1)
// CHECK-O-NEXT:    destroy_value [[T]]
// CHECK-ONONE:     tuple_extract
// CHECK-ONONE:     tuple_extract
// CHECK:       } // end sil function 'split_borrowed_tuple'
sil [ossa] @split_borrowed_tuple : $@convention(thin) (@owned String, Int) -> () {
bb0(%0 : @owned $String, %1 : $Int):
  %2 = tuple (%0, %1)
  %3 = begin_borrow %2
  %4 = tuple_extract %3, 0
  %5 = tuple_extract %3, 1
  fix_lifetime %4
  fix_lifetime %5
  end_borrow %3
  destroy_value %2
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @split_borrowed_tuple_multi_borrows :
// CHECK-O:       bb1:
// CHECK-O-NEXT:    [[B1:%.*]] = begin_borrow %0
// CHECK-O-NEXT:    fix_lifetime [[B1]]
// CHECK-O-NEXT:    end_borrow [[B1]]
// CHECK-O:       bb2:
// CHECK-O-NEXT:    [[B2:%.*]] = begin_borrow %1
// CHECK-O-NEXT:    fix_lifetime [[B2]]
// CHECK-O-NEXT:    end_borrow [[B2]]
// CHECK-O:       bb3:
// CHECK-O-NEXT:    [[T:%.*]] = tuple (%0, %1)
// CHECK-O-NEXT:    destroy_value [[T]]
// CHECK:       } // end sil function 'split_borrowed_tuple_multi_borrows'
sil [ossa] @split_borrowed_tuple_multi_borrows : $@convention(thin) (@owned String, @owned String) -> () {
bb0(%0 : @owned $String, %1 : @owned $String):
  %2 = tuple (%0, %1)
  cond_br undef, bb1, bb2
bb1:
  %3 = begin_borrow %2
  %4 = tuple_extract %3, 0
  fix_lifetime %4
  end_borrow %3
  br bb3
bb2:
  %7 = begin_borrow %2
  %8 = tuple_extract %7, 1
  fix_lifetime %8
  end_borrow %7
  br bb3
bb3:
  destroy_value %2
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @split_destructure_of_copied_tuple :
// CHECK-O:       bb0(%0 : @owned $String, %1 : $Int):
// CHECK-O-NEXT:    [[C:%.*]] = copy_value %0
// CHECK-O-NEXT:    fix_lifetime %1
// CHECK-O-NEXT:    destroy_value [[C]]
// CHECK-O-NEXT:    [[T:%.*]] = tuple (%0, %1)
// CHECK-O-NEXT:    destroy_value [[T]]
// CHECK:       } // end sil function 'split_destructure_of_copied_tuple'
sil [ossa] @split_destructure_of_copied_tuple : $@convention(thin) (@owned String, Int) -> () {
bb0(%0 : @owned $String, %1 : $Int):
  %2 = tuple (%0, %1)
  %4 = copy_value %2
  (%6, %7) = destructure_tuple %4
  fix_lifetime %7
  destroy_value %6
  destroy_value %2
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @dont_split_tuple_with_unknown_borrow_use :
// CHECK:         tuple_extract
// CHECK:       } // end sil function 'dont_split_tuple_with_unknown_borrow_use'
sil [ossa] @dont_split_tuple_with_unknown_borrow_use : $@convention(thin) (@owned String, Int) -> () {
bb0(%0 : @owned $String, %1 : $Int):
  %2 = tuple (%0, %1)
  %3 = begin_borrow %2
  fix_lifetime %3
  %4 = tuple_extract %3, 0
  fix_lifetime %4
  end_borrow %3
  destroy_value %2
  %r = tuple ()
  return %r : $()
}
