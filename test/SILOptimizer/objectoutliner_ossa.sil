// RUN: %sil-opt -enable-sil-verify-all %s -object-outliner | %FileCheck %s

// Note: Intentionally not using %target-sil-opt, because we need at least a
//       swift 5.1 deployment target.


sil_stage canonical

import Builtin
import Swift

class Base { }

class Obj : Base {
  @_hasStorage var value: Int64
}

sil_global [let] @g1 : $Int32 = {
  %0 = integer_literal $Builtin.Int32, 1
  %initval = struct $Int32 (%0 : $Builtin.Int32)
}

sil_global [let] @gobj : $Obj
sil_global [let] @gobj2 : $Obj
sil_global @gobj_var : $Obj

// CHECK-LABEL: sil_global private [let] @outline_global_simpleTv_ : $Obj = {
// CHECK-NEXT:    %0 = integer_literal $Builtin.Int64, 1
// CHECK-NEXT:    %1 = struct $Int64 (%0)
// CHECK-NEXT:    %initval = object $Obj (%1)
// CHECK-NEXT:  }

// CHECK-LABEL: sil_global private [let] @outline_global_tailelemsTv_ : $Obj = {
// CHECK-NEXT:    %0 = integer_literal $Builtin.Int64, 1
// CHECK-NEXT:    %1 = struct $Int64 (%0)
// CHECK-NEXT:    %2 = integer_literal $Builtin.Int64, 2
// CHECK-NEXT:    %3 = struct $Int64 (%2)
// CHECK-NEXT:    %4 = integer_literal $Builtin.Int64, 3
// CHECK-NEXT:    %5 = struct $Int64 (%4)
// CHECK-NEXT:    %initval = object $Obj (%1, [tail_elems] %3, %5)
// CHECK-NEXT:  }

// CHECK-LABEL: sil_global private [let] @tuple_tailelemsTv_ : $Obj = {
// CHECK-NEXT:    %0 = integer_literal $Builtin.Int64, 27
// CHECK-NEXT:    %1 = struct $Int64 (%0)
// CHECK-NEXT:    %2 = integer_literal $Builtin.Int64, 1
// CHECK-NEXT:    %3 = struct $Int64 (%2)
// CHECK-NEXT:    %4 = integer_literal $Builtin.Int1, 0
// CHECK-NEXT:    %5 = struct $Bool (%4)
// CHECK-NEXT:    %6 = tuple (%3, %5)
// CHECK-NEXT:    %7 = integer_literal $Builtin.Int64, 2
// CHECK-NEXT:    %8 = struct $Int64 (%7)
// CHECK-NEXT:    %9 = integer_literal $Builtin.Int1, -1
// CHECK-NEXT:    %10 = struct $Bool (%9)
// CHECK-NEXT:    %11 = tuple (%8, %10)
// CHECK-NEXT:    %12 = struct $Int64 (%7)
// CHECK-NEXT:    %13 = tuple (%12, %5)
// CHECK-NEXT:    %initval = object $Obj (%1, [tail_elems] %6, %11, %13)
// CHECK-NEXT:  }

// CHECK-LABEL: sil_global private [let] @outline_global_addressTv_ : $Obj = {
// CHECK-NEXT:    %0 = integer_literal $Builtin.Int64, 1
// CHECK-NEXT:    %1 = struct $Int64 (%0)
// CHECK-NEXT:    %2 = global_addr @g1 : $*Int32
// CHECK-NEXT:    %3 = address_to_pointer %2 to $Builtin.RawPointer
// CHECK-NEXT:    %4 = struct $UnsafePointer<Int32> (%3)
// CHECK-NEXT:    %initval = object $Obj (%1, [tail_elems] %4)
// CHECK-NEXT:  }

// CHECK-LABEL: sil_global private @init_gobjTv_ : $Obj = {
// CHECK-NEXT:    %0 = integer_literal $Builtin.Int64, 27
// CHECK-NEXT:    %1 = struct $Int64 (%0)
// CHECK-NEXT:    %initval = object $Obj (%1)
// CHECK-NEXT:  }

// CHECK-LABEL: sil [ossa] @outline_global_simple :
// CHECK:         [[G:%[0-9]+]] = global_value @outline_global_simpleTv_ : $Obj
// CHECK-NOT:     store
// CHECK:         destroy_value [[G]]
// CHECK:       } // end sil function 'outline_global_simple'
sil [ossa] @outline_global_simple : $@convention(thin) () -> () {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Int64, 1
  %4 = struct $Int64 (%1 : $Builtin.Int64)
  %7 = alloc_ref [tail_elems $Int64 * %0 : $Builtin.Word] $Obj
  %b = begin_borrow %7
  %9 = ref_element_addr %b : $Obj, #Obj.value
  store %4 to [trivial] %9 : $*Int64
  end_borrow %b
  %10 = end_cow_mutation %7 : $Obj
  destroy_value %10 : $Obj
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @remove_dealloc_instructions :
// CHECK:         [[G:%.*]] = global_value
// CHECK-NEXT:    begin_borrow [[G]]
// CHECK-NEXT:    ref_element_addr
// CHECK-NEXT:    end_borrow
// CHECK-NEXT:    [[C:%.*]] = unchecked_ref_cast [[G]]
// CHECK-NEXT:    end_lifetime [[C]]
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'remove_dealloc_instructions'
sil [ossa] @remove_dealloc_instructions : $@convention(thin) () -> () {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Int64, 1
  %4 = struct $Int64 (%1 : $Builtin.Int64)
  %7 = alloc_ref [tail_elems $Int64 * %0 : $Builtin.Word] $Obj
  %b = begin_borrow %7
  %9 = ref_element_addr %b : $Obj, #Obj.value
  store %4 to [trivial] %9 : $*Int64
  end_borrow %b
  %10 = end_cow_mutation %7 : $Obj
  %11 = unchecked_ref_cast %10 : $Obj to $Base
  %12 = begin_dealloc_ref %11 : $Base of %7 : $Obj
  dealloc_ref %12 : $Base
  %r = tuple ()
  return %r : $()
}

