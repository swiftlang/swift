  %19 = integer_literal $Builtin.Word, 1
  %20 = index_addr %15 : $*Int64, %19 : $Builtin.Word
  store %6 to [trivial] %20 : $*Int64
  end_borrow %b
  %21 = end_cow_mutation %7 : $Obj
  destroy_value %21 : $Obj
