// An owned -> guaranteed specialization of a callee which is called with `try_apply`.
// CHECK-LABEL: sil shared [ossa] @$s18throwing_owned_argTf4g_n : $@convention(thin) (@guaranteed AnyObject) -> @error any Error {
// CHECK-NOT:     destroy_value
// CHECK:       } // end sil function '$s18throwing_owned_argTf4g_n'

// CHECK-LABEL: sil [signature_optimized_thunk] [ossa] @throwing_owned_arg :
// CHECK:         try_apply {{%.*}}(%0) : $@convention(thin) (@guaranteed AnyObject) -> @error any Error, normal bb1, error bb2
// CHECK:       bb1({{%.*}} : $()):
// CHECK-NEXT:    destroy_value %0
// CHECK:       bb2({{%.*}} : @owned $any Error):
// CHECK-NEXT:    destroy_value %0
// CHECK:       } // end sil function 'throwing_owned_arg'
sil [ossa] @throwing_owned_arg : $@convention(thin) (@owned AnyObject) -> @error any Error {
bb0(%0 : @owned $AnyObject):
  %1 = function_ref @use_guaranteed : $@convention(thin) (@guaranteed AnyObject) -> ()
  %2 = apply %1(%0) : $@convention(thin) (@guaranteed AnyObject) -> ()
  destroy_value %0
  %4 = tuple ()
  return %4
}

// CHECK-LABEL: sil [ossa] @call_throwing_owned_arg :
// CHECK:         [[F:%.*]] = function_ref @$s18throwing_owned_argTf4g_n :
// CHECK:         try_apply [[F]]
// CHECK:       } // end sil function 'call_throwing_owned_arg'
sil [ossa] @call_throwing_owned_arg : $@convention(thin) (@guaranteed AnyObject) -> @error any Error {
bb0(%0 : @guaranteed $AnyObject):
  %1 = copy_value %0
  %2 = function_ref @throwing_owned_arg : $@convention(thin) (@owned AnyObject) -> @error any Error
  try_apply %2(%1) : $@convention(thin) (@owned AnyObject) -> @error any Error, normal bb1, error bb2

bb1(%4 : $()):
  return %4

bb2(%6 : @owned $any Error):
  throw %6
}

