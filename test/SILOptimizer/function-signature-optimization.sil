// A `debug_value undef` of a generic type doesn't make the specialized function generic.
// It is replaced by a `debug_value undef : $()`.
// CHECK-LABEL: sil shared [ossa] @$s15undef_debug_valTf4d_n : $@convention(thin) () -> Int64 {
// CHECK:       bb0:
// CHECK-NEXT:    debug_value undef : $(), let, name "x"
// CHECK-NOT:     debug_value
// CHECK:       } // end sil function '$s15undef_debug_valTf4d_n'
sil [ossa] @undef_debug_val : $@convention(thin) <T> (@guaranteed GenS<T>) -> Int64 {
bb0(%0 : @guaranteed $GenS<T>):
  debug_value undef : $GenS<T>, let, name "x"
  %1 = integer_literal $Builtin.Int64, 0
  %2 = struct $Int64 (%1)
  return %2
}

// CHECK-LABEL: sil [ossa] @call_undef_debug_val :
// CHECK:         [[F:%.*]] = function_ref @$s15undef_debug_valTf4d_n : $@convention(thin) () -> Int64
// CHECK:           = apply [[F]]() : $@convention(thin) () -> Int64
// CHECK:       } // end sil function 'call_undef_debug_val'
sil [ossa] @call_undef_debug_val : $@convention(thin) (@guaranteed GenS<Int>) -> Int64 {
bb0(%0 : @guaranteed $GenS<Int>):
  %1 = function_ref @undef_debug_val : $@convention(thin) <T> (@guaranteed GenS<T>) -> Int64
  %2 = apply %1<Int>(%0) : $@convention(thin) <T> (@guaranteed GenS<T>) -> Int64
  return %2
}

// A `debug_value` of a removed dead generic argument is replaced by a `debug_value undef : $()`.
// CHECK-LABEL: sil shared [ossa] @$s22dead_generic_debug_valTf4dn_n : $@convention(thin) (Int) -> Int {
// CHECK:       bb0(%0 : $Int):
// CHECK-NEXT:    debug_value undef : $(), let, name "x", argno 1
// CHECK-NEXT:    debug_value %0, let, name "y", argno 2
// CHECK-NEXT:    return %0
// CHECK:       } // end sil function '$s22dead_generic_debug_valTf4dn_n'
sil [ossa] @dead_generic_debug_val : $@convention(thin) <T> (@in_guaranteed T, Int) -> Int {
bb0(%0 : $*T, %1 : $Int):
  debug_value %0, let, name "x", argno 1, expr op_deref
  debug_value %1, let, name "y", argno 2
  return %1
}

sil [ossa] @call_dead_generic_debug_val : $@convention(thin) (@in_guaranteed GenS<Int>, Int) -> Int {
bb0(%0 : $*GenS<Int>, %1 : $Int):
  %2 = function_ref @dead_generic_debug_val : $@convention(thin) <T> (@in_guaranteed T, Int) -> Int
  %3 = apply %2<GenS<Int>>(%0, %1) : $@convention(thin) <T> (@in_guaranteed T, Int) -> Int
  return %3
}

// A generic variable type from a debug reconstruction block doesn't make the specialized function
// generic. The `debug_value` is replaced by a `debug_value undef : $()`.
// CHECK-LABEL: sil shared [ossa] @$s21generic_debug_bb_typeTf4dn_n : $@convention(thin) (Int) -> Int {
// CHECK:       bb0(%0 : $Int):
// CHECK-NEXT:    debug_value undef : $(), let, name "self", argno 1
// CHECK-NEXT:    return %0
// CHECK:       } // end sil function '$s21generic_debug_bb_typeTf4dn_n'
sil [ossa] @generic_debug_bb_type : $@convention(thin) <T> (EmptyGen<T>, Int) -> Int {
bb0(%0 : $EmptyGen<T>, %1 : $Int):
  debug_value (), let, name "self", argno 1, transform {
  bb0:
    %2 = struct $EmptyGen<T> ()
    return %2 : $EmptyGen<T>
  }
  return %1
}

sil [ossa] @call_generic_debug_bb_type : $@convention(thin) (Int) -> Int {
bb0(%0 : $Int):
  %1 = struct $EmptyGen<Int> ()
  %2 = function_ref @generic_debug_bb_type : $@convention(thin) <T> (EmptyGen<T>, Int) -> Int
  %3 = apply %2<Int>(%1, %0) : $@convention(thin) <T> (EmptyGen<T>, Int) -> Int
  return %3
}

sil [ossa] @implicitly_generic_undef : $@convention(thin) <T> (Int) -> () {
bb0(%0 : $Int):
  fix_lifetime undef : $GenS<T>
  %3 = tuple ()
  return %3
}

// CHECK-LABEL: sil [ossa] @call_implicitly_generic_undef :
// CHECK:         [[F:%.*]] = function_ref @$s24implicitly_generic_undefTf4d_n : $@convention(thin) <τ_0_0> () -> ()
// CHECK:           = apply [[F]]<S>() : $@convention(thin) <τ_0_0> () -> ()
// CHECK:       } // end sil function 'call_implicitly_generic_undef'
sil [ossa] @call_implicitly_generic_undef : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  %3 = function_ref @implicitly_generic_undef : $@convention(thin) <T> (Int) -> ()
  %4 = apply %3<S>(%0) : $@convention(thin) <T> (Int) -> ()
  %r = tuple ()
  return %r
}

// A dead generic metatype argument is kept, because IRGen uses it as a source for the type metadata.
sil [ossa] @dead_generic_metatype : $@convention(thin) <T> (@thick T.Type, Int) -> () {
bb0(%0 : $@thick T.Type, %1 : $Int):
  %2 = metatype $@thick T.Type
  fix_lifetime %2
  %3 = tuple ()
  return %3
}

// CHECK-LABEL: sil [ossa] @call_dead_generic_metatype :
// CHECK:         [[F:%.*]] = function_ref @$s21dead_generic_metatypeTf4nd_n : $@convention(thin) <τ_0_0> (@thick τ_0_0.Type) -> ()
// CHECK:           = apply [[F]]<S>(%1) : $@convention(thin) <τ_0_0> (@thick τ_0_0.Type) -> ()
// CHECK:       } // end sil function 'call_dead_generic_metatype'
sil [ossa] @call_dead_generic_metatype : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  %1 = metatype $@thick S.Type
  %3 = function_ref @dead_generic_metatype : $@convention(thin) <T> (@thick T.Type, Int) -> ()
  %4 = apply %3<S>(%1, %0) : $@convention(thin) <T> (@thick T.Type, Int) -> ()
  %r = tuple ()
  return %r
}

sil [ossa] @dead_generic_metatype2 : $@convention(thin) <T> (@thick T.Type) -> () {
bb0(%0 : $@thick T.Type):
  %1 = builtin "sizeof"<T>() : $Builtin.Word
  fix_lifetime %1
  %3 = tuple ()
  return %3
}

// CHECK-LABEL: sil [ossa] @call_only_dead_generic_metatype :
// CHECK:         [[F:%.*]] = function_ref @dead_generic_metatype2 : $@convention(thin) <τ_0_0> (@thick τ_0_0.Type) -> ()
// CHECK:           = apply [[F]]<S>(%0) : $@convention(thin) <τ_0_0> (@thick τ_0_0.Type) -> ()
// CHECK:       } // end sil function 'call_only_dead_generic_metatype'
sil [ossa] @call_only_dead_generic_metatype : $@convention(thin) () -> () {
bb0:
  %1 = metatype $@thick S.Type
  %3 = function_ref @dead_generic_metatype2 : $@convention(thin) <T> (@thick T.Type) -> ()
  %4 = apply %3<S>(%1) : $@convention(thin) <T> (@thick T.Type) -> ()
  %r = tuple ()
  return %r
}

