  %5 = apply %2(%4) : $@convention(thin) (@owned AnyObject) -> ()
  br bb3

bb2:
  %7 = copy_value %0
  %8 = apply %2(%7) : $@convention(thin) (@owned AnyObject) -> ()
  br bb3

bb3:
  %10 = tuple ()
  return %10
}

