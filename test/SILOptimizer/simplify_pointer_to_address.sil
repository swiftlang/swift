  %7 = tuple_extract %6, 0
  %8 = builtin "truncOrBitCast_Int64_Word"(%7) : $Builtin.Word
  %9 = index_raw_pointer %0, %8
  %10 = pointer_to_address %9 to [strict] $*Int32
  %11 =  load [trivial] %10
