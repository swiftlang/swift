  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %ptr = address_to_pointer %addr : $*Builtin.Int32 to $Builtin.RawPointer
  %f = function_ref @box_callee_no_access : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> ()
  apply %f(%box) : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> ()
