  return %r : $()
}

// A recursive callee can't be summarized.
//
// CHECK-LABEL: sil [ossa] @not_promoted_recursive :
// CHECK:         alloc_box
// CHECK-LABEL: } // end sil function 'not_promoted_recursive'
sil [ossa] @not_promoted_recursive : $@convention(thin) (Builtin.Int1) -> () {
