// -----------------------------------------------------------------------------
// Uses of the box's projection that forward or escape its address. Every use is
// classified: an access through a forwarded address is still an access, and a
// use that can't be tracked prevents promotion.

// Modifies on one path, through a cast of the projection.
sil [ossa] @callee_may_modify_through_cast : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  cond_br %0, bb1, bb2
bb1:
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %cast = unchecked_addr_cast %addr : $*Builtin.Int32 to $*Builtin.Int32
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %cast : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  br bb3
bb2:
  br bb3
bb3:
  %r = tuple ()
  return %r : $()
}

// The access through the cast is seen, so the callee is undecided.
//
// CHECK-LABEL: sil [ossa] @not_promoted_may_modify_through_cast :
// CHECK:         alloc_box
// CHECK-LABEL: } // end sil function 'not_promoted_may_modify_through_cast'
