// -----------------------------------------------------------------------------
// Promotion is mandatory for noncopyable variables, because the move-only
// checker runs after MandatoryAllocBoxToStack and requires it. See the FIXME in
// exclusivity_static_diagnostics_noncopyable_box.swift.

struct NC: ~Copyable {
  var i: Builtin.Int32
}

sil [ossa] @nc_callee_may_modify : $@convention(thin) (Builtin.Int1, @guaranteed { var NC }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var NC }):
  cond_br %0, bb1, bb2
bb1:
  %addr = project_box %1 : ${ var NC }, 0
  %w = begin_access [modify] [dynamic] %addr : $*NC
  end_access %w : $*NC
  br bb3
bb2:
  br bb3
bb3:
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @promoted_noncopyable_may_modify :
// CHECK-NOT:     alloc_box
// CHECK-LABEL: } // end sil function 'promoted_noncopyable_may_modify'
sil [ossa] @promoted_noncopyable_may_modify : $@convention(thin) (Builtin.Int1, @owned NC) -> () {
bb0(%0 : $Builtin.Int1, %1 : @owned $NC):
  %box = alloc_box ${ var NC }
  %addr = project_box %box : ${ var NC }, 0
  store %1 to [init] %addr : $*NC
  %f = function_ref @nc_callee_may_modify : $@convention(thin) (Builtin.Int1, @guaranteed { var NC }) -> ()
  %access = begin_access [read] [dynamic] %addr : $*NC
  %call = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var NC }) -> ()
  end_access %access : $*NC
  destroy_value %box : ${ var NC }
  %r = tuple ()
  return %r : $()
}
