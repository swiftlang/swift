bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_may_modify_through_cast : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %call = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

sil [ossa] @box_callee_no_access : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> () {
