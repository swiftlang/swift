// RUN: %target-sil-opt -sil-print-types %s -mandatory-allocbox-to-stack | %FileCheck %s

sil_stage raw

import Builtin
import Swift

// MandatoryAllocBoxToStack makes the accesses of a promoted box static, and
// DiagnoseStaticExclusivity treats its captures as non-escaping. It only
// promotes a box if, at every call that can access the box:
// 1. the box is accessed during the call either on all paths or on no paths,
//    and
// 2. the box doesn't reach the call through two captures.
// rdar://179406916
//
// Callers are named for the expected result (promoted_* / not_promoted_*).
// Callees are named for what they do with the box (callee_*).

sil @noreturn_func : $@convention(thin) () -> Never
sil @throwing_func : $@convention(thin) () -> @error any Error

// -----------------------------------------------------------------------------
// Condition 1: the box is accessed on all paths or on no paths during the call.

// Modifies on one path.
sil [ossa] @callee_may_modify : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  cond_br %0, bb1, bb2
bb1:
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  br bb3
bb2:
  br bb3
bb3:
  %r = tuple ()
  return %r : $()
}

// Modifies on every path.
sil [ossa] @callee_must_modify : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  %addr = project_box %0 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  %r = tuple ()
  return %r : $()
}

// Modifies on both arms of a branch.
sil [ossa] @callee_modify_both_arms : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  cond_br %0, bb1, bb2
bb1:
  %w1 = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w1 : $*Builtin.Int32
  end_access %w1 : $*Builtin.Int32
  br bb3
bb2:
  %w2 = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w2 : $*Builtin.Int32
  end_access %w2 : $*Builtin.Int32
  br bb3
bb3:
  %r = tuple ()
  return %r : $()
}

// Modifies on one arm; the other arm is unreachable.
sil [ossa] @callee_modify_else_unreachable : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  cond_br %0, bb1, bb2
bb1:
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  %r = tuple ()
  return %r : $()
bb2:
  unreachable
}

// Modifies on one arm; the other arm calls a function that never returns. Before
// NoReturnFolding, the call need not be followed by unreachable.
sil [ossa] @callee_modify_else_noreturn : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  cond_br %0, bb1, bb2
bb1:
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  br bb3
bb2:
  %f = function_ref @noreturn_func : $@convention(thin) () -> Never
  %n = apply %f() : $@convention(thin) () -> Never
  br bb3
bb3:
  %r = tuple ()
  return %r : $()
}

// Modifies on one arm; the other arm loops and then traps. (A loop with no exit
// at all isn't valid SIL; the summary treats it like a trap.)
sil [ossa] @callee_modify_else_loop_then_trap : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  cond_br %0, bb1, bb2
bb1:
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  %r = tuple ()
  return %r : $()
bb2:
  br bb3
bb3:
  cond_br %0, bb4, bb5
bb4:
  br bb3
bb5:
  unreachable
}

// Only reads.
sil [ossa] @callee_read_only : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %read = begin_access [read] [dynamic] %addr : $*Builtin.Int32
  %v = load [trivial] %read : $*Builtin.Int32
  end_access %read : $*Builtin.Int32
  %r = tuple ()
  return %r : $()
}

// Reads on every path, modifies on one path.
sil [ossa] @callee_read_all_modify_some : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %read = begin_access [read] [dynamic] %addr : $*Builtin.Int32
  %v = load [trivial] %read : $*Builtin.Int32
  end_access %read : $*Builtin.Int32
  cond_br %0, bb1, bb2
bb1:
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %v to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  br bb3
bb2:
  br bb3
bb3:
  %r = tuple ()
  return %r : $()
}

// Modifies on every path, and forwards the box to a callee that only modifies it on
// some paths.
sil [ossa] @callee_forwards_to_may_modify : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  %f = function_ref @callee_may_modify : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %a = apply %f(%0, %1) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %r = tuple ()
  return %r : $()
}

// Modifies on every path, and forwards the box to itself on some paths.
sil [ossa] @callee_recursive : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> () {
bb0(%0 : $Builtin.Int1, %1 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  %addr = project_box %1 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  cond_br %0, bb1, bb2
bb1:
  %f = function_ref @callee_recursive : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %a = apply %f(%0, %1) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  br bb3
bb2:
  br bb3
bb3:
  %r = tuple ()
  return %r : $()
}

// Modifies after a call that may throw.
sil [ossa] @callee_throws_before_modify : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> @error any Error {
bb0(%0 : @closureCapture @guaranteed ${ var Builtin.Int32 }):
  %f = function_ref @throwing_func : $@convention(thin) () -> @error any Error
  try_apply %f() : $@convention(thin) () -> @error any Error, normal bb1, error bb2
bb1(%n : $()):
  %addr = project_box %0 : ${ var Builtin.Int32 }, 0
  %13 = integer_literal $Builtin.Int32, 13
  %w = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  store %13 to [trivial] %w : $*Builtin.Int32
  end_access %w : $*Builtin.Int32
  %r = tuple ()
  return %r : $()
bb2(%e : @owned $any Error):
  throw %e : $any Error
}

// The callee may modify the box while a read is in progress. Only dynamic
// enforcement can check it.
//
// CHECK-LABEL: sil [ossa] @not_promoted_may_modify_during_read :
// CHECK:         alloc_box
// CHECK:         begin_access [read] [dynamic]
// CHECK-LABEL: } // end sil function 'not_promoted_may_modify_during_read'
sil [ossa] @not_promoted_may_modify_during_read : $@convention(thin) (Builtin.Int1) -> () {
bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_may_modify : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %access = begin_access [read] [dynamic] %addr : $*Builtin.Int32
  %call = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  end_access %access : $*Builtin.Int32
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

// The callee always modifies the box while a read is in progress.
// DiagnoseStaticExclusivity reports the conflict.
//
// CHECK-LABEL: sil [ossa] @promoted_must_modify_during_read :
// CHECK-NOT:     alloc_box
// CHECK:         begin_access [read] [static]
// CHECK-LABEL: } // end sil function 'promoted_must_modify_during_read'
sil [ossa] @promoted_must_modify_during_read : $@convention(thin) () -> () {
bb0:
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_must_modify : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> ()
  %access = begin_access [read] [dynamic] %addr : $*Builtin.Int32
  %call = apply %f(%box) : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> ()
  end_access %access : $*Builtin.Int32
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

// The callee only modifies the box on some paths. No access is in progress at the
// call, but promotion doesn't depend on the accesses that enclose a call.
//
// CHECK-LABEL: sil [ossa] @not_promoted_may_modify_without_access :
// CHECK:         alloc_box
// CHECK-LABEL: } // end sil function 'not_promoted_may_modify_without_access'
sil [ossa] @not_promoted_may_modify_without_access : $@convention(thin) (Builtin.Int1) -> () {
bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_may_modify : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %call = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

