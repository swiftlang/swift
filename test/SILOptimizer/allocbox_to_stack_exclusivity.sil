  %r = tuple ()
  return %r : $()
}

// The callee throws, without modifying, on the error path.
//
// CHECK-LABEL: sil [ossa] @not_promoted_throws_before_modify :
// CHECK:         alloc_box
// CHECK-LABEL: } // end sil function 'not_promoted_throws_before_modify'
sil [ossa] @not_promoted_throws_before_modify : $@convention(thin) () -> @error any Error {
bb0:
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_throws_before_modify : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> @error any Error
  try_apply %f(%box) : $@convention(thin) (@guaranteed { var Builtin.Int32 }) -> @error any Error, normal bb1, error bb2
bb1(%n : $()):
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
bb2(%e : @owned $any Error):
  destroy_value %box : ${ var Builtin.Int32 }
  throw %e : $any Error
}

// -----------------------------------------------------------------------------
// Closures that capture the box. DiagnoseStaticExclusivity treats a closure
// argument as accessed at the call, whether or not the callee calls it, so its
// accesses happen on all paths only if the callee calls it on all paths.

// Calls the closure on every path.
sil [ossa] @callee_calls_closure : $@convention(thin) (Builtin.Int1, @guaranteed @callee_guaranteed () -> ()) -> () {
bb0(%0 : $Builtin.Int1, %1 : @guaranteed $@callee_guaranteed () -> ()):
  %c = apply %1() : $@callee_guaranteed () -> ()
  %r = tuple ()
  return %r : $()
}

// Calls the closure on one path.
