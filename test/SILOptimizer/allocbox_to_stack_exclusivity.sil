// The callee only reads. A read in progress can't conflict.
//
// CHECK-LABEL: sil [ossa] @promoted_read_only_during_read :
// CHECK-NOT:     alloc_box
// CHECK:         begin_access [read] [static]
// CHECK-LABEL: } // end sil function 'promoted_read_only_during_read'
sil [ossa] @promoted_read_only_during_read : $@convention(thin) (Builtin.Int1) -> () {
bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_read_only : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %access = begin_access [read] [dynamic] %addr : $*Builtin.Int32
  %call = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  end_access %access : $*Builtin.Int32
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

// The callee reads on every path. A modify in progress always conflicts, and
// DiagnoseStaticExclusivity reports it.
//
// CHECK-LABEL: sil [ossa] @promoted_read_only_during_modify :
// CHECK-NOT:     alloc_box
// CHECK:         begin_access [modify] [static]
// CHECK-LABEL: } // end sil function 'promoted_read_only_during_modify'
sil [ossa] @promoted_read_only_during_modify : $@convention(thin) (Builtin.Int1) -> () {
bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_read_only : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %access = begin_access [modify] [dynamic] %addr : $*Builtin.Int32
  %call = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  end_access %access : $*Builtin.Int32
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

// A read on every path doesn't decide a conflict with a read in progress, so a
// modify on some paths is undecided.
//
// CHECK-LABEL: sil [ossa] @not_promoted_read_all_modify_some :
// CHECK:         alloc_box
// CHECK-LABEL: } // end sil function 'not_promoted_read_all_modify_some'
sil [ossa] @not_promoted_read_all_modify_some : $@convention(thin) (Builtin.Int1) -> () {
bb0(%0 : $Builtin.Int1):
  %box = alloc_box ${ var Builtin.Int32 }
  %addr = project_box %box : ${ var Builtin.Int32 }, 0
  %42 = integer_literal $Builtin.Int32, 42
  store %42 to [trivial] %addr : $*Builtin.Int32
  %f = function_ref @callee_read_all_modify_some : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  %call = apply %f(%0, %box) : $@convention(thin) (Builtin.Int1, @guaranteed { var Builtin.Int32 }) -> ()
  destroy_value %box : ${ var Builtin.Int32 }
  %r = tuple ()
  return %r : $()
}

// The callee modifies on all paths, but the call it forwards the box to is
