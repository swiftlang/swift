// A switch_enum on a borrow of an enum instruction is folded.
// CHECK-LABEL: sil [ossa] @test_simplify_switch_enum_on_borrowed_enum :
// CHECK:         [[B:%.*]] = begin_borrow
// CHECK-NOT:     switch_enum
// CHECK:         [[P:%.*]] = unchecked_enum_data [[B]]
// CHECK-NEXT:    br bb1([[P]])
// CHECK-LABEL: } // end sil function 'test_simplify_switch_enum_on_borrowed_enum'
sil [ossa] @test_simplify_switch_enum_on_borrowed_enum : $@convention(thin) (@owned Klass) -> () {
bb0(%0 : @owned $Klass):
  %1 = enum $FakeOptional<Klass>, #FakeOptional.some!enumelt, %0
  %2 = begin_borrow %1
  specify_test "simplify_cfg_simplify_switch_enum_block @instruction[2]"
  switch_enum %2, case #FakeOptional.some!enumelt: bb1, case #FakeOptional.none!enumelt: bb2

bb1(%4 : @guaranteed $Klass):
  end_borrow %2
  br bb3

bb2:
  end_borrow %2
  br bb3

bb3:
  destroy_value %1
  %t = tuple ()
  return %t
}

// A switch_enum on a borrow, dominated by a switch_enum on the same borrow, is
// folded to the case of the dominating edge.
// CHECK-LABEL: sil [ossa] @test_simplify_switch_enum_dominated_by_same_borrow :
// CHECK:       bb2:
// CHECK-NOT:     switch_enum
// CHECK-NOT:     enum $FakeOptional<Klass>
// CHECK:         br bb3
// CHECK-LABEL: } // end sil function 'test_simplify_switch_enum_dominated_by_same_borrow'
sil [ossa] @test_simplify_switch_enum_dominated_by_same_borrow : $@convention(thin) (@owned FakeOptional<Klass>) -> () {
bb0(%0 : @owned $FakeOptional<Klass>):
  %1 = begin_borrow %0
  switch_enum %1, case #FakeOptional.some!enumelt: bb1, case #FakeOptional.none!enumelt: bb2

bb1(%3 : @guaranteed $Klass):
  end_borrow %1
  br bb5

bb2:
  specify_test "simplify_cfg_simplify_switch_enum_block @instruction[4]"
  switch_enum %1, case #FakeOptional.none!enumelt: bb3, case #FakeOptional.some!enumelt: bb4

bb3:
  end_borrow %1
  br bb5

bb4(%9 : @guaranteed $Klass):
  end_borrow %1
  br bb5

bb5:
  destroy_value %0
  %t = tuple ()
  return %t
}

// A switch_enum on a borrow of a copy of an enum instruction is folded.
// CHECK-LABEL: sil [ossa] @test_simplify_switch_enum_on_borrowed_copy :
// CHECK:         [[C:%.*]] = copy_value
// CHECK:         [[B:%.*]] = begin_borrow [[C]]
// CHECK-NOT:     switch_enum
// CHECK:         [[P:%.*]] = unchecked_enum_data [[B]]
// CHECK-NEXT:    br bb1([[P]])
// CHECK-LABEL: } // end sil function 'test_simplify_switch_enum_on_borrowed_copy'
sil [ossa] @test_simplify_switch_enum_on_borrowed_copy : $@convention(thin) (@guaranteed Klass) -> () {
bb0(%0 : @guaranteed $Klass):
  %1 = enum $FakeOptional<Klass>, #FakeOptional.some!enumelt, %0
  %2 = copy_value %1
  %3 = begin_borrow %2
  specify_test "simplify_cfg_simplify_switch_enum_block @instruction[3]"
  switch_enum %3, case #FakeOptional.some!enumelt: bb1, case #FakeOptional.none!enumelt: bb2

bb1(%5 : @guaranteed $Klass):
  end_borrow %3
  br bb3

bb2:
  end_borrow %3
  br bb3

bb3:
  destroy_value %2
  %t = tuple ()
  return %t
}
