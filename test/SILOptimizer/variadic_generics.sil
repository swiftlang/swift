  %dpi0 = dynamic_pack_index %1 of $Pack{Int32, Int64}
  %ope0 = open_pack_element %dpi0 of <each T> at <Pack{Int32, Int64}>, shape $each T, id 6
  %addr = pointer_to_address %0 to $*@pack_element(6) each T

