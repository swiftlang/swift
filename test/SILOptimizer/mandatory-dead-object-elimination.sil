// RUN: %target-sil-opt -mandatory-dead-object-elimination %s | %FileCheck %s

import Builtin
import Swift

class Klass {
  deinit {}
}

// Trivial deinit for Klass: just deallocates, no side effects.
sil [ossa] @$s4main5KlassCfD : $@convention(method) (@owned Klass) -> () {
bb0(%0 : @owned $Klass):
  dealloc_ref %0 : $Klass
  %r = tuple ()
  return %r : $()
}

// Non-lexical alloc_stack with no debug variable is eliminated.
//
// CHECK-LABEL: sil [ossa] @basic_elimination :
// CHECK-NOT:     alloc_stack
// CHECK:         return %0
// CHECK-LABEL: } // end sil function 'basic_elimination'
sil [ossa] @basic_elimination : $@convention(thin) (@owned Klass) -> @owned Klass {
bb0(%0 : @owned $Klass):
  %stk = alloc_stack $Klass
  store %0 to [init] %stk : $*Klass
  %r = load [take] %stk : $*Klass
  dealloc_stack %stk : $*Klass
  return %r : $Klass
}

// Lexical alloc_stack of non-trivial type is preserved for debug info.
//
// CHECK-LABEL: sil [ossa] @preserve_lexical_nontrivial :
// CHECK:         alloc_stack [lexical]
// CHECK-LABEL: } // end sil function 'preserve_lexical_nontrivial'
sil [ossa] @preserve_lexical_nontrivial : $@convention(thin) (@owned Klass) -> @owned Klass {
bb0(%0 : @owned $Klass):
  %stk = alloc_stack [lexical] $Klass
  store %0 to [init] %stk : $*Klass
  %r = load [take] %stk : $*Klass
  dealloc_stack %stk : $*Klass
  return %r : $Klass
}

// Lexical alloc_stack of trivial type is eligible for elimination: trivial
// types carry no ownership and don't need to be kept around for debug info.
//
// CHECK-LABEL: sil [ossa] @eliminate_lexical_trivial :
// CHECK-NOT:     alloc_stack
// CHECK:         return %0
// CHECK-LABEL: } // end sil function 'eliminate_lexical_trivial'
sil [ossa] @eliminate_lexical_trivial : $@convention(thin) (Int) -> Int {
bb0(%0 : $Int):
  %stk = alloc_stack [lexical] $Int
  store %0 to [trivial] %stk : $*Int
  %r = load [trivial] %stk : $*Int
  dealloc_stack %stk : $*Int
  return %r : $Int
}

// alloc_ref is not touched by this pass — only alloc_stack allocations are considered.
//
// CHECK-LABEL: sil [ossa] @preserve_alloc_ref :
// CHECK:         alloc_ref $Klass
// CHECK-LABEL: } // end sil function 'preserve_alloc_ref'
sil [ossa] @preserve_alloc_ref : $@convention(thin) () -> () {
bb0:
  %obj = alloc_ref $Klass
  destroy_value %obj : $Klass
  %r = tuple ()
  return %r : $()
}

// alloc_stack with an associated debug variable is preserved even if non-lexical.
//
// CHECK-LABEL: sil [ossa] @preserve_debug_var :
// CHECK:         alloc_stack
// CHECK-LABEL: } // end sil function 'preserve_debug_var'
sil [ossa] @preserve_debug_var : $@convention(thin) (@owned Klass) -> @owned Klass {
bb0(%0 : @owned $Klass):
  %stk = alloc_stack $Klass, var, name "k"
  store %0 to [init] %stk : $*Klass
  %r = load [take] %stk : $*Klass
  dealloc_stack %stk : $*Klass
  return %r : $Klass
}

// An assume of integers in a stack location reads the stored value instead.
//
// CHECK-LABEL: sil [ossa] @assume_integers_in_stack :
// CHECK-NOT:     alloc_stack
// CHECK:         [[L:%.*]] = struct_extract %0, #Range._lowerBound
// CHECK:         [[U:%.*]] = struct_extract %0, #Range._upperBound
// CHECK:         builtin "assumeTrue"<Int64>([[L]], [[U]], {{%[0-9]+}}) : $()
// CHECK-LABEL: } // end sil function 'assume_integers_in_stack'
sil [ossa] @assume_integers_in_stack : $@convention(thin) (Range<Int64>) -> () {
bb0(%0 : $Range<Int64>):
  %1 = alloc_stack $Range<Int64>
  store %0 to [trivial] %1 : $*Range<Int64>
  %3 = struct_element_addr %1 : $*Range<Int64>, #Range._lowerBound
  %4 = struct_element_addr %1 : $*Range<Int64>, #Range._upperBound
  %le = integer_literal $Builtin.Int8, 3
  %5 = builtin "assumeTrue"<Int64>(%3 : $*Int64, %4 : $*Int64, %le : $Builtin.Int8) : $()
  dealloc_stack %1 : $*Range<Int64>
  %7 = tuple ()
  return %7 : $()
}

// An assume of other concrete types has no effect and is removed with the stack location.
//
// CHECK-LABEL: sil [ossa] @assume_non_integers_in_stack :
// CHECK-NOT:     alloc_stack
// CHECK-NOT:     builtin "assumeTrue"
// CHECK-LABEL: } // end sil function 'assume_non_integers_in_stack'
sil [ossa] @assume_non_integers_in_stack : $@convention(thin) (Range<Double>) -> () {
bb0(%0 : $Range<Double>):
  %1 = alloc_stack $Range<Double>
  store %0 to [trivial] %1 : $*Range<Double>
  %3 = struct_element_addr %1 : $*Range<Double>, #Range._lowerBound
  %4 = struct_element_addr %1 : $*Range<Double>, #Range._upperBound
  %le = integer_literal $Builtin.Int8, 3
  %5 = builtin "assumeTrue"<Double>(%3 : $*Double, %4 : $*Double, %le : $Builtin.Int8) : $()
  dealloc_stack %1 : $*Range<Double>
  %7 = tuple ()
  return %7 : $()
}

// A generic type can still become an integer type by specialization.
//
// CHECK-LABEL: sil [ossa] @assume_generic_in_stack :
// CHECK:         alloc_stack
// CHECK:         builtin "assumeTrue"<T>
// CHECK-LABEL: } // end sil function 'assume_generic_in_stack'
sil [ossa] @assume_generic_in_stack : $@convention(thin) <T where T : Comparable> (@in_guaranteed Range<T>) -> () {
bb0(%0 : $*Range<T>):
  %1 = alloc_stack $Range<T>
  copy_addr %0 to [init] %1 : $*Range<T>
  %3 = struct_element_addr %1 : $*Range<T>, #Range._lowerBound
  %4 = struct_element_addr %1 : $*Range<T>, #Range._upperBound
  %le = integer_literal $Builtin.Int8, 3
  %5 = builtin "assumeTrue"<T>(%3 : $*T, %4 : $*T, %le : $Builtin.Int8) : $()
  destroy_addr %1 : $*Range<T>
  dealloc_stack %1 : $*Range<T>
  %7 = tuple ()
  return %7 : $()
}
