// RUN: %target-sil-opt %s -lower-address-instructions | %FileCheck %s

sil_stage canonical

import Swift
import Builtin

protocol P {}

// CHECK-LABEL: sil [ossa] @copy_addr_take_init :
// CHECK:         %2 = load [take] %1
// CHECK-NEXT:    store %2 to [init] %0
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'copy_addr_take_init'
sil [ossa] @copy_addr_take_init : $@convention(thin) (@in String) -> @out String {
bb0(%0 : $*String, %1: $*String):
  copy_addr [take] %1 to [init] %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @copy_addr_copy_assign :
// CHECK:         %2 = load [copy] %1
// CHECK-NEXT:    store %2 to [assign] %0
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'copy_addr_copy_assign'
sil [ossa] @copy_addr_copy_assign : $@convention(thin) (@inout String, @in_guaranteed String) -> () {
bb0(%0 : $*String, %1: $*String):
  copy_addr %1 to %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @copy_addr_trivial :
// CHECK:         %2 = load [trivial] %1
// CHECK-NEXT:    store %2 to [trivial] %0
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'copy_addr_trivial'
sil [ossa] @copy_addr_trivial : $@convention(thin) (@inout Int, @in_guaranteed Int) -> () {
bb0(%0 : $*Int, %1: $*Int):
  copy_addr %1 to %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @copy_addr_non_loadable :
// CHECK:         copy_addr %1 to %0
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'copy_addr_non_loadable'
sil [ossa] @copy_addr_non_loadable : $@convention(thin) (@inout any P, @in_guaranteed P) -> () {
bb0(%0 : $*any P, %1: $*any P):
  copy_addr %1 to %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @destroy_addr :
// CHECK:         %1 = load [take] %0
// CHECK-NEXT:    destroy_value %1
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'destroy_addr'
sil [ossa] @destroy_addr : $@convention(thin) (@in String) -> () {
bb0(%0 : $*String):
  destroy_addr %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @destroy_addr_trivial :
// CHECK:       bb0(%0 : $*Int):
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'destroy_addr_trivial'
sil [ossa] @destroy_addr_trivial : $@convention(thin) (@in Int) -> () {
bb0(%0 : $*Int):
  destroy_addr %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil [ossa] @destroy_addr_non_loadable :
// CHECK:       bb0(%0 : $*any P):
// CHECK-NEXT:    destroy_addr %0
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'destroy_addr_non_loadable'
sil [ossa] @destroy_addr_non_loadable : $@convention(thin) (@in any P) -> () {
bb0(%0 : $*any P):
  destroy_addr %0
  %r = tuple ()
  return %r
}

// CHECK-LABEL: sil @non_ossa :
// CHECK:         copy_addr
// CHECK:         destroy_addr
// CHECK:       } // end sil function 'non_ossa'
sil @non_ossa : $@convention(thin) (@in String) -> @out String {
bb0(%0 : $*String, %1: $*String):
  copy_addr %1 to [init] %0
  destroy_addr %1
  %r = tuple ()
  return %r
}
