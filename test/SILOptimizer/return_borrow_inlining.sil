// CHECK-NEXT:  [[V:%.*]] = load [trivial] [[A]]
// CHECK-NEXT:  end_borrow [[B]]
// CHECK-NEXT:  end_borrow [[LB]]
// CHECK: } // end sil function 'test_address_result_guaranteed_self'
