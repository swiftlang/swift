  %2 = function_ref @klass_address_borrow_accessor_dead_end : $@convention(method) (Builtin.Int1, @guaranteed Klass) -> @guaranteed_address Int
  %3 = apply %2(%1, %0) : $@convention(method) (Builtin.Int1, @guaranteed Klass) -> @guaranteed_address Int
  %4 = load [trivial] %3 : $*Int
  destroy_value %0 : $Klass
  return %4 : $Int
}

