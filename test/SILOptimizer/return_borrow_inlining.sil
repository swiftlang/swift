  destroy_value %0 : $Klass
  return %5 : $Int
}

// A guaranteed function argument passed as self is already lexical, so the
// inliner introduces no scope for it, and the accessor is inlined even if its
// address result escapes.
//
// CHECK-LABEL: sil [ossa] @test_address_result_escape_guaranteed_argument_self : $@convention(thin) (@guaranteed Klass) -> Int {
// CHECK-NOT:   apply
// CHECK-NOT:   begin_borrow
// CHECK:       [[A:%.*]] = ref_element_addr %0
// CHECK-NEXT:  address_to_pointer [[A]]
// CHECK: } // end sil function 'test_address_result_escape_guaranteed_argument_self'
sil [ossa] @test_address_result_escape_guaranteed_argument_self : $@convention(thin) (@guaranteed Klass) -> Int {
bb0(%0 : @guaranteed $Klass):
  %1 = function_ref @klass_id_accessor : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
  %2 = apply %1(%0) : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
  %3 = address_to_pointer %2 : $*Int to $Builtin.RawPointer
  %4 = pointer_to_address %3 : $Builtin.RawPointer to [strict] $*Int
  %5 = load [trivial] %4 : $*Int
  return %5 : $Int
}

// The inliner cannot end the callee's return_borrow scopes after the uses of an
// escaping address result, so it doesn't inline the accessor.
//
// CHECK-LABEL: sil [ossa] @test_address_result_escape_return_borrow : $@convention(thin) (@in_guaranteed Container) -> Int {
// CHECK:       apply {{%[0-9]+}}(%0) : $@convention(method) (@in_guaranteed Container) -> @guaranteed_address Int
// CHECK: } // end sil function 'test_address_result_escape_return_borrow'
sil [ossa] @test_address_result_escape_return_borrow : $@convention(thin) (@in_guaranteed Container) -> Int {
bb0(%0 : $*Container):
  %1 = function_ref @address_borrow_accessor : $@convention(method) (@in_guaranteed Container) -> @guaranteed_address Int
  %2 = apply %1(%0) : $@convention(method) (@in_guaranteed Container) -> @guaranteed_address Int
  %3 = address_to_pointer %2 : $*Int to $Builtin.RawPointer
  %4 = pointer_to_address %3 : $Builtin.RawPointer to [strict] $*Int
  %5 = load [trivial] %4 : $*Int
  return %5 : $Int
}

sil [transparent] [ossa] @container_k_address_accessor : $@convention(method) (@in_guaranteed Container) -> @guaranteed_address Klass {
bb0(%0 : $*Container):
  %1 = struct_element_addr %0 : $*Container, #Container._k
  return %1 : $*Klass
}

// The address result of an accessor with an address self and no return_borrow
// scopes has no scope to end, so it is inlined even if it escapes.
//
// CHECK-LABEL: sil [ossa] @test_address_result_escape_no_scopes : $@convention(thin) (@in_guaranteed Container) -> @owned Klass {
// CHECK-NOT:   apply
// CHECK:       [[A:%.*]] = struct_element_addr %0
// CHECK-NEXT:  address_to_pointer [[A]]
// CHECK: } // end sil function 'test_address_result_escape_no_scopes'
sil [ossa] @test_address_result_escape_no_scopes : $@convention(thin) (@in_guaranteed Container) -> @owned Klass {
bb0(%0 : $*Container):
  %1 = function_ref @container_k_address_accessor : $@convention(method) (@in_guaranteed Container) -> @guaranteed_address Klass
  %2 = apply %1(%0) : $@convention(method) (@in_guaranteed Container) -> @guaranteed_address Klass
  %3 = address_to_pointer %2 : $*Klass to $Builtin.RawPointer
  %4 = pointer_to_address %3 : $Builtin.RawPointer to [strict] $*Klass
  %5 = load [copy] %4 : $*Klass
  return %5 : $Klass
}

sil [ossa] @read_through_pointer : $@convention(thin) (@in_guaranteed Int) -> Int {
bb0(%0 : $*Int):
  %1 = address_to_pointer %0 : $*Int to $Builtin.RawPointer
  %2 = pointer_to_address %1 : $Builtin.RawPointer to [strict] $*Int
  %3 = load [trivial] %2 : $*Int
  return %3 : $Int
}

// The inliner inlines the later call first, which makes the address result of
// the accessor escape after the accessor was chosen for inlining, so the
// accessor isn't inlined.
//
// CHECK-LABEL: sil [ossa] @test_address_result_escape_after_inlining : $@convention(thin) (@owned Klass) -> Int {
// CHECK:       [[R:%.*]] = apply {{%[0-9]+}}(%0) : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
// CHECK-NEXT:  address_to_pointer [[R]]
// CHECK: } // end sil function 'test_address_result_escape_after_inlining'
sil [ossa] @test_address_result_escape_after_inlining : $@convention(thin) (@owned Klass) -> Int {
bb0(%0 : @owned $Klass):
  %1 = function_ref @klass_id_accessor : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
  %2 = apply %1(%0) : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
  %3 = function_ref @read_through_pointer : $@convention(thin) (@in_guaranteed Int) -> Int
  %4 = apply %3(%2) : $@convention(thin) (@in_guaranteed Int) -> Int
  destroy_value %0 : $Klass
  return %4 : $Int
}
