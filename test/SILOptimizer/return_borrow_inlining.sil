// CHECK-NEXT:  end_borrow [[IB]]
// CHECK-NEXT:  end_borrow [[B]]
// CHECK-NOT:   end_borrow
// CHECK:       unreachable
// CHECK:       load [trivial] [[A]]
// CHECK-NEXT:  end_borrow [[IB]]
// CHECK-NEXT:  end_borrow [[B]]
// CHECK-NEXT:  destroy_value %0
// CHECK: } // end sil function 'test_address_result_callee_dead_end'
sil [ossa] @test_address_result_callee_dead_end : $@convention(thin) (@owned Klass, Builtin.Int1) -> Int {
