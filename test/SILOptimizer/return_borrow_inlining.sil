  %3 = function_ref @klass_id_accessor : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
  %4 = apply %3(%2) : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
  %5 = load [trivial] %4 : $*Int
  end_borrow %1 : $Container
  return %5 : $Int
}

