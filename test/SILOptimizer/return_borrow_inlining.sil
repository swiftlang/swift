// The scopes of the address result end after its transitive uses in each
// block, the inner scope first.
//
// CHECK-LABEL: sil [ossa] @test_address_result_projection_uses : $@convention(thin) (@owned Klass) -> Builtin.Int64 {
// CHECK-NOT:   apply
// CHECK:       [[B:%.*]] = begin_borrow %0
// CHECK:       [[IB:%.*]] = begin_borrow [[B]]
// CHECK:       [[A:%.*]] = ref_element_addr [[IB]]
// CHECK:       [[P:%.*]] = struct_element_addr [[A]]
// CHECK:       cond_br
// CHECK:       load [trivial] [[P]]
// CHECK-NEXT:  end_borrow [[IB]]
// CHECK-NEXT:  end_borrow [[B]]
// CHECK-NEXT:  br
// CHECK:       load [trivial] [[P]]
// CHECK-NEXT:  end_borrow [[IB]]
// CHECK-NEXT:  end_borrow [[B]]
// CHECK-NEXT:  br
// CHECK: } // end sil function 'test_address_result_projection_uses'
sil [ossa] @test_address_result_projection_uses : $@convention(thin) (@owned Klass) -> Builtin.Int64 {
bb0(%0 : @owned $Klass):
  %1 = function_ref @klass_address_borrow_accessor : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
  %2 = apply %1(%0) : $@convention(method) (@guaranteed Klass) -> @guaranteed_address Int
  %3 = struct_element_addr %2 : $*Int, #Int._value
  cond_br undef, bb1, bb2

bb1:
  %5 = load [trivial] %3 : $*Builtin.Int64
  br bb3(%5 : $Builtin.Int64)

bb2:
  %7 = load [trivial] %3 : $*Builtin.Int64
  br bb3(%7 : $Builtin.Int64)

bb3(%9 : $Builtin.Int64):
  destroy_value %0 : $Klass
  return %9 : $Builtin.Int64
}

