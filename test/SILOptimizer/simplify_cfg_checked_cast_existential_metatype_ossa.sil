// RUN: %target-sil-opt -enable-sil-verify-all %s -simplify-cfg | %FileCheck %s

// Check that the CastOptimizer looks through ownership instructions when
// computing the concrete type of an `existential_metatype` in OSSA.

sil_stage canonical

import Builtin
import Swift

protocol P : AnyObject {}

class C : P {}
class D : P {}

// CHECK-LABEL: sil [ossa] @checked_cast_of_metatype_of_borrowed_existential :
// CHECK-NOT:     checked_cast_br
// CHECK:         [[R:%.*]] = integer_literal $Builtin.Int1, 0
// CHECK-NEXT:    return [[R]]
// CHECK:       } // end sil function 'checked_cast_of_metatype_of_borrowed_existential'
sil [ossa] @checked_cast_of_metatype_of_borrowed_existential : $@convention(thin) () -> Builtin.Int1 {
bb0:
  %0 = alloc_ref $C
  %1 = init_existential_ref %0 : $C : $C, $any P
  %2 = begin_borrow %1
  %3 = existential_metatype $@thick any P.Type, %2
  end_borrow %2
  destroy_value %1
  checked_cast_br any P.Type in %3 : $@thick any P.Type to D.Type, bb1, bb2

bb1(%7 : $@thick D.Type):
  %8 = integer_literal $Builtin.Int1, -1
  br bb3(%8)

bb2(%10 : $@thick any P.Type):
  %11 = integer_literal $Builtin.Int1, 0
  br bb3(%11)

bb3(%13 : $Builtin.Int1):
  return %13
}

// CHECK-LABEL: sil [ossa] @checked_cast_of_metatype_of_moved_alloc_ref :
// CHECK-NOT:     checked_cast_br
// CHECK:         [[R:%.*]] = integer_literal $Builtin.Int1, 0
// CHECK-NEXT:    return [[R]]
// CHECK:       } // end sil function 'checked_cast_of_metatype_of_moved_alloc_ref'
sil [ossa] @checked_cast_of_metatype_of_moved_alloc_ref : $@convention(thin) () -> Builtin.Int1 {
bb0:
  %0 = alloc_ref $C
  %1 = move_value [lexical] %0
  %2 = end_init_let_ref %1
  %3 = copy_value %2
  %4 = init_existential_ref %3 : $C : $C, $any P
  %5 = existential_metatype $@thick any P.Type, %4
  destroy_value %4
  destroy_value %2
  checked_cast_br any P.Type in %5 : $@thick any P.Type to D.Type, bb1, bb2

bb1(%7 : $@thick D.Type):
  %8 = integer_literal $Builtin.Int1, -1
  br bb3(%8)

bb2(%10 : $@thick any P.Type):
  %11 = integer_literal $Builtin.Int1, 0
  br bb3(%11)

bb3(%13 : $Builtin.Int1):
  return %13
}

// CHECK-LABEL: sil [ossa] @checked_cast_of_metatype_of_unknown_existential :
// CHECK:         existential_metatype
// CHECK:         checked_cast_br any P.Type in
// CHECK:       } // end sil function 'checked_cast_of_metatype_of_unknown_existential'
sil [ossa] @checked_cast_of_metatype_of_unknown_existential : $@convention(thin) (@guaranteed C) -> Builtin.Int1 {
bb0(%0 : @guaranteed $C):
  %1 = init_existential_ref %0 : $C : $C, $any P
  %2 = begin_borrow %1
  %3 = existential_metatype $@thick any P.Type, %2
  end_borrow %2
  checked_cast_br any P.Type in %3 : $@thick any P.Type to D.Type, bb1, bb2

bb1(%7 : $@thick D.Type):
  %8 = integer_literal $Builtin.Int1, -1
  br bb3(%8)

bb2(%10 : $@thick any P.Type):
  %11 = integer_literal $Builtin.Int1, 0
  br bb3(%11)

bb3(%13 : $Builtin.Int1):
  return %13
}
