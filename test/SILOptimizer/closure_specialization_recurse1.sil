// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all -closure-specialization %s | %FileCheck %s

// Fails on wasm32 because of 32/64 mismatch on stdlib function operating on String
// REQUIRES: PTRSIZE=64

// The SIL corresponds to the following Swift source:
//
// @inline(never)
// func rec<T>(_ v: T, depth: Int, f: (T) -> String) -> String {
//   if depth <= 0 { return f(v) }
//   return rec(v, depth: depth - 1) { x in return f(x) + "-t" }
// }
// @inline(never)
// func caller() -> String {
//   return rec("X", depth: 3) { "[\($0)]" }
// }

sil_stage canonical

import Builtin
import Swift

sil @$ss12_SmallStringV15_invariantCheckyyF : $@convention(method) (_SmallString) -> ()
sil @$ss13_StringObjectV15_invariantCheckyyF : $@convention(method) (@guaranteed _StringObject) -> ()
sil @$ss11_StringGutsV15_invariantCheckyyF : $@convention(method) (@guaranteed _StringGuts) -> ()
sil @$sSS15_invariantCheckyyF : $@convention(method) (@guaranteed String) -> ()

sil @$s4main6callerSSyFS2SXEfU_ : $@convention(thin) @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>
sil [transparent] [thunk] [ossa] @$s4main3rec_5depth1fSSx_SiSSxXEtlFSSxXEfU_SS_TG5 : $@convention(thin) (@in_guaranteed String, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String


