// specialized rec<A>(_:depth:f:)
sil shared [noinline] [ossa] @$s4main3rec_5depth1fSSx_SiSSxXEtlFSS_Tg5 : $@convention(thin) (@guaranteed String, Int, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String {
bb0(%0 : @guaranteed $String, %1 : $Int, %2 : @guaranteed $@noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>):
  %3 = alloc_stack $String                        // users: %31, %4
  %4 = store_borrow %0 to %3                      // users: %27, %13, %12, %5
  %8 = integer_literal $Builtin.Int64, 0          // user: %10
  %9 = struct_extract %1, #Int._value             // users: %17, %10
  %10 = builtin "cmp_sge_Int64"(%8, %9) : $Builtin.Int1 // user: %11
  cond_br %10, bb1, bb2                           // id: %11

bb1:                                              // Preds: bb0
  %12 = apply %2(%4) : $@noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String> // user: %14
  end_borrow %4                                   // id: %13
  br bb3(%12)                                     // id: %14

bb2:                                              // Preds: bb0
  %15 = integer_literal $Builtin.Int64, 1         // user: %17
  %16 = integer_literal $Builtin.Int1, -1         // user: %17
  %17 = builtin "ssub_with_overflow_Int64"(%9, %15, %16) : $(Builtin.Int64, Builtin.Int1) // users: %19, %18
  %18 = tuple_extract %17, 0                      // user: %21
  %19 = tuple_extract %17, 1                      // user: %20
  cond_fail %19, "arithmetic overflow"            // id: %20
  %21 = struct $Int (%18)                         // user: %26
  // function_ref specialized closure #1 in rec<A>(_:depth:f:)
  %22 = function_ref @$s4main3rec_5depth1fSSx_SiSSxXEtlFSSxXEfU_SS_TG5 : $@convention(thin) (@in_guaranteed String, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String // user: %23
  %23 = partial_apply [callee_guaranteed] [on_stack] %22(%2) : $@convention(thin) (@in_guaranteed String, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String // user: %24
  %24 = convert_function %23 to $@noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String> // users: %26, %28
  // function_ref specialized rec<A>(_:depth:f:)
  %25 = function_ref @$s4main3rec_5depth1fSSx_SiSSxXEtlFSS_Tg5 : $@convention(thin) (@guaranteed String, Int, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String // user: %26
  %26 = apply %25(%0, %21, %24) : $@convention(thin) (@guaranteed String, Int, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String // user: %29
  end_borrow %4                                   // id: %27
  destroy_value %24                               // id: %28
  br bb3(%26)                                     // id: %29

// %30                                            // user: %32
bb3(%30 : @owned $String):                        // Preds: bb2 bb1
  dealloc_stack %3                                // id: %31
  return %30                                      // id: %32
} // end sil function '$s4main3rec_5depth1fSSx_SiSSxXEtlFSS_Tg5'


