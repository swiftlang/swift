// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all -closure-specialization %s | %FileCheck %s

// Fails on wasm32 because of 32/64 mismatch on stdlib function operating on String
// REQUIRES: PTRSIZE=64

// The SIL corresponds to the following Swift source:
//
// @inline(never)
// func rec<T>(_ v: T, depth: Int, f: (T) -> String) -> String {
//   if depth <= 0 { return f(v) }
//   return rec(v, depth: depth - 1) { x in return f(x) + "-t" }
// }
// @inline(never)
// func caller() -> String {
//   return rec("X", depth: 3) { "[\($0)]" }
// }

sil_stage canonical

import Builtin
import Swift

sil @$ss12_SmallStringV15_invariantCheckyyF : $@convention(method) (_SmallString) -> ()
sil @$ss13_StringObjectV15_invariantCheckyyF : $@convention(method) (@guaranteed _StringObject) -> ()
sil @$ss11_StringGutsV15_invariantCheckyyF : $@convention(method) (@guaranteed _StringGuts) -> ()
sil @$sSS15_invariantCheckyyF : $@convention(method) (@guaranteed String) -> ()

sil @$s4main6callerSSyFS2SXEfU_ : $@convention(thin) @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>
sil [transparent] [thunk] [ossa] @$s4main3rec_5depth1fSSx_SiSSxXEtlFSSxXEfU_SS_TG5 : $@convention(thin) (@in_guaranteed String, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String


// CHECK: sil shared [noinline] [ossa] @$s4main3rec_5depth1fSSx_SiSSxXEtlFSS_Tg526$s4main6callerSSyFS2SXEfU_Tf1nnc_n : $@convention(thin) (@guaranteed String, Int) -> @owned String {
// CHECK: bb0(%0 : @guaranteed $String, %1 : $Int):
// CHECK:   // function_ref closure #1 in caller()
// CHECK:   %[[#A2:]] = function_ref @$s4main6callerSSyFS2SXEfU_ : $@convention(thin) @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>
// CHECK:   %[[#A3:]] = thin_to_thick_function %[[#A2]] : $@convention(thin) @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String> to $@noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>

// CHECK: bb1:
// CHECK:   %[[#A13:]] = apply %[[#A3]](%[[#]]) : $@noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>
// CHECK:   br bb3(%[[#A13]] : $String)

// CHECK: bb2:
// CHECK:  %[[#A22:]] = struct $Int (%[[#]] : $Builtin.Int64)
// CHECK:  %[[#A27:]] = function_ref @$s4main3rec_5depth1fSSx_SiSSxXEtlFSS_Tg5026$s4main3rec_5depth1fSSx_SiF19XEtlFSSxXEfU_SS_TG5xSSRi_zRi0_zlySSIsgno_Tf1nnc_n : $@convention(thin) (@guaranteed String, Int, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String
// CHECK:  %[[#A28:]] = apply %[[#A27]](%0, %[[#A22]], %[[#A3]]) : $@convention(thin) (@guaranteed String, Int, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String
// CHECK:  br bb3(%[[#A28]] : $String)

// CHECK: bb3(%[[#A32:]] : @owned $String):
// CHECK:  return %[[#A32]] : $String
// } // end sil function '$s4main3rec_5depth1fSSx_SiSSxXEtlFSS_Tg526$s4main6callerSSyFS2SXEfU_Tf1nnc_n'


