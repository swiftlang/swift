// CHECK: bb3(%[[#A32:]] : @owned $String):
// CHECK:  return %[[#A32]] : $String
// } // end sil function '$s4main3rec_5depth1fSSx_SiSSxXEtlFSS_Tg526$s4main6callerSSyFS2SXEfU_Tf1nnc_n'


