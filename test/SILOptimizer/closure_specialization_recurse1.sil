// CHECK:   br bb3(%[[#B16]] : $String)

// CHECK: bb2:                                              // Preds: bb0
// CHECK:  %[[#B25:]] = struct $Int (%[[#]] : $Builtin.Int64)
// CHECK:  // function_ref specialized rec<A>(_:depth:f:)
// CHECK:  %[[#B30:]] = function_ref @$s4main3rec_5depth1fSSx_SiSSxXEtlFSS_Tg5026$s4main3rec_5depth1fSSx_SiF19XEtlFSSxXEfU_SS_TG5xSSRi_zRi0_zlySSIsgno_Tf1nnc_n : $@convention(thin) (@guaranteed String, Int, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String
// CHECK:  %[[#B31:]] = apply %[[#B30]](%0, %[[#B25]], %[[#B6]]) : $@convention(thin) (@guaranteed String, Int, @guaranteed @noescape @callee_guaranteed @substituted <τ_0_0> (@in_guaranteed τ_0_0) -> @owned String for <String>) -> @owned String
// CHECK:  br bb3(%[[#B31]] : $String)

// CHECK: bb3(%[[#B35:]] : @owned $String):                        // Preds: bb2 bb1
