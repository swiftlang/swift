// Without ownership, the inlined OSSA callee drops the closure with
// release_value, and the caller deallocates it.
//
// CHECK-LABEL: sil @test_inline_call_of_at_most_once_closure_without_ownership :
// CHECK:       bb0(%0 : $Builtin.Int1, [[CAPTURE:%.*]] : $NoncopyableKlass):
// CHECK-NOT:     partial_apply
// CHECK:       bb1:
// CHECK-NEXT:    release_value [[CAPTURE]] : $NoncopyableKlass
// CHECK:       bb2:
// CHECK-NEXT:    release_value [[CAPTURE]] : $NoncopyableKlass
// CHECK-NOT:     dealloc_stack
// CHECK:       } // end sil function 'test_inline_call_of_at_most_once_closure_without_ownership'
sil @test_inline_call_of_at_most_once_closure_without_ownership : $@convention(thin) (Builtin.Int1, @owned NoncopyableKlass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : $NoncopyableKlass):
  %2 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %3 = partial_apply [on_stack] [called_at_most_once] %2(%1) : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %4 = function_ref @callAtMostOnceIf : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %5 = apply %4(%0, %3) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  dealloc_stack %3 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  return %5 : $Builtin.Int64
}

// CHECK-LABEL: sil @test_inline_call_of_at_most_once_closure_strong_release :
// CHECK:       bb0(%0 : $Builtin.Int1, [[CAPTURE:%.*]] : $NoncopyableKlass):
// CHECK-NOT:     partial_apply
// CHECK:       bb2:
// CHECK-NEXT:    release_value [[CAPTURE]] : $NoncopyableKlass
// CHECK-NOT:     strong_release
// CHECK:       } // end sil function 'test_inline_call_of_at_most_once_closure_strong_release'
sil @test_inline_call_of_at_most_once_closure_strong_release : $@convention(thin) (Builtin.Int1, @owned NoncopyableKlass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : $NoncopyableKlass):
  %2 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
