  %5 = apply %4(%0, %3) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  dealloc_stack %3 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  return %5 : $Builtin.Int64
}

// A dead end can destroy an exactly-once closure, because no destructor runs
// there.
//
// CHECK-LABEL: sil [ossa] @test_inline_call_of_exactly_once_closure_destroyed_in_dead_end :
// CHECK:       bb0(%0 : $Builtin.Int1, [[CAPTURE:%.*]] : @owned $NoncopyableKlass):
// CHECK-NOT:     partial_apply
// CHECK:       bb1:
// CHECK-NEXT:    destroy_value [[CAPTURE]] : $NoncopyableKlass
// CHECK:       bb2:
// CHECK-NEXT:    destroy_value [dead_end] [[CAPTURE]] : $NoncopyableKlass
// CHECK-NEXT:    unreachable
// CHECK:       } // end sil function 'test_inline_call_of_exactly_once_closure_destroyed_in_dead_end'
sil [ossa] @test_inline_call_of_exactly_once_closure_destroyed_in_dead_end : $@convention(thin) (Builtin.Int1, @owned NoncopyableKlass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $NoncopyableKlass):
  %2 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %3 = partial_apply [on_stack] [called_once] %2(%1) : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %4 = function_ref @callExactlyOnceElseTrap : $@convention(thin) (Builtin.Int1, @owned @noescape @once @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %5 = apply %4(%0, %3) : $@convention(thin) (Builtin.Int1, @owned @noescape @once @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %5 : $Builtin.Int64
}

sil [transparent] [ossa] @consumingCopyableAddressClosure : $@convention(thin) <T> (@in T) -> Builtin.Int64 {
bb0(%0 : $*T):
  destroy_addr %0 : $*T
  %2 = integer_literal $Builtin.Int64, 1
  return %2 : $Builtin.Int64
}

// The context of an on-stack at-most-once closure only borrows a copyable
// address capture, which the inlined call would consume, so the call isn't
// inlined.
//
// CHECK-LABEL: sil [ossa] @test_dont_inline_call_of_at_most_once_closure_borrowed_in_capture :
// CHECK:         partial_apply [on_stack] [called_at_most_once]
// CHECK:         apply {{%.*}}() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
// CHECK:       } // end sil function 'test_dont_inline_call_of_at_most_once_closure_borrowed_in_capture'
sil [ossa] @test_dont_inline_call_of_at_most_once_closure_borrowed_in_capture : $@convention(thin) <T> (Builtin.Int1, @in_guaranteed T) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : $*T):
  %2 = alloc_stack $T
  copy_addr %1 to [init] %2 : $*T
  %4 = function_ref @consumingCopyableAddressClosure : $@convention(thin) <T> (@in T) -> Builtin.Int64
  %5 = partial_apply [on_stack] [called_at_most_once] %4<T>(%2) : $@convention(thin) <T> (@in T) -> Builtin.Int64
  %6 = function_ref @callAtMostOnceIf : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %7 = apply %6(%0, %5) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  destroy_addr %2 : $*T
  dealloc_stack %2 : $*T
  return %7 : $Builtin.Int64
}

// A dead end doesn't destroy the exactly-once closure's noncopyable address
