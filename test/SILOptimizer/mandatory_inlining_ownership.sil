struct NoncopyableKlass: ~Copyable {
  var k: Klass
}

sil [transparent] [ossa] @borrowingClosure : $@convention(thin) (@guaranteed Klass) -> Builtin.Int64 {
bb0(%0 : @guaranteed $Klass):
  %1 = integer_literal $Builtin.Int64, 1
  return %1 : $Builtin.Int64
}

sil [transparent] [ossa] @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64 {
bb0(%0 : @owned $NoncopyableKlass):
  destroy_value %0 : $NoncopyableKlass
  %2 = integer_literal $Builtin.Int64, 1
  return %2 : $Builtin.Int64
}

sil [transparent] [ossa] @callAtMostOnceIf : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $@noescape @callable(once) @callee_owned () -> Builtin.Int64):
  cond_br %0, bb1, bb2

bb1:
  %3 = apply %1() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  br bb3(%3 : $Builtin.Int64)

bb2:
  destroy_value %1 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  %6 = integer_literal $Builtin.Int64, 0
  br bb3(%6 : $Builtin.Int64)

bb3(%8 : $Builtin.Int64):
  return %8 : $Builtin.Int64
}

sil [transparent] [ossa] @callAtMostOnceOnEitherPath : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $@noescape @callable(once) @callee_owned () -> Builtin.Int64):
  cond_br %0, bb1, bb2

bb1:
  %3 = apply %1() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  br bb3(%3 : $Builtin.Int64)

bb2:
  %5 = apply %1() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  br bb3(%5 : $Builtin.Int64)

bb3(%7 : $Builtin.Int64):
  return %7 : $Builtin.Int64
}

sil [transparent] [ossa] @callExactlyOnce : $@convention(thin) (@owned @noescape @once @callee_owned () -> Builtin.Int64) -> Builtin.Int64 {
bb0(%0 : @owned $@noescape @once @callee_owned () -> Builtin.Int64):
  %1 = apply %0() : $@noescape @once @callee_owned () -> Builtin.Int64
  return %1 : $Builtin.Int64
}

// The call of an on-stack at-most-once closure consumes it. After inlining the
// call, nothing needs the closure, so it is deleted. Its context only borrowed
// its capture, so the capture needs no destroy.
//
// CHECK-LABEL: sil [ossa] @test_inline_call_of_at_most_once_closure_borrowed_capture :
// CHECK-NOT:     partial_apply
// CHECK-NOT:     apply
// CHECK-NOT:     destroy_value
// CHECK:       } // end sil function 'test_inline_call_of_at_most_once_closure_borrowed_capture'
sil [ossa] @test_inline_call_of_at_most_once_closure_borrowed_capture : $@convention(thin) (Builtin.Int1, @guaranteed Klass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @guaranteed $Klass):
  %2 = function_ref @borrowingClosure : $@convention(thin) (@guaranteed Klass) -> Builtin.Int64
  %3 = partial_apply [on_stack] [called_at_most_once] %2(%1) : $@convention(thin) (@guaranteed Klass) -> Builtin.Int64
  %4 = move_value [lexical] %3 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  %5 = function_ref @callAtMostOnceIf : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %6 = apply %5(%0, %4) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %6 : $Builtin.Int64
}

// The inlined call consumes the value that the closure's context owned, and the
// path that dropped the closure destroys the value instead.
//
// CHECK-LABEL: sil [ossa] @test_inline_call_of_at_most_once_closure_consumed_capture :
// CHECK:       bb0(%0 : $Builtin.Int1, [[CAPTURE:%.*]] : @owned $NoncopyableKlass):
// CHECK-NOT:     partial_apply
// CHECK:         cond_br %0, bb1, bb2
// CHECK:       bb1:
// CHECK-NEXT:    destroy_value [[CAPTURE]] : $NoncopyableKlass
// CHECK:       bb2:
// CHECK-NEXT:    destroy_value [[CAPTURE]] : $NoncopyableKlass
// CHECK-NOT:     destroy_value
// CHECK:       } // end sil function 'test_inline_call_of_at_most_once_closure_consumed_capture'
sil [ossa] @test_inline_call_of_at_most_once_closure_consumed_capture : $@convention(thin) (Builtin.Int1, @owned NoncopyableKlass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $NoncopyableKlass):
  %2 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %3 = partial_apply [on_stack] [called_at_most_once] %2(%1) : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %4 = move_value [lexical] %3 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  %5 = function_ref @callAtMostOnceIf : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %6 = apply %5(%0, %4) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %6 : $Builtin.Int64
}

// With a second call, the closure can't be deleted after inlining one call, so
// neither call is inlined.
//
// CHECK-LABEL: sil [ossa] @test_dont_inline_calls_of_at_most_once_closure_on_either_path :
// CHECK:         partial_apply [on_stack] [called_at_most_once]
// CHECK:         apply {{%.*}}() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
// CHECK:         apply {{%.*}}() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
// CHECK:       } // end sil function 'test_dont_inline_calls_of_at_most_once_closure_on_either_path'
sil [ossa] @test_dont_inline_calls_of_at_most_once_closure_on_either_path : $@convention(thin) (Builtin.Int1, @owned NoncopyableKlass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $NoncopyableKlass):
  %2 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %3 = partial_apply [on_stack] [called_at_most_once] %2(%1) : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %4 = function_ref @callAtMostOnceOnEitherPath : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %5 = apply %4(%0, %3) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %5 : $Builtin.Int64
}

// CHECK-LABEL: sil [ossa] @test_inline_call_of_exactly_once_closure :
// CHECK:       bb0([[CAPTURE:%.*]] : @owned $NoncopyableKlass):
// CHECK-NOT:     partial_apply
// CHECK:         destroy_value [[CAPTURE]] : $NoncopyableKlass
// CHECK-NOT:     destroy_value
// CHECK:       } // end sil function 'test_inline_call_of_exactly_once_closure'
sil [ossa] @test_inline_call_of_exactly_once_closure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64 {
bb0(%0 : @owned $NoncopyableKlass):
  %1 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %2 = partial_apply [on_stack] [called_once] %1(%0) : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %3 = function_ref @callExactlyOnce : $@convention(thin) (@owned @noescape @once @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %4 = apply %3(%2) : $@convention(thin) (@owned @noescape @once @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %4 : $Builtin.Int64
}

// withoutActuallyDeiniting lets an exactly-once closure be destroyed, but its
// destructor still traps. Deleting the closure after inlining its call would
// drop the trap, so the call isn't inlined.
//
// CHECK-LABEL: sil [ossa] @test_dont_inline_call_of_exactly_once_closure_without_actually_deiniting :
// CHECK:         partial_apply [on_stack] [called_once]
// CHECK:         apply {{%.*}}() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
// CHECK:         destroy_value {{%.*}} : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
// CHECK:       } // end sil function 'test_dont_inline_call_of_exactly_once_closure_without_actually_deiniting'
sil [ossa] @test_dont_inline_call_of_exactly_once_closure_without_actually_deiniting : $@convention(thin) (Builtin.Int1, @owned NoncopyableKlass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $NoncopyableKlass):
  %2 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %3 = partial_apply [on_stack] [called_once] %2(%1) : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %4 = convert_function %3 : $@noescape @once @callee_owned () -> Builtin.Int64 to [without_actually_deiniting] $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  %5 = function_ref @callAtMostOnceIf : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %6 = apply %5(%0, %4) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %6 : $Builtin.Int64
}

sil [transparent] [ossa] @consumingAddressClosure : $@convention(thin) <T: ~Copyable> (@in T) -> Builtin.Int64 {
bb0(%0 : $*T):
  destroy_addr %0 : $*T
  %2 = integer_literal $Builtin.Int64, 1
  return %2 : $Builtin.Int64
}

sil [transparent] [ossa] @callAtMostOnceIfWithDebugValue : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $@noescape @callable(once) @callee_owned () -> Builtin.Int64):
  debug_value %1 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64, let, name "f"
  cond_br %0, bb1, bb2

bb1:
  %4 = apply %1() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  br bb3(%4 : $Builtin.Int64)

bb2:
  destroy_value %1 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  %7 = integer_literal $Builtin.Int64, 0
  br bb3(%7 : $Builtin.Int64)

bb3(%9 : $Builtin.Int64):
  return %9 : $Builtin.Int64
}

sil [transparent] @callAtMostOnceIfWithoutOwnership : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64):
  cond_br %0, bb1, bb2

bb1:
  %3 = apply %1() : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  br bb3(%3 : $Builtin.Int64)

bb2:
  strong_release %1 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  %6 = integer_literal $Builtin.Int64, 0
  br bb3(%6 : $Builtin.Int64)

bb3(%8 : $Builtin.Int64):
  return %8 : $Builtin.Int64
}

sil [transparent] [ossa] @callExactlyOnceElseTrap : $@convention(thin) (Builtin.Int1, @owned @noescape @once @callee_owned () -> Builtin.Int64) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $@noescape @once @callee_owned () -> Builtin.Int64):
  cond_br %0, bb1, bb2

bb1:
  %3 = apply %1() : $@noescape @once @callee_owned () -> Builtin.Int64
  return %3 : $Builtin.Int64

bb2:
  destroy_value [dead_end] %1 : $@noescape @once @callee_owned () -> Builtin.Int64
  unreachable
}

// The closure's uses that go away with it include a mark_dependence and a
// debug_value.
//
// CHECK-LABEL: sil [ossa] @test_inline_call_of_at_most_once_closure_through_mark_dependence :
// CHECK:       bb0(%0 : $Builtin.Int1, [[CAPTURE:%.*]] : @owned $NoncopyableKlass, %2 : @guaranteed $Klass):
// CHECK-NOT:     partial_apply
// CHECK-NOT:     mark_dependence
// CHECK:       bb1:
// CHECK-NEXT:    destroy_value [[CAPTURE]] : $NoncopyableKlass
// CHECK:       bb2:
// CHECK-NEXT:    destroy_value [[CAPTURE]] : $NoncopyableKlass
// CHECK:       } // end sil function 'test_inline_call_of_at_most_once_closure_through_mark_dependence'
sil [ossa] @test_inline_call_of_at_most_once_closure_through_mark_dependence : $@convention(thin) (Builtin.Int1, @owned NoncopyableKlass, @guaranteed Klass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @owned $NoncopyableKlass, %2 : @guaranteed $Klass):
  %3 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %4 = partial_apply [on_stack] [called_at_most_once] %3(%1) : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %5 = mark_dependence [nonescaping] %4 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64 on %2 : $Klass
  %6 = function_ref @callAtMostOnceIfWithDebugValue : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %7 = apply %6(%0, %5) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %7 : $Builtin.Int64
}

