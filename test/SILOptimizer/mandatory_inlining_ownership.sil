//
// CHECK-LABEL: sil [ossa] @test_inline_call_of_exactly_once_closure_address_capture_dead_end :
// CHECK:       bb0(%0 : $Builtin.Int1, [[CAPTURE:%.*]] : $*T):
// CHECK-NOT:     partial_apply
// CHECK:       bb1:
// CHECK-NEXT:    destroy_addr [[CAPTURE]] : $*T
// CHECK:       bb2:
// CHECK-NEXT:    unreachable
// CHECK:       } // end sil function 'test_inline_call_of_exactly_once_closure_address_capture_dead_end'
sil [ossa] @test_inline_call_of_exactly_once_closure_address_capture_dead_end : $@convention(thin) <T: ~Copyable> (Builtin.Int1, @in T) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : $*T):
  %2 = function_ref @consumingAddressClosure : $@convention(thin) <T: ~Copyable> (@in T) -> Builtin.Int64
  %3 = partial_apply [on_stack] [called_once] %2<T>(%1) : $@convention(thin) <T: ~Copyable> (@in T) -> Builtin.Int64
  %4 = function_ref @callExactlyOnceElseTrap : $@convention(thin) (Builtin.Int1, @owned @noescape @once @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %5 = apply %4(%0, %3) : $@convention(thin) (Builtin.Int1, @owned @noescape @once @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %5 : $Builtin.Int64
}

sil @makeNoncopyableKlass : $@convention(thin) () -> @owned NoncopyableKlass

// The closure's lexical lifetime begins at a move_value behind a
// mark_dependence. Its capture becomes lexical when the closure is deleted.
//
// CHECK-LABEL: sil [ossa] @test_inline_call_of_lexical_at_most_once_closure_through_mark_dependence :
// CHECK:         [[VALUE:%.*]] = apply
// CHECK:         [[CAPTURE:%.*]] = move_value [lexical] [[VALUE]] : $NoncopyableKlass
// CHECK-NOT:     partial_apply
// CHECK:       bb1:
// CHECK-NEXT:    destroy_value [[CAPTURE]] : $NoncopyableKlass
// CHECK:       bb2:
// CHECK-NEXT:    destroy_value [[CAPTURE]] : $NoncopyableKlass
// CHECK:       } // end sil function 'test_inline_call_of_lexical_at_most_once_closure_through_mark_dependence'
sil [ossa] @test_inline_call_of_lexical_at_most_once_closure_through_mark_dependence : $@convention(thin) (Builtin.Int1, @guaranteed Klass) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int1, %1 : @guaranteed $Klass):
  %2 = function_ref @makeNoncopyableKlass : $@convention(thin) () -> @owned NoncopyableKlass
  %3 = apply %2() : $@convention(thin) () -> @owned NoncopyableKlass
  %4 = function_ref @consumingClosure : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %5 = partial_apply [on_stack] [called_at_most_once] %4(%3) : $@convention(thin) (@owned NoncopyableKlass) -> Builtin.Int64
  %6 = mark_dependence [nonescaping] %5 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64 on %1 : $Klass
  %7 = move_value [lexical] %6 : $@noescape @callable(once) @callee_owned () -> Builtin.Int64
  %8 = function_ref @callAtMostOnceIf : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  %9 = apply %8(%0, %7) : $@convention(thin) (Builtin.Int1, @owned @noescape @callable(once) @callee_owned () -> Builtin.Int64) -> Builtin.Int64
  return %9 : $Builtin.Int64
}
