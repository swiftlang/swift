// RUN: %target-sil-opt -enable-sil-opaque-values -copy-to-borrow-optimization %s | %FileCheck %s

sil_stage raw

import Builtin
import Swift

class C {}

struct Box<T> {
  var t: T
}

enum Either<T> {
  case left(C)
  case right(T)
}

sil @useOptional : $@convention(thin) <T> (@in_guaranteed Optional<T>) -> ()
sil @useTuple : $@convention(thin) <T> (Int, @in_guaranteed T) -> ()
sil @useBox : $@convention(thin) <T> (@in_guaranteed Box<T>) -> ()
sil @useEither : $@convention(thin) <T> (@in_guaranteed Either<T>) -> ()
sil @useT : $@convention(thin) <T> (@in_guaranteed T) -> ()

// In opaque-values mode, an address-only `enum` must be owned, so it cannot forward a borrow.
// CHECK-LABEL: sil [ossa] [opaque] @dont_borrow_into_address_only_enum :
// CHECK:         [[C:%.*]] = copy_value %0
// CHECK-NEXT:    [[E:%.*]] = enum $Optional<T>, #Optional.some!enumelt, [[C]]
// CHECK:         destroy_value [[E]]
// CHECK:       } // end sil function 'dont_borrow_into_address_only_enum'
sil [ossa] @dont_borrow_into_address_only_enum : $@convention(thin) <T> (@in_guaranteed T) -> () {
bb0(%0 : @guaranteed $T):
  %1 = copy_value %0
  %2 = enum $Optional<T>, #Optional.some!enumelt, %1
  %3 = function_ref @useOptional : $@convention(thin) <τ_0_0> (@in_guaranteed Optional<τ_0_0>) -> ()
  %4 = apply %3<T>(%2) : $@convention(thin) <τ_0_0> (@in_guaranteed Optional<τ_0_0>) -> ()
  destroy_value %2
  %6 = tuple ()
  return %6
}

// CHECK-LABEL: sil [ossa] [opaque] @dont_borrow_into_address_only_tuple :
// CHECK:         [[C:%.*]] = copy_value %1
// CHECK-NEXT:    [[T:%.*]] = tuple (%0, [[C]])
// CHECK:         destroy_value [[T]]
// CHECK:       } // end sil function 'dont_borrow_into_address_only_tuple'
sil [ossa] @dont_borrow_into_address_only_tuple : $@convention(thin) <T> (Int, @in_guaranteed T) -> () {
bb0(%0 : $Int, %1 : @guaranteed $T):
  %2 = copy_value %1
  %3 = tuple $(Int, T) (%0, %2)
  %4 = begin_borrow %3
  (%5, %6) = destructure_tuple %4
  %7 = function_ref @useTuple : $@convention(thin) <τ_0_0> (Int, @in_guaranteed τ_0_0) -> ()
  %8 = apply %7<T>(%5, %6) : $@convention(thin) <τ_0_0> (Int, @in_guaranteed τ_0_0) -> ()
  end_borrow %4
  destroy_value %3
  %11 = tuple ()
  return %11
}

// CHECK-LABEL: sil [ossa] [opaque] @dont_borrow_into_address_only_struct :
// CHECK:         [[C:%.*]] = copy_value %0
// CHECK-NEXT:    [[S:%.*]] = struct $Box<T> ([[C]])
// CHECK:         destroy_value [[S]]
// CHECK:       } // end sil function 'dont_borrow_into_address_only_struct'
sil [ossa] @dont_borrow_into_address_only_struct : $@convention(thin) <T> (@in_guaranteed T) -> () {
bb0(%0 : @guaranteed $T):
  %1 = copy_value %0
  %2 = struct $Box<T> (%1)
  %3 = function_ref @useBox : $@convention(thin) <τ_0_0> (@in_guaranteed Box<τ_0_0>) -> ()
  %4 = apply %3<T>(%2) : $@convention(thin) <τ_0_0> (@in_guaranteed Box<τ_0_0>) -> ()
  destroy_value %2
  %6 = tuple ()
  return %6
}

// The enum is address-only even though its payload is loadable.
// CHECK-LABEL: sil [ossa] [opaque] @dont_borrow_into_address_only_enum_of_loadable_payload :
// CHECK:         [[C:%.*]] = copy_value %0
// CHECK-NEXT:    [[E:%.*]] = enum $Either<T>, #Either.left!enumelt, [[C]]
// CHECK:         destroy_value [[E]]
// CHECK:       } // end sil function 'dont_borrow_into_address_only_enum_of_loadable_payload'
sil [ossa] @dont_borrow_into_address_only_enum_of_loadable_payload : $@convention(thin) <T> (@guaranteed C) -> () {
bb0(%0 : @guaranteed $C):
  %1 = copy_value %0
  %2 = enum $Either<T>, #Either.left!enumelt, %1
  %3 = function_ref @useEither : $@convention(thin) <τ_0_0> (@in_guaranteed Either<τ_0_0>) -> ()
  %4 = apply %3<T>(%2) : $@convention(thin) <τ_0_0> (@in_guaranteed Either<τ_0_0>) -> ()
  destroy_value %2
  %6 = tuple ()
  return %6
}

// CHECK-LABEL: sil [ossa] [opaque] @dont_borrow_into_address_only_value_cast :
// CHECK:         [[C:%.*]] = copy_value %0
// CHECK-NEXT:    [[V:%.*]] = unchecked_value_cast [[C]]
// CHECK:         destroy_value [[V]]
// CHECK:       } // end sil function 'dont_borrow_into_address_only_value_cast'
sil [ossa] @dont_borrow_into_address_only_value_cast : $@convention(thin) <T> (@in_guaranteed Box<T>) -> () {
bb0(%0 : @guaranteed $Box<T>):
  %1 = copy_value %0
  %2 = unchecked_value_cast %1 to $Box<T>
  %3 = function_ref @useBox : $@convention(thin) <τ_0_0> (@in_guaranteed Box<τ_0_0>) -> ()
  %4 = apply %3<T>(%2) : $@convention(thin) <τ_0_0> (@in_guaranteed Box<τ_0_0>) -> ()
  destroy_value %2
  %6 = tuple ()
  return %6
}

// A projection that preserves the representation can still forward a borrow.
// CHECK-LABEL: sil [ossa] [opaque] @borrow_address_only_struct_extract :
// CHECK-NOT:     copy_value
// CHECK:         [[B:%.*]] = begin_borrow %0
// CHECK-NEXT:    [[T:%.*]] = struct_extract [[B]], #Box.t
// CHECK:         apply {{%.*}}<T>([[T]])
// CHECK-NOT:     destroy_value
// CHECK:       } // end sil function 'borrow_address_only_struct_extract'
sil [ossa] @borrow_address_only_struct_extract : $@convention(thin) <T> (@in_guaranteed Box<T>) -> () {
bb0(%0 : @guaranteed $Box<T>):
  %1 = copy_value %0
  %2 = begin_borrow %1
  %3 = struct_extract %2, #Box.t
  %4 = function_ref @useT : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  %5 = apply %4<T>(%3) : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  end_borrow %2
  destroy_value %1
  %8 = tuple ()
  return %8
}
