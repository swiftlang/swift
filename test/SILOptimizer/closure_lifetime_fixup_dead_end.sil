// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all -closure-lifetime-fixup %s | %FileCheck %s

sil_stage raw

import Swift
import Builtin

class C {}

sil [ossa] @closure : $@convention(thin) (@guaranteed C) -> ()
sil [ossa] @use_closure_throws : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> ()) -> @error any Error

// rdar://190239363 - A closure destroyed on a dead-end path must be destroyed,
// and its captures cleaned up, before scopes that end ahead of the original
// destroy_value [dead_end] (e.g. a lifetime-dependent capture's borrow scope).
//
// CHECK-LABEL: sil [ossa] @test_dead_end_destroy_hoisted :
// CHECK:         [[COPY:%.*]] = copy_value
// CHECK:         [[CAPTURE:%.*]] = begin_borrow [[COPY]]
// CHECK:         [[CLOSURE:%.*]] = partial_apply [callee_guaranteed] [on_stack] {{%.*}}([[CAPTURE]])
// CHECK:       bb2([[ERROR:%.*]] : @owned $any Error):
// CHECK-NEXT:    destroy_value [dead_end] [[CLOSURE]]
// CHECK-NEXT:    end_borrow [[CAPTURE]]
// CHECK-NEXT:    destroy_value [dead_end] [[COPY]]
// CHECK-NEXT:    end_borrow %1
// CHECK-NEXT:    destroy_value %0
// CHECK-NEXT:    destroy_value [dead_end] [[ERROR]]
// CHECK-NEXT:    unreachable
// CHECK:       } // end sil function 'test_dead_end_destroy_hoisted'
sil [ossa] @test_dead_end_destroy_hoisted : $@convention(thin) (@owned C) -> () {
bb0(%0 : @owned $C):
  %1 = begin_borrow %0
  %2 = copy_value %1
  %3 = function_ref @closure : $@convention(thin) (@guaranteed C) -> ()
  %4 = partial_apply [callee_guaranteed] %3(%2) : $@convention(thin) (@guaranteed C) -> ()
  %5 = convert_escape_to_noescape [not_guaranteed] %4 to $@noescape @callee_guaranteed () -> ()
  %6 = function_ref @use_closure_throws : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> ()) -> @error any Error
  try_apply %6(%5) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> ()) -> @error any Error, normal bb1, error bb2

bb1(%8 : $()):
  destroy_value %5
  destroy_value %4
  end_borrow %1
  destroy_value %0
  %13 = tuple ()
  return %13

bb2(%15 : @owned $any Error):
  end_borrow %1
  destroy_value %0
  destroy_value [dead_end] %15
  destroy_value [dead_end] %5
  destroy_value [dead_end] %4
  unreachable
}

// The closure's single user is a begin_borrow whose scope ends in the dead-end
// block. The end_borrow is an interior use of the closure, so the closure's
// destroy_value [dead_end] must not be hoisted above it.
//
// CHECK-LABEL: sil [ossa] @test_dead_end_destroy_after_borrow :
// CHECK:         [[COPY:%.*]] = copy_value
// CHECK:         [[CAPTURE:%.*]] = begin_borrow [[COPY]]
// CHECK:         [[CLOSURE:%.*]] = partial_apply [callee_guaranteed] [on_stack] {{%.*}}([[CAPTURE]])
// CHECK:         [[BORROW:%.*]] = begin_borrow [[CLOSURE]]
// CHECK:       bb2([[ERROR:%.*]] : @owned $any Error):
// CHECK-NEXT:    end_borrow %1
// CHECK-NEXT:    destroy_value %0
// CHECK-NEXT:    end_borrow [[BORROW]]
// CHECK-NEXT:    destroy_value [dead_end] [[CLOSURE]]
// CHECK-NEXT:    end_borrow [[CAPTURE]]
// CHECK-NEXT:    destroy_value [dead_end] [[COPY]]
// CHECK-NEXT:    destroy_value [dead_end] [[ERROR]]
// CHECK-NEXT:    unreachable
// CHECK:       } // end sil function 'test_dead_end_destroy_after_borrow'
sil [ossa] @test_dead_end_destroy_after_borrow : $@convention(thin) (@owned C) -> () {
bb0(%0 : @owned $C):
  %1 = begin_borrow %0
  %2 = copy_value %1
  %3 = function_ref @closure : $@convention(thin) (@guaranteed C) -> ()
  %4 = partial_apply [callee_guaranteed] %3(%2) : $@convention(thin) (@guaranteed C) -> ()
  %5 = convert_escape_to_noescape [not_guaranteed] %4 to $@noescape @callee_guaranteed () -> ()
  %6 = begin_borrow %5
  %7 = function_ref @use_closure_throws : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> ()) -> @error any Error
  try_apply %7(%6) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> ()) -> @error any Error, normal bb1, error bb2

bb1(%9 : $()):
  end_borrow %6
  destroy_value %5
  destroy_value %4
  end_borrow %1
  destroy_value %0
  %15 = tuple ()
  return %15

bb2(%17 : @owned $any Error):
  end_borrow %1
  destroy_value %0
  end_borrow %6
  destroy_value [dead_end] %17
  destroy_value [dead_end] %5
  destroy_value [dead_end] %4
  unreachable
}
