// RUN: %target-sil-opt -test-runner -sil-disable-input-verify %s -o /dev/null 2>&1 | %FileCheck %s

// Unit tests for Type.subelementCount(in:) and FieldIndexTrie. Each function builds the trie from
// the type of the specified value, prints the leaf count and every node's leaf range, and probes a
// few conservative-fallback paths.

sil_stage raw

import Builtin

class Klass {}

struct SPair {
  var a: Klass
  var b: Klass
}

struct SNest {
  var p: SPair
  var c: Klass
}

// A flat 3-tuple: three leaves, one per element.
// CHECK-LABEL: begin running test {{.*}} on test_tuple_flat: field_index_trie
// CHECK: leafCount: 3
// CHECK: <root> -> 0..<3
// CHECK: 0 -> 0..<1
// CHECK: 1 -> 1..<2
// CHECK: 2 -> 2..<3
// CHECK-LABEL: end running test {{.*}} on test_tuple_flat: field_index_trie
sil @test_tuple_flat : $@convention(thin) (Builtin.Int64, Builtin.Int64, Builtin.Int64) -> () {
bb0(%0 : $Builtin.Int64, %1 : $Builtin.Int64, %2 : $Builtin.Int64):
  %t = tuple (%0 : $Builtin.Int64, %1 : $Builtin.Int64, %2 : $Builtin.Int64)
  specify_test "field_index_trie %t"
  %r = tuple ()
  return %r : $()
}

// A nested tuple ((Int, Int), Int): element 0 spans two leaves, element 1 is the third.
// CHECK-LABEL: begin running test {{.*}} on test_tuple_nested: field_index_trie
// CHECK: leafCount: 3
// CHECK: <root> -> 0..<3
// CHECK: 0 -> 0..<2
// CHECK: 0.0 -> 0..<1
// CHECK: 0.1 -> 1..<2
// CHECK: 1 -> 2..<3
// CHECK-LABEL: end running test {{.*}} on test_tuple_nested: field_index_trie
sil @test_tuple_nested : $@convention(thin) (Builtin.Int64, Builtin.Int64, Builtin.Int64) -> () {
bb0(%0 : $Builtin.Int64, %1 : $Builtin.Int64, %2 : $Builtin.Int64):
  %inner = tuple (%0 : $Builtin.Int64, %1 : $Builtin.Int64)
  %t = tuple (%inner : $(Builtin.Int64, Builtin.Int64), %2 : $Builtin.Int64)
  specify_test "field_index_trie %t"
  %r = tuple ()
  return %r : $()
}

// A nested struct SNest { p: SPair { a, b }, c }: field p spans two leaves (its two Klass fields),
// field c is the third. Klass is a class, so it is a single opaque leaf.
// CHECK-LABEL: begin running test {{.*}} on test_struct: field_index_trie
// CHECK: leafCount: 3
// CHECK: <root> -> 0..<3
// CHECK: s0 -> 0..<2
// CHECK: s0.s0 -> 0..<1
// CHECK: s0.s1 -> 1..<2
// CHECK: s1 -> 2..<3
// CHECK-LABEL: end running test {{.*}} on test_struct: field_index_trie
sil @test_struct : $@convention(thin) (@in_guaranteed SNest) -> () {
bb0(%0 : $*SNest):
  specify_test "field_index_trie %0"
  %r = tuple ()
  return %r : $()
}

// A bare class reference: a single opaque leaf, no children.
// CHECK-LABEL: begin running test {{.*}} on test_opaque: field_index_trie
// CHECK: leafCount: 1
// CHECK: <root> -> 0..<1
// CHECK-LABEL: end running test {{.*}} on test_opaque: field_index_trie
sil @test_opaque : $@convention(thin) (@guaranteed Klass) -> () {
bb0(%0 : $Klass):
  specify_test "field_index_trie %0"
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: begin running test {{.*}} on test_empty_tuple: field_index_trie
// CHECK: leafCount: 1
// CHECK: <root> -> 0..<1
// CHECK-LABEL: end running test {{.*}} on test_empty_tuple: field_index_trie
sil @test_empty_tuple : $@convention(thin) () -> () {
bb0:
  %e = tuple ()
  specify_test "field_index_trie %e"
  return %e : $()
}

// CHECK-LABEL: begin running test {{.*}} on test_empty_tuple_nested: field_index_trie
// CHECK: leafCount: 2
// CHECK: <root> -> 0..<2
// CHECK: 0 -> 0..<1
// CHECK: 1 -> 1..<2
// CHECK-LABEL: end running test {{.*}} on test_empty_tuple_nested: field_index_trie
sil @test_empty_tuple_nested : $@convention(thin) () -> () {
bb0:
  %e = tuple ()
  %nested = tuple (%e : $(), %e : $())
  specify_test "field_index_trie %nested"
  return %e : $()
}

// Class instances: one leaf per stored property, reached through class field projections.

class Base {
  var x: Builtin.Int64
  var y: Klass
  init()
}

class Derived : Base {
  var d: Klass
  var s: SPair
  override init()
}

class EmptyDerived : Klass {}

class Recursive {
  var next: Recursive
  var n: Builtin.Int64
  init()
}

class Generic<T> {
  var t: T
  var k: Klass
  init()
}

struct HoldsBase {
  var b: Base
  var k: Klass
}

// A struct holding a class with stored properties: the class reference is still a single leaf.
// CHECK-LABEL: begin running test {{.*}} on test_struct_of_class: field_index_trie
// CHECK: leafCount: 2
// CHECK: <root> -> 0..<2
// CHECK: s0 -> 0..<1
// CHECK: s1 -> 1..<2
// CHECK-LABEL: end running test {{.*}} on test_struct_of_class: field_index_trie
sil @test_struct_of_class : $@convention(thin) (@in_guaranteed HoldsBase) -> () {
bb0(%0 : $*HoldsBase):
  specify_test "field_index_trie %0"
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: begin running test {{.*}} on test_class_root: field_index_trie
// CHECK: leafCount: 2
// CHECK: <root> -> 0..<2
// CHECK: c0 -> 0..<1
// CHECK: c1 -> 1..<2
// CHECK: superclassLeaf: none
// CHECK: field 0 -> 0..<1
// CHECK: field 1 -> 1..<2
// CHECK-LABEL: end running test {{.*}} on test_class_root: field_index_trie
sil @test_class_root : $@convention(thin) (@guaranteed Base) -> () {
bb0(%0 : $Base):
  specify_test "field_index_trie %0 true"
  %r = tuple ()
  return %r : $()
}

// Without the class-instance mode, the same class is a single opaque leaf.
// CHECK-LABEL: begin running test {{.*}} on test_class_root_opaque: field_index_trie
// CHECK: leafCount: 1
// CHECK: <root> -> 0..<1
// CHECK-LABEL: end running test {{.*}} on test_class_root_opaque: field_index_trie
sil @test_class_root_opaque : $@convention(thin) (@guaranteed Base) -> () {
bb0(%0 : $Base):
  specify_test "field_index_trie %0"
  %r = tuple ()
  return %r : $()
}

// The inherited fields x and y have no leaves: their indices conservatively select the whole
// instance. The struct-typed field s is expanded, and the superclass leaf comes last.
// CHECK-LABEL: begin running test {{.*}} on test_class_derived: field_index_trie
// CHECK: leafCount: 4
// CHECK: <root> -> 0..<4
// CHECK: c2 -> 0..<1
// CHECK: c3 -> 1..<3
// CHECK: c3.s0 -> 1..<2
// CHECK: c3.s1 -> 2..<3
// CHECK: super -> 3..<4
// CHECK: superclassLeaf: 3
// CHECK: field 0 -> 0..<4
// CHECK: field 1 -> 0..<4
// CHECK: field 2 -> 0..<1
// CHECK: field 3 -> 1..<3
// CHECK-LABEL: end running test {{.*}} on test_class_derived: field_index_trie
sil @test_class_derived : $@convention(thin) (@guaranteed Derived) -> () {
bb0(%0 : $Derived):
  specify_test "field_index_trie %0 true"
  %r = tuple ()
  return %r : $()
}

// A superclass without stored properties still gets a leaf.
// CHECK-LABEL: begin running test {{.*}} on test_class_empty_derived: field_index_trie
// CHECK: leafCount: 1
// CHECK: <root> -> 0..<1
// CHECK: super -> 0..<1
// CHECK: superclassLeaf: 0
// CHECK-LABEL: end running test {{.*}} on test_class_empty_derived: field_index_trie
sil @test_class_empty_derived : $@convention(thin) (@guaranteed EmptyDerived) -> () {
bb0(%0 : $EmptyDerived):
  specify_test "field_index_trie %0 true"
  %r = tuple ()
  return %r : $()
}

// A root class without stored properties is a single leaf.
// CHECK-LABEL: begin running test {{.*}} on test_class_empty_root: field_index_trie
// CHECK: leafCount: 1
// CHECK-NEXT: nodes:
// CHECK-NEXT: <root> -> 0..<1
// CHECK-NEXT: }
// CHECK: superclassLeaf: none
// CHECK-LABEL: end running test {{.*}} on test_class_empty_root: field_index_trie
sil @test_class_empty_root : $@convention(thin) (@guaranteed Klass) -> () {
bb0(%0 : $Klass):
  specify_test "field_index_trie %0 true"
  %r = tuple ()
  return %r : $()
}

// A field referencing the class itself is an opaque leaf.
// CHECK-LABEL: begin running test {{.*}} on test_class_recursive: field_index_trie
// CHECK: leafCount: 2
// CHECK: <root> -> 0..<2
// CHECK: c0 -> 0..<1
// CHECK: c1 -> 1..<2
// CHECK-LABEL: end running test {{.*}} on test_class_recursive: field_index_trie
sil @test_class_recursive : $@convention(thin) (@guaranteed Recursive) -> () {
bb0(%0 : $Recursive):
  specify_test "field_index_trie %0 true"
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: begin running test {{.*}} on test_class_generic: field_index_trie
// CHECK: leafCount: 2
// CHECK: <root> -> 0..<2
// CHECK: c0 -> 0..<1
// CHECK: c1 -> 1..<2
// CHECK-LABEL: end running test {{.*}} on test_class_generic: field_index_trie
sil @test_class_generic : $@convention(thin) <T> (@guaranteed Generic<T>) -> () {
bb0(%0 : $Generic<T>):
  specify_test "field_index_trie %0 true"
  %r = tuple ()
  return %r : $()
}
