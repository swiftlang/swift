// CHECK-NEXT:    copy_addr [[ARG]] to [init] [[ROOT]] : $*C
// CHECK-NEXT:    copy_addr [take] [[ROOT]] to [init] [[OUT]] : $*C
// CHECK-NEXT:    dealloc_stack [[ROOT]]
// CHECK:       } // end sil function
sil [ossa] @cpa_last_use_becomes_take : $@convention(thin) (@in_guaranteed C) -> @out C {
bb0(%out : $*C, %arg : $*C):
  %0 = alloc_stack [lexical] [var_decl] $C, let, name "x"
  specify_test "lifetime_resolution_resolve %0"
  copy_addr %arg to [init] %0 : $*C
  copy_addr %0 to [init] %out : $*C
  destroy_addr %0 : $*C
  dealloc_stack %0 : $*C
  %t = tuple ()
  return %t
}

// CHECK-LABEL: sil [ossa] @cpa_interior_copy_stays_copy :
// CHECK:       bb0([[OUT:%.*]] : $*C, [[ARG:%.*]] : $*C):
// CHECK:         [[ROOT:%.*]] = alloc_stack [lexical] [var_decl] $C
// CHECK:         copy_addr [[ROOT]] to [init] [[OUT]] : $*C
// CHECK-NEXT:    [[TMP:%.*]] = alloc_stack $C
// CHECK-NEXT:    copy_addr [take] [[ROOT]] to [init] [[TMP]] : $*C
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function
sil [ossa] @cpa_interior_copy_stays_copy : $@convention(thin) (@in_guaranteed C) -> @out C {
bb0(%out : $*C, %arg : $*C):
  %0 = alloc_stack [lexical] [var_decl] $C, let, name "x"
  specify_test "lifetime_resolution_resolve %0"
  copy_addr %arg to [init] %0 : $*C
  copy_addr %0 to [init] %out : $*C
  %tmp = alloc_stack $C
  copy_addr %0 to [init] %tmp : $*C
  %f = function_ref @consumeC_addr : $@convention(thin) (@in C) -> ()
  apply %f(%tmp) : $@convention(thin) (@in C) -> ()
  dealloc_stack %tmp : $*C
  destroy_addr %0 : $*C
  dealloc_stack %0 : $*C
  %t = tuple ()
  return %t
}

