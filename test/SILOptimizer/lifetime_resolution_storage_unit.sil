// Initializing each field separately, one of them with a copy_addr, defines the whole.
// CHECK-LABEL: sil [ossa] @cpa_field_defs_then_whole :
// CHECK:       bb0([[OUT:%.*]] : $*Two, [[KA:%.*]] : $*K, {{%.*}} : @owned $K):
// CHECK:         [[ROOT:%.*]] = alloc_stack [lexical] [var_decl] $Two
// CHECK-NEXT:    [[AA:%.*]] = struct_element_addr [[ROOT]] : $*Two, #Two.a
// CHECK-NEXT:    copy_addr [[KA]] to [init] [[AA]] : $*K
// CHECK:         copy_addr [take] [[ROOT]] to [init] [[OUT]] : $*Two
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function
sil [ossa] @cpa_field_defs_then_whole : $@convention(thin) (@in_guaranteed K, @owned K) -> @out Two {
bb0(%out : $*Two, %ka : $*K, %kb : @owned $K):
  %0 = alloc_stack [lexical] [var_decl] $Two, var, name "t"
  specify_test "lifetime_resolution_resolve %0"
  %aa = struct_element_addr %0 : $*Two, #Two.a
  copy_addr %ka to [init] %aa : $*K
  %ab = struct_element_addr %0 : $*Two, #Two.b
  store %kb to [init] %ab : $*K
  copy_addr %0 to [init] %out : $*Two
  destroy_addr %0 : $*Two
  dealloc_stack %0 : $*Two
  %t = tuple ()
  return %t
}

// A copy_addr whose source and destination are both fields of the storage: `b` is
// consumed then reinitialized from `a`, which the whole-value copy_addr still demands.
// CHECK-LABEL: sil [ossa] @cpa_field_to_field_same_root :
// CHECK:       bb0([[OUT:%.*]] : $*Two, {{%.*}} : @owned $Two):
// CHECK:         [[ROOT:%.*]] = alloc_stack [lexical] [var_decl] $Two
// CHECK:         [[AB:%.*]] = struct_element_addr [[ROOT]] : $*Two, #Two.b
// CHECK-NEXT:    load [take] [[AB]] : $*K
// CHECK:         [[AA:%.*]] = struct_element_addr [[ROOT]] : $*Two, #Two.a
// CHECK-NEXT:    [[AB2:%.*]] = struct_element_addr [[ROOT]] : $*Two, #Two.b
// CHECK-NEXT:    copy_addr [[AA]] to [init] [[AB2]] : $*K
// CHECK-NEXT:    copy_addr [take] [[ROOT]] to [init] [[OUT]] : $*Two
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function
sil [ossa] @cpa_field_to_field_same_root : $@convention(thin) (@owned Two) -> @out Two {
bb0(%out : $*Two, %w : @owned $Two):
  %0 = alloc_stack [lexical] [var_decl] $Two, var, name "t"
  specify_test "lifetime_resolution_resolve %0"
  store %w to [init] %0 : $*Two

  %ab = struct_element_addr %0 : $*Two, #Two.b
  %lb = load [take] %ab : $*K
  %c = function_ref @consumeK : $@convention(thin) (@owned K) -> ()
  apply %c(%lb) : $@convention(thin) (@owned K) -> ()

  %aa = struct_element_addr %0 : $*Two, #Two.a
  %ab2 = struct_element_addr %0 : $*Two, #Two.b
  copy_addr %aa to [init] %ab2 : $*K

  copy_addr %0 to [init] %out : $*Two
  destroy_addr %0 : $*Two
  dealloc_stack %0 : $*Two
  %t = tuple ()
  return %t
}

// CHECK-LABEL: sil [ossa] @cpa_nc_last_use :
// CHECK:       bb0([[OUT:%.*]] : $*NC, {{%.*}} : @owned $NC):
// CHECK:         [[ROOT:%.*]] = alloc_stack [lexical] [var_decl] $NC
// CHECK:         copy_addr [take] [[ROOT]] to [init] [[OUT]] : $*NC
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function
sil [ossa] @cpa_nc_last_use : $@convention(thin) (@owned NC) -> @out NC {
bb0(%out : $*NC, %v : @owned $NC):
  %0 = alloc_stack [lexical] [var_decl] $NC, let, name "x"
  specify_test "lifetime_resolution_resolve %0"
  store %v to [init] %0 : $*NC
  copy_addr %0 to [init] %out : $*NC
  destroy_addr %0 : $*NC
  dealloc_stack %0 : $*NC
  %t = tuple ()
  return %t
}

// The box's own lifetime end conservatively demands its contents.
// CHECK-LABEL: sil [ossa] @cpa_box_copy_stays_copy :
// CHECK:       bb0([[OUT:%.*]] : $*C, {{%.*}} : $*C):
// CHECK:         [[PB:%.*]] = project_box {{%.*}} : ${ var C }, 0
// CHECK:         [[R:%.*]] = begin_access [read] [unknown] [[PB]] : $*C
// CHECK-NEXT:    copy_addr [[R]] to [init] [[OUT]] : $*C
// CHECK:       } // end sil function
sil [ossa] @cpa_box_copy_stays_copy : $@convention(thin) (@in_guaranteed C) -> @out C {
bb0(%out : $*C, %arg : $*C):
  %b = alloc_box ${ var C }, var, name "x"
  %bb = begin_borrow [lexical] [var_decl] %b : ${ var C }
  %pb = project_box %bb : ${ var C }, 0
  specify_test "lifetime_resolution_resolve %b"
  copy_addr %arg to [init] %pb : $*C
  %r = begin_access [read] [unknown] %pb : $*C
  copy_addr %r to [init] %out : $*C
  end_access %r : $*C
  end_borrow %bb : ${ var C }
  destroy_value %b : ${ var C }
  %t = tuple ()
  return %t
}

// `var a = ...; var b = a; return b`: resolving both `a` and `b` turns this into all takes.
// CHECK-LABEL: sil [ossa] @cpa_chain_two_roots :
// CHECK:         [[A:%.*]] = alloc_stack [lexical] [var_decl] $C, var, name "a"
// CHECK-NEXT:    [[B:%.*]] = alloc_stack [lexical] [var_decl] $C, var, name "b"
// CHECK:         [[RA:%.*]] = begin_access [read] [unknown] [[A]] : $*C
// CHECK-NEXT:    copy_addr [take] [[RA]] to [init] [[B]] : $*C
// CHECK:         [[RB:%.*]] = begin_access [read] [unknown] [[B]] : $*C
// CHECK-NEXT:    [[L:%.*]] = load [take] [[RB]] : $*C
// CHECK-NOT:     destroy_addr
// CHECK:         return [[L]]
// CHECK:       } // end sil function
sil [ossa] @cpa_chain_two_roots : $@convention(thin) (@owned C) -> @owned C {
bb0(%v : @owned $C):
  %0 = alloc_stack [lexical] [var_decl] $C, var, name "a"
  %1 = alloc_stack [lexical] [var_decl] $C, var, name "b"
  specify_test "lifetime_resolution_resolve %1"
  specify_test "lifetime_resolution_resolve %0"
  store %v to [init] %0 : $*C
  %r = begin_access [read] [unknown] %0 : $*C
  copy_addr %r to [init] %1 : $*C
  end_access %r : $*C
  %r2 = begin_access [read] [unknown] %1 : $*C
  %l = load [copy] %r2 : $*C
  end_access %r2 : $*C
  destroy_addr %1 : $*C
  dealloc_stack %1 : $*C
  destroy_addr %0 : $*C
  dealloc_stack %0 : $*C
  return %l
}
