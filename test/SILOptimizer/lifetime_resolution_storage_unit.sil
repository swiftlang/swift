// SILGen's shape for a generic argument `var x = t; consume(x); x = t; return x`.
// when not using opaque values.
//
// CHECK-LABEL: sil [ossa] @cpa_reassign_kills_demand :
// CHECK:       bb0([[OUT:%.*]] : $*C, [[ARG:%.*]] : $*C):
// CHECK:         [[ROOT:%.*]] = mark_uninitialized [var]
// CHECK-NEXT:    copy_addr [[ARG]] to [init] [[ROOT]] : $*C
// CHECK:         [[R1:%.*]] = begin_access [read] [unknown] [[ROOT]] : $*C
// CHECK-NEXT:    copy_addr [take] [[R1]] to [init] {{%.*}} : $*C
// CHECK:         [[M:%.*]] = begin_access [modify] [unknown] [[ROOT]] : $*C
// CHECK-NEXT:    copy_addr [take] {{%.*}} to [[M]] : $*C
// CHECK:         [[R2:%.*]] = begin_access [read] [unknown] [[ROOT]] : $*C
// CHECK-NEXT:    copy_addr [take] [[R2]] to [init] [[OUT]] : $*C
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function
sil [ossa] @cpa_reassign_kills_demand : $@convention(thin) (@in_guaranteed C) -> @out C {
bb0(%out : $*C, %arg : $*C):
  %0 = alloc_stack [lexical] [var_decl] $C, var, name "x"
  %mu = mark_uninitialized [var] %0 : $*C
  specify_test "lifetime_resolution_resolve %0"
  copy_addr %arg to [init] %mu : $*C

  %tmp = alloc_stack $C
  %r = begin_access [read] [unknown] %mu : $*C
  copy_addr %r to [init] %tmp : $*C
  end_access %r : $*C
  %f = function_ref @consumeC_addr : $@convention(thin) (@in C) -> ()
  apply %f(%tmp) : $@convention(thin) (@in C) -> ()
  dealloc_stack %tmp : $*C

  %tmp2 = alloc_stack $C
  copy_addr %arg to [init] %tmp2 : $*C
  %m = begin_access [modify] [unknown] %mu : $*C
  copy_addr [take] %tmp2 to %m : $*C
  end_access %m : $*C
  dealloc_stack %tmp2 : $*C

  %r2 = begin_access [read] [unknown] %mu : $*C
  copy_addr %r2 to [init] %out : $*C
  end_access %r2 : $*C
  destroy_addr %mu : $*C
  dealloc_stack %0 : $*C
  %t = tuple ()
  return %t
}

// Consumed on every path, so the destroy in the merge block is deleted.
// CHECK-LABEL: sil [ossa] @cpa_consume_both_branches :
// CHECK:         [[ROOT:%.*]] = alloc_stack [lexical] [var_decl] $C
// CHECK:       bb1:
// CHECK-NEXT:    copy_addr [take] [[ROOT]] to [init] {{%.*}} : $*C
// CHECK:       bb2:
// CHECK-NEXT:    copy_addr [take] [[ROOT]] to [init] {{%.*}} : $*C
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function
sil [ossa] @cpa_consume_both_branches : $@convention(thin) (@in_guaranteed C) -> () {
bb0(%arg : $*C):
  %0 = alloc_stack [lexical] [var_decl] $C, let, name "x"
  specify_test "lifetime_resolution_resolve %0"
  copy_addr %arg to [init] %0 : $*C
  %f = function_ref @consumeC_addr : $@convention(thin) (@in C) -> ()
  %tmp = alloc_stack $C
  cond_br undef, bb1, bb2

bb1:
  copy_addr %0 to [init] %tmp : $*C
  br bb3

bb2:
  copy_addr %0 to [init] %tmp : $*C
  br bb3

bb3:
  apply %f(%tmp) : $@convention(thin) (@in C) -> ()
  dealloc_stack %tmp : $*C
  destroy_addr %0 : $*C
  dealloc_stack %0 : $*C
  %t = tuple ()
  return %t
}

