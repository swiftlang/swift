// RUN: %target-sil-opt -sil-print-types -enable-experimental-feature OnceFunctions -enable-sil-verify-all -mandatory-inlining %s | %FileCheck %s

// REQUIRES: swift_feature_OnceFunctions

sil_stage raw

import Swift

sil [transparent] [ossa] @discard : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> () {
bb0(%0 : @owned $@once @callee_owned () -> ()):
  %1 = convert_function %0 : $@once @callee_owned () -> () to [without_actually_discarding] $@callable(once) @callee_owned () -> ()
  return %1 : $@callable(once) @callee_owned () -> ()
}

// Cloning an instruction while inlining keeps the attribute.
//
// CHECK-LABEL: sil [ossa] @test_inline :
// CHECK-NOT:     apply
// CHECK:         convert_function %0 : $@once @callee_owned () -> () to [without_actually_discarding] $@callable(once) @callee_owned () -> ()
// CHECK:       } // end sil function 'test_inline'
sil [ossa] @test_inline : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> () {
bb0(%0 : @owned $@once @callee_owned () -> ()):
  %1 = function_ref @discard : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> ()
  %2 = apply %1(%0) : $@convention(thin) (@owned @once @callee_owned () -> ()) -> @owned @callable(once) @callee_owned () -> ()
  return %2 : $@callable(once) @callee_owned () -> ()
}
