  (%1, %2) = begin_apply %0() : $@convention(thin) @yield_once () -> (@yields Int32)
  cond_br undef, bb1, bb2
bb1:
  end_apply %2 as $()
  br bb3
bb2:
  end_apply %2 as $()
  br bb3
bb3:
  return %1 : $Int32
}

