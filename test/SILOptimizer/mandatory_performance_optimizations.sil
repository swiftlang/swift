// Normal LoopUnroll only attempts to unroll the innermost loops in a nest, but
// PackLoopUnroll must unroll pack loops, even if they contain sub-loops. In
// this case, it also must not unroll the inner loop, which is not a pack loop.
//
// CHECK-LABEL: sil [no_locks] [perf_constraint] [ossa] @unroll_outer_pack_loop :
// CHECK:         apply {{%[0-9]+}}<B>()
// CHECK:       [[INNER1:bb[0-9]+]](
// CHECK:         cond_br
// CHECK:         br [[INNER1]](
// CHECK:         apply {{%[0-9]+}}<A>()
// CHECK:       [[INNER2:bb[0-9]+]](
// CHECK:         cond_br
// CHECK:         br [[INNER2]](
// CHECK-NOT:     apply
// CHECK-LABEL: } // end sil function 'unroll_outer_pack_loop'
sil [no_locks] [ossa] @unroll_outer_pack_loop : $@convention(thin) () -> () {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Word, 1
  %2 = integer_literal $Builtin.Word, 2
  %3 = integer_literal $Builtin.Int1, -1
  br bb1(%0)

bb1(%5 : $Builtin.Word):
  %6 = dynamic_pack_index %5 of $Pack{B, A, C}
  %ope = open_pack_element %6 of <each U> at <Pack{B, A, C}>, shape $each U, id 8
  %foo = function_ref @foo : $@convention(thin) <T> () -> ()
  apply %foo<@pack_element(8) each U>() : $@convention(thin) <T> () -> ()
  %7 = builtin "sadd_with_overflow_Word"(%5, %1, %3) : $(Builtin.Word, Builtin.Int1)
  %8 = tuple_extract %7, 0
  %9 = builtin "cmp_eq_Word"(%8, %2) : $Builtin.Int1
  br bb2(%0)

bb2(%11 : $Builtin.Word):
  %12 = builtin "sadd_with_overflow_Word"(%11, %1, %3) : $(Builtin.Word, Builtin.Int1)
  %13 = tuple_extract %12, 0
  %14 = builtin "cmp_eq_Word"(%13, %2) : $Builtin.Int1
  cond_br %14, bb4, bb3

bb3:
  br bb2(%13)

bb4:
  cond_br %9, bb6, bb5

bb5:
  br bb1(%8)

bb6:
  %19 = tuple ()
  return %19
}

