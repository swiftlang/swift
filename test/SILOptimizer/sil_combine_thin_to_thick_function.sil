sil @useOnce : $@convention(thin) (@owned @noescape @once @callee_owned (@guaranteed B) -> @owned A) -> ()

// The thickened function keeps the exactly-once or at-most-once semantics,
// because a conversion can't form a noncopyable function.
//
// COMBINE-LABEL:    sil [ossa] @thicken_exactly_once :
// COMBINE:            %[[#O0:]] = function_ref @$s2CS4implyAA1BCAA1ACF
// COMBINE:            %[[#O1:]] = thin_to_thick_function %[[#O0]] to $@noescape @once @callee_owned (@guaranteed A) -> @owned B
// COMBINE:            %[[#O2:]] = convert_function %[[#O1]] to $@noescape @once @callee_owned (@guaranteed B) -> @owned A
// COMBINE:            apply {{%.*}}(%[[#O2]])
// COMBINE:          } // end sil function 'thicken_exactly_once'
sil [ossa] @thicken_exactly_once : $@convention(thin) () -> () {
bb0:
  %0 = function_ref @$s2CS4implyAA1BCAA1ACF : $@convention(thin) (@guaranteed A) -> @owned B
  %1 = convert_function %0 to $@convention(thin) (@guaranteed B) -> @owned A
  %2 = thin_to_thick_function %1 to $@noescape @once @callee_owned (@guaranteed B) -> @owned A
  %3 = function_ref @useOnce : $@convention(thin) (@owned @noescape @once @callee_owned (@guaranteed B) -> @owned A) -> ()
  %4 = apply %3(%2) : $@convention(thin) (@owned @noescape @once @callee_owned (@guaranteed B) -> @owned A) -> ()
  %5 = tuple ()
  return %5
}

sil @useCallableOnce : $@convention(thin) (@owned @noescape @callable(once) @callee_owned (@guaranteed B) -> @owned A) -> ()

