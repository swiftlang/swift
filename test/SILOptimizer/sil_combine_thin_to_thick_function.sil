// This SIL is derived from the following Swift:
//
//   public class A {}
//   public class B: A {}
//
//   @inline(never)
//   public func impl(_ a: A) -> B { B() }
//
//   @inline(never)
//   public func use(_ f: (B) -> A, _ b: B) -> A { f(b) }
//
//   @inline(never)
//   public func test(_ b: B) -> (A, A) {
//     let first = use(impl, b)
//     let f = impl
//     return (first, use(f, b))
//   }
//
//   @inline(never)
//   public func escaping_result() -> (B) -> A {
//     let f: @convention(thin) (A) -> B = impl
//     return f
//   }

sil_stage canonical

import Builtin
import Swift
import SwiftShims

public class A {
  deinit
  init()
}

public class B : A {
  override init()
  deinit
}

sil [noinline] [ossa] @$s2CS4implyAA1BCAA1ACF : $@convention(thin) (@guaranteed A) -> @owned B {
bb0(%0 : @guaranteed $A):
  %1 = alloc_ref $B
  %2 = move_value [lexical] %1
  %3 = upcast %2 to $A
  %4 = move_value [lexical] %3
  %5 = end_init_let_ref %4
  %6 = unchecked_ref_cast %5 to $B
  %7 = move_value [lexical] %6
  return %7
}

