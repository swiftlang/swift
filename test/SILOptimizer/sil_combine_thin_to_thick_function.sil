// A thin function has no context to deinit, so the conversion without actually
// deiniting becomes an ordinary conversion of the thin function.
//
// COMBINE-LABEL:    sil [ossa] @noescape_without_actually_deiniting :
// COMBINE:            %[[#D0:]] = function_ref @$s2CS4implyAA1BCAA1ACF
// COMBINE:            %[[#D1:]] = thin_to_thick_function %[[#D0]] to $@noescape @callable(once) @callee_owned (@guaranteed A) -> @owned B
// COMBINE-NOT:        convert_function
// COMBINE:            apply {{%.*}}(%[[#D1]])
// COMBINE:          } // end sil function 'noescape_without_actually_deiniting'
sil [ossa] @noescape_without_actually_deiniting : $@convention(thin) () -> () {
bb0:
  %0 = function_ref @$s2CS4implyAA1BCAA1ACF : $@convention(thin) (@guaranteed A) -> @owned B
  %1 = thin_to_thick_function %0 to $@once @callee_owned (@guaranteed A) -> @owned B
  %2 = convert_function %1 to [without_actually_deiniting] $@callable(once) @callee_owned (@guaranteed A) -> @owned B
  %3 = convert_escape_to_noescape %2 to $@noescape @callable(once) @callee_owned (@guaranteed A) -> @owned B
  %4 = function_ref @useCallableOnceImpl : $@convention(thin) (@owned @noescape @callable(once) @callee_owned (@guaranteed A) -> @owned B) -> ()
  %5 = apply %4(%3) : $@convention(thin) (@owned @noescape @callable(once) @callee_owned (@guaranteed A) -> @owned B) -> ()
  %6 = tuple ()
  return %6
}

