// A borrow which is live-out of the loop needs a reborrow phi in the exit
// block. The pass must create the corresponding borrowed_from instruction.
// CHECK-LABEL: sil [ossa] @unroll_with_guaranteed_phi :
// CHECK:       bb{{[0-9]+}}([[OWNED:%.*]] : @owned $Klass, [[REBORROW:%.*]] : @reborrow $Klass):
// CHECK-NEXT:    borrowed [[REBORROW]] from ([[OWNED]])
// CHECK-LABEL: } // end sil function 'unroll_with_guaranteed_phi'
sil [ossa] @unroll_with_guaranteed_phi : $@convention(thin) (@guaranteed Array<Klass>) -> () {
bb0(%0 : @guaranteed $Array<Klass>):
  %1 = integer_literal $Builtin.Int1, -1
  %2 = struct $Bool (%1 : $Builtin.Int1)
  %3 = integer_literal $Builtin.Int64, 0
  %4 = integer_literal $Builtin.Int64, 2
  %5 = integer_literal $Builtin.Int64, 1
  %6 = function_ref @getElement : $@convention(method) (Int64, Bool, _DependenceToken, @guaranteed Array<Klass>) -> @owned Klass
  %7 = struct $_DependenceToken ()
  br bb1(%3 : $Builtin.Int64)

bb1(%9 : $Builtin.Int64):
  %10 = struct $Int64 (%9 : $Builtin.Int64)
  %11 = apply %6(%10, %2, %7, %0) : $@convention(method) (Int64, Bool, _DependenceToken, @guaranteed Array<Klass>) -> @owned Klass
  // The borrow is live out of the loop: it is ended in the exit block bb3.
  %12 = begin_borrow %11 : $Klass
  %13 = builtin "sadd_with_overflow_Int64"(%9 : $Builtin.Int64, %5 : $Builtin.Int64, %1 : $Builtin.Int1) : $(Builtin.Int64, Builtin.Int1)
  %14 = tuple_extract %13 : $(Builtin.Int64, Builtin.Int1), 0
  %15 = builtin "cmp_eq_Int64"(%14 : $Builtin.Int64, %4 : $Builtin.Int64) : $Builtin.Int1
  cond_br %15, bb3, bb2

bb2:
  end_borrow %12 : $Klass
  destroy_value %11 : $Klass
  br bb1(%14 : $Builtin.Int64)

bb3:
  end_borrow %12 : $Klass
  destroy_value %11 : $Klass
  %tup = tuple ()
  return %tup : $()
}

// Ensure we don't trigger presence of address phis verification
sil [ossa] @unroll_with_addr_proj1 : $@convention(thin) (@in_guaranteed WrapperStruct) -> () {
bb0(%0 : $*WrapperStruct):
  %1 = integer_literal $Builtin.Int64, 1
  %2 = integer_literal $Builtin.Int64, 4
  %3 = integer_literal $Builtin.Int1, -1
  br bb1(%1 : $Builtin.Int64, %2 : $Builtin.Int64)

bb1(%5 : $Builtin.Int64, %6 : $Builtin.Int64):
  %7 = builtin "sadd_with_overflow_Int64"(%5 : $Builtin.Int64, %1 : $Builtin.Int64, %3 : $Builtin.Int1) : $(Builtin.Int64, Builtin.Int1)
  %8 = tuple_extract %7 : $(Builtin.Int64, Builtin.Int1), 0
  %9 = builtin "smul_with_overflow_Int64"(%6 : $Builtin.Int64, %2 : $Builtin.Int64, %3 : $Builtin.Int1) : $(Builtin.Int64, Builtin.Int1)
  %10 = tuple_extract %9 : $(Builtin.Int64, Builtin.Int1), 0
  %11 = builtin "cmp_slt_Int64"(%8 : $Builtin.Int64, %2 : $Builtin.Int64) : $Builtin.Int1
  %12 = struct_element_addr %0 : $*WrapperStruct, #WrapperStruct.val
  cond_br %11, bb2, bb3

bb2:
  br bb1(%8 : $Builtin.Int64, %10 : $Builtin.Int64)

bb3:
  %15 = function_ref @use_inguaranteed : $@convention(thin) (@in_guaranteed Klass) -> ()
  %16 = apply %15(%12) : $@convention(thin) (@in_guaranteed Klass) -> ()
  %17 = tuple ()
  return %17 : $()
}

// Ensure we don't trigger presence of address phis verification
sil [ossa] @unroll_with_addr_proj2 : $@convention(thin) (@in_guaranteed WrapperStruct) -> () {
bb0(%0 : $*WrapperStruct):
  %1 = alloc_stack $WrapperStruct
  %2 = integer_literal $Builtin.Int64, 1
  %3 = integer_literal $Builtin.Int64, 4
  %4 = integer_literal $Builtin.Int1, -1
  %5 = load [copy] %0 : $*WrapperStruct
  store %5 to [init] %1 : $*WrapperStruct
  br bb1(%2 : $Builtin.Int64, %3 : $Builtin.Int64)

bb1(%8 : $Builtin.Int64, %9 : $Builtin.Int64):
  %10 = builtin "sadd_with_overflow_Int64"(%8 : $Builtin.Int64, %2 : $Builtin.Int64, %4 : $Builtin.Int1) : $(Builtin.Int64, Builtin.Int1)
  %11 = tuple_extract %10 : $(Builtin.Int64, Builtin.Int1), 0
  %12 = builtin "smul_with_overflow_Int64"(%9 : $Builtin.Int64, %3 : $Builtin.Int64, %4 : $Builtin.Int1) : $(Builtin.Int64, Builtin.Int1)
  %13 = tuple_extract %12 : $(Builtin.Int64, Builtin.Int1), 0
  %14 = builtin "cmp_slt_Int64"(%11 : $Builtin.Int64, %3 : $Builtin.Int64) : $Builtin.Int1
  %15 = function_ref @get_wrapper_struct : $@convention(thin) (@inout WrapperStruct) -> ()
  %16 = apply %15(%1) : $@convention(thin) (@inout WrapperStruct) -> ()
  %17 = struct_element_addr %1 : $*WrapperStruct, #WrapperStruct.val
  cond_br %14, bb2, bb3

bb2:
  br bb1(%11 : $Builtin.Int64, %13 : $Builtin.Int64)

bb3:
  %20 = function_ref @use_inguaranteed : $@convention(thin) (@in_guaranteed Klass) -> ()
  %21 = apply %20(%17) : $@convention(thin) (@in_guaranteed Klass) -> ()
  destroy_addr %1 : $*WrapperStruct
  dealloc_stack %1 : $*WrapperStruct
  %24 = tuple ()
  return %24 : $()
}

sil @pred : $@convention(thin) () -> Builtin.Int1
sil @work : $@convention(thin) (Builtin.Word) -> ()
sil @use_element : $@convention(thin) <T> (@in_guaranteed T) -> ()

// The exit condition in the header compares the induction variable before it
// is incremented, and the body has an early exit. The header executes four
// times and the body three times. The last iteration's header must exit
// unconditionally, and every iteration of the body must keep its early exit.
//
// CHECK-LABEL: sil [ossa] @unroll_header_exit_with_early_exit :
// CHECK:         [[P0:%.*]] = apply
// CHECK-NEXT:    cond_br [[P0]],
// CHECK:         builtin "cmp_eq_Word"
// CHECK-NEXT:    br bb
// CHECK:         [[P1:%.*]] = apply
// CHECK-NEXT:    cond_br [[P1]],
// CHECK:         [[P2:%.*]] = apply
// CHECK-NEXT:    cond_br [[P2]],
// CHECK-NOT:     apply
// CHECK-LABEL: } // end sil function 'unroll_header_exit_with_early_exit'
sil [ossa] @unroll_header_exit_with_early_exit : $@convention(thin) () -> Builtin.Int1 {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Word, 1
  %2 = integer_literal $Builtin.Word, 3
  %3 = function_ref @pred : $@convention(thin) () -> Builtin.Int1
  br bb1(%0 : $Builtin.Word)

bb1(%5 : $Builtin.Word):
  %6 = builtin "cmp_eq_Word"(%5 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %6, bb2, bb3

bb2:
  %8 = integer_literal $Builtin.Int1, -1
  br bb4(%8 : $Builtin.Int1)

bb3:
  %10 = apply %3() : $@convention(thin) () -> Builtin.Int1
  cond_br %10, bb5, bb6

bb4(%12 : $Builtin.Int1):
  return %12 : $Builtin.Int1

bb5:
  %14 = integer_literal $Builtin.Int1, 0
  br bb4(%14 : $Builtin.Int1)

bb6:
  %16 = builtin "add_Word"(%5 : $Builtin.Word, %1 : $Builtin.Word) : $Builtin.Word
  br bb1(%16 : $Builtin.Word)
}

// CHECK-LABEL: sil [ossa] @unroll_header_exit_on_false_with_early_exit :
// CHECK:         [[P0:%.*]] = apply
// CHECK-NEXT:    cond_br [[P0]],
// CHECK:         builtin "cmp_ne_Word"
// CHECK-NEXT:    br bb
// CHECK:         [[P1:%.*]] = apply
// CHECK-NEXT:    cond_br [[P1]],
// CHECK:         [[P2:%.*]] = apply
// CHECK-NEXT:    cond_br [[P2]],
// CHECK-NOT:     apply
// CHECK-LABEL: } // end sil function 'unroll_header_exit_on_false_with_early_exit'
sil [ossa] @unroll_header_exit_on_false_with_early_exit : $@convention(thin) () -> Builtin.Int1 {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Word, 1
  %2 = integer_literal $Builtin.Word, 3
  %3 = function_ref @pred : $@convention(thin) () -> Builtin.Int1
  br bb1(%0 : $Builtin.Word)

bb1(%5 : $Builtin.Word):
  %6 = builtin "cmp_ne_Word"(%5 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %6, bb3, bb2

bb2:
  %8 = integer_literal $Builtin.Int1, -1
  br bb4(%8 : $Builtin.Int1)

bb3:
  %10 = apply %3() : $@convention(thin) () -> Builtin.Int1
  cond_br %10, bb5, bb6

bb4(%12 : $Builtin.Int1):
  return %12 : $Builtin.Int1

bb5:
  %14 = integer_literal $Builtin.Int1, 0
  br bb4(%14 : $Builtin.Int1)

bb6:
  %16 = builtin "add_Word"(%5 : $Builtin.Word, %1 : $Builtin.Word) : $Builtin.Word
  br bb1(%16 : $Builtin.Word)
}

// The exit condition compares the induction variable before it is incremented,
// after the body. The body executes for 0, 1 and 2.
//
// CHECK-LABEL: sil [ossa] @unroll_pre_increment_exit_after_body :
// CHECK-COUNT-3: = apply
// CHECK-NOT:     apply
// CHECK-LABEL: } // end sil function 'unroll_pre_increment_exit_after_body'
sil [ossa] @unroll_pre_increment_exit_after_body : $@convention(thin) () -> () {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Word, 1
  %2 = integer_literal $Builtin.Word, 2
  %3 = function_ref @work : $@convention(thin) (Builtin.Word) -> ()
  br bb1(%0 : $Builtin.Word)

bb1(%5 : $Builtin.Word):
  %6 = apply %3(%5) : $@convention(thin) (Builtin.Word) -> ()
  br bb2

bb2:
  %8 = builtin "cmp_eq_Word"(%5 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %8, bb4, bb3

bb3:
  %10 = builtin "add_Word"(%5 : $Builtin.Word, %1 : $Builtin.Word) : $Builtin.Word
  br bb1(%10 : $Builtin.Word)

bb4:
  %12 = tuple ()
  return %12 : $()
}

// The exit comparing the induction variable with 5 is not checked on every
// iteration, so it does not bound the trip count.
//
// CHECK-LABEL: sil [ossa] @dont_unroll_conditional_counted_exit :
// CHECK:         apply
// CHECK-NOT:     apply
// CHECK-LABEL: } // end sil function 'dont_unroll_conditional_counted_exit'
sil [ossa] @dont_unroll_conditional_counted_exit : $@convention(thin) (Builtin.Word) -> Builtin.Int1 {
bb0(%0 : $Builtin.Word):
  %1 = integer_literal $Builtin.Word, 0
  %2 = integer_literal $Builtin.Word, 1
  %3 = integer_literal $Builtin.Word, 5
  %4 = function_ref @pred : $@convention(thin) () -> Builtin.Int1
  br bb1(%1 : $Builtin.Word)

bb1(%6 : $Builtin.Word):
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %0 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb7, bb2

bb2:
  %9 = apply %4() : $@convention(thin) () -> Builtin.Int1
  cond_br %9, bb3, bb5

bb3:
  %11 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %3 : $Builtin.Word) : $Builtin.Int1
  cond_br %11, bb8, bb4

bb4:
  br bb6

bb5:
  br bb6

bb6:
  %16 = builtin "add_Word"(%6 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Word
  br bb1(%16 : $Builtin.Word)

bb7:
  %18 = integer_literal $Builtin.Int1, -1
  br bb9(%18 : $Builtin.Int1)

bb8:
  %20 = integer_literal $Builtin.Int1, 0
  br bb9(%20 : $Builtin.Int1)

bb9(%22 : $Builtin.Int1):
  return %22 : $Builtin.Int1
}

// Loops over the elements of a pack are unrolled even if they exceed the cost
// threshold, like dont_unroll_loop_exceeding_cost_threshold does.
//
// CHECK-LABEL: sil [ossa] @unroll_pack_loop_exceeding_cost_threshold :
// CHECK-COUNT-3: dynamic_pack_index
// CHECK-NOT:     dynamic_pack_index
// CHECK-LABEL: } // end sil function 'unroll_pack_loop_exceeding_cost_threshold'
sil [ossa] @unroll_pack_loop_exceeding_cost_threshold : $@convention(thin) (@pack_guaranteed Pack{Int, Int64, Bool}) -> () {
bb0(%0 : $*Pack{Int, Int64, Bool}):
  %1 = integer_literal $Builtin.Word, 0
  %2 = integer_literal $Builtin.Word, 1
  %3 = integer_literal $Builtin.Word, 3
  %4 = function_ref @use_element : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %5 = function_ref @big_func : $@convention(thin) () -> Builtin.Int64
  br bb1(%1 : $Builtin.Word)

bb1(%7 : $Builtin.Word):
  %8 = dynamic_pack_index %7 of $Pack{Int, Int64, Bool}
  %9 = open_pack_element %8 of <each T> at <Pack{Int, Int64, Bool}>, shape $each T, id 1
  %10 = pack_element_get %8 of %0 : $*Pack{Int, Int64, Bool} as $*@pack_element(1) each T
  %11 = apply %4<@pack_element(1) each T>(%10) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %12 = apply %5() : $@convention(thin) () -> Builtin.Int64
  %13 = apply %5() : $@convention(thin) () -> Builtin.Int64
  %14 = apply %5() : $@convention(thin) () -> Builtin.Int64
  %15 = apply %5() : $@convention(thin) () -> Builtin.Int64
  %16 = builtin "add_Word"(%7 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Word
  %17 = builtin "cmp_eq_Word"(%16 : $Builtin.Word, %3 : $Builtin.Word) : $Builtin.Int1
  cond_br %17, bb3, bb2

bb2:
  br bb1(%16 : $Builtin.Word)

bb3:
  %20 = tuple ()
  return %20 : $()
}

// CHECK-LABEL: sil [ossa] @dont_unroll_loop_exceeding_cost_threshold :
// CHECK:         builtin "add_Word"
// CHECK-NOT:     builtin "add_Word"
// CHECK-LABEL: } // end sil function 'dont_unroll_loop_exceeding_cost_threshold'
sil [ossa] @dont_unroll_loop_exceeding_cost_threshold : $@convention(thin) () -> () {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Word, 1
  %2 = integer_literal $Builtin.Word, 3
  %3 = function_ref @work : $@convention(thin) (Builtin.Word) -> ()
  %4 = function_ref @big_func : $@convention(thin) () -> Builtin.Int64
  br bb1(%0 : $Builtin.Word)

bb1(%6 : $Builtin.Word):
  %7 = apply %3(%6) : $@convention(thin) (Builtin.Word) -> ()
  %8 = apply %4() : $@convention(thin) () -> Builtin.Int64
  %9 = apply %4() : $@convention(thin) () -> Builtin.Int64
  %10 = apply %4() : $@convention(thin) () -> Builtin.Int64
  %11 = apply %4() : $@convention(thin) () -> Builtin.Int64
  %12 = builtin "add_Word"(%6 : $Builtin.Word, %1 : $Builtin.Word) : $Builtin.Word
  %13 = builtin "cmp_eq_Word"(%12 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %13, bb3, bb2

bb2:
  br bb1(%12 : $Builtin.Word)

bb3:
  %16 = tuple ()
  return %16 : $()
}

sil @use_int_addr : $@convention(thin) (@in_guaranteed Int) -> ()
sil @pred_element : $@convention(thin) <T> (@in_guaranteed T) -> Builtin.Int1

// CHECK-LABEL: sil [ossa] @unroll_alloc_stack_deallocated_in_other_block :
