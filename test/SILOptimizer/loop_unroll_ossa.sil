  %2 = struct $Bool (%1 : $Builtin.Int1)
  %3 = integer_literal $Builtin.Int64, 0
  %4 = integer_literal $Builtin.Int64, 4
  %5 = integer_literal $Builtin.Int1, -1
  %6 = integer_literal $Builtin.Int64, 1
