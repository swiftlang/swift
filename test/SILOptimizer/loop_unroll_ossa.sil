  %21 = tuple_extract %20 : $(Builtin.Int64, Builtin.Int1), 0
  %22 = apply %7(%19, %2, %15, %0) : $@convention(method) (Int64, Bool, _DependenceToken, @guaranteed Array<Klass>) -> @owned Klass
  %copy = copy_value %22 : $Klass
