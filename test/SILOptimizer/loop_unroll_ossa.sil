bb0:
 %0 = integer_literal $Builtin.Word, 0
 %1 = integer_literal $Builtin.Word, 1
 %2 = integer_literal $Builtin.Word, 2
 %3 = integer_literal $Builtin.Int1, 1
 br bb1(%2 : $Builtin.Word)

bb1(%4 : $Builtin.Word):
  %5 = builtin "usub_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %6 = tuple_extract %5 : $(Builtin.Word, Builtin.Int1), 0
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %0 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb3, bb2

bb2:
  br bb1(%6 : $Builtin.Word)

bb3:
 %9 = tuple()
 return %9 : $()
}

// CHECK-LABEL: sil [ossa] @loop_unroll_sub_no_overflow_1 :
