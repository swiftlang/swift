// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all -enable-experimental-feature OnceFunctions -closure-lifetime-fixup %s | %FileCheck %s

// REQUIRES: swift_feature_OnceFunctions

sil_stage raw

import Swift
import Builtin

struct NoncopyableValue<T>: ~Copyable {
  var t: T
}

struct CopyableValue<T> {
  var t: T
}

sil [ossa] @noncopyable_closure : $@convention(thin) <T> (@in NoncopyableValue<T>) -> ()
sil [ossa] @copyable_closure : $@convention(thin) <T> (@in CopyableValue<T>) -> ()
sil [ossa] @use_called_exactly_once : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()

// The on-stack context of an exactly-once closure owns the
// noncopyable address-only value that the closure consumes, so there is
// nothing left for the caller to destroy once the closure's lifetime ends.
//
// CHECK-LABEL: sil [ossa] @test_noncopyable_capture :
// CHECK:         [[TEMP:%.*]] = alloc_stack $NoncopyableValue<T>
// CHECK:         copy_addr [take] %0 to [init] [[TEMP]]
// CHECK:         [[CLOSURE:%.*]] = partial_apply [on_stack] [called_once] {{%.*}}<T>([[TEMP]])
// CHECK:         [[DEP:%.*]] = mark_dependence [nonescaping] [[CLOSURE]] {{.*}} on [[TEMP]]
// CHECK:         apply {{%.*}}([[DEP]])
// CHECK-NOT:     destroy_addr
// CHECK-NEXT:    dealloc_stack [[TEMP]]
// CHECK:       } // end sil function 'test_noncopyable_capture'
sil [ossa] @test_noncopyable_capture : $@convention(thin) <T> (@in NoncopyableValue<T>) -> () {
bb0(%0 : $*NoncopyableValue<T>):
  %1 = function_ref @noncopyable_closure : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>) -> ()
  %2 = alloc_stack $NoncopyableValue<T>
  copy_addr [take] %0 to [init] %2
  %4 = partial_apply [called_once] %1<T>(%2) : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>) -> ()
  %5 = convert_escape_to_noescape %4 to $@noescape @once @callee_owned () -> ()
  %6 = function_ref @use_called_exactly_once : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  %7 = apply %6(%5) : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  dealloc_stack %2
  %9 = tuple ()
  return %9
}

// A copyable value is not owned by the context: the closure's forwarder copies
// it, so the caller still destroys it after the closure's lifetime ends.
//
// CHECK-LABEL: sil [ossa] @test_copyable_capture :
// CHECK:         [[TEMP:%.*]] = alloc_stack $CopyableValue<T>
// CHECK:         copy_addr [take] %0 to [init] [[TEMP]]
// CHECK:         [[CLOSURE:%.*]] = partial_apply [on_stack] [called_once] {{%.*}}<T>([[TEMP]])
// CHECK:         [[DEP:%.*]] = mark_dependence [nonescaping] [[CLOSURE]] {{.*}} on [[TEMP]]
// CHECK:         apply {{%.*}}([[DEP]])
// CHECK-NEXT:    destroy_addr [[TEMP]]
// CHECK-NEXT:    dealloc_stack [[TEMP]]
// CHECK:       } // end sil function 'test_copyable_capture'
sil [ossa] @test_copyable_capture : $@convention(thin) <T> (@in CopyableValue<T>) -> () {
bb0(%0 : $*CopyableValue<T>):
  %1 = function_ref @copyable_closure : $@convention(thin) <τ_0_0> (@in CopyableValue<τ_0_0>) -> ()
  %2 = alloc_stack $CopyableValue<T>
  copy_addr [take] %0 to [init] %2
  %4 = partial_apply [called_once] %1<T>(%2) : $@convention(thin) <τ_0_0> (@in CopyableValue<τ_0_0>) -> ()
  %5 = convert_escape_to_noescape %4 to $@noescape @once @callee_owned () -> ()
  %6 = function_ref @use_called_exactly_once : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  %7 = apply %6(%5) : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  dealloc_stack %2
  %9 = tuple ()
  return %9
}

sil [ossa] @noncopyable_consuming_and_inout_closure : $@convention(thin) <T> (@in NoncopyableValue<T>, @inout_aliasable NoncopyableValue<T>) -> ()

// The context owns the consumed value, and the caller owns the value that is
// captured inout, so the caller destroys neither.
//
// CHECK-LABEL: sil [ossa] @test_noncopyable_consuming_and_inout_captures :
// CHECK:         [[TEMP:%.*]] = alloc_stack $NoncopyableValue<T>
// CHECK:         copy_addr [take] %0 to [init] [[TEMP]]
// CHECK:         [[CLOSURE:%.*]] = partial_apply [on_stack] [called_once] {{%.*}}<T>([[TEMP]], %1)
// CHECK:         [[DEP1:%.*]] = mark_dependence [nonescaping] [[CLOSURE]] {{.*}} on [[TEMP]]
// CHECK:         [[DEP2:%.*]] = mark_dependence [nonescaping] [[DEP1]] {{.*}} on %1
// CHECK:         apply {{%.*}}([[DEP2]])
// CHECK-NOT:     destroy_addr
// CHECK-NEXT:    dealloc_stack [[TEMP]]
// CHECK:       } // end sil function 'test_noncopyable_consuming_and_inout_captures'
sil [ossa] @test_noncopyable_consuming_and_inout_captures : $@convention(thin) <T> (@in NoncopyableValue<T>, @inout NoncopyableValue<T>) -> () {
bb0(%0 : $*NoncopyableValue<T>, %1 : $*NoncopyableValue<T>):
  %2 = function_ref @noncopyable_consuming_and_inout_closure : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>, @inout_aliasable NoncopyableValue<τ_0_0>) -> ()
  %3 = alloc_stack $NoncopyableValue<T>
  copy_addr [take] %0 to [init] %3
  %5 = partial_apply [called_once] %2<T>(%3, %1) : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>, @inout_aliasable NoncopyableValue<τ_0_0>) -> ()
  %6 = convert_escape_to_noescape %5 to $@noescape @once @callee_owned () -> ()
  %7 = function_ref @use_called_exactly_once : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  %8 = apply %7(%6) : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  dealloc_stack %3
  %10 = tuple ()
  return %10
}

sil [ossa] @borrowing_closure : $@convention(thin) <T> (@in_guaranteed CopyableValue<T>) -> ()

// The closure borrows a copy of a value that is destroyed before the closure
// is called, so it has to keep borrowing the copy.
//
// CHECK-LABEL: sil [ossa] @test_original_destroyed_during_closure_lifetime :
// CHECK:         [[ORIG:%.*]] = alloc_stack $CopyableValue<T>
// CHECK:         [[COPY:%.*]] = alloc_stack $CopyableValue<T>
// CHECK:         copy_addr [[ORIG]] to [init] [[COPY]]
// CHECK:         [[CLOSURE:%.*]] = partial_apply [on_stack] [called_once] {{%.*}}<T>([[COPY]])
// CHECK:         destroy_addr [[ORIG]]
// CHECK:         apply
// CHECK:         destroy_addr [[COPY]]
// CHECK:       } // end sil function 'test_original_destroyed_during_closure_lifetime'
sil [ossa] @test_original_destroyed_during_closure_lifetime : $@convention(thin) <T> (@in CopyableValue<T>) -> () {
bb0(%0 : $*CopyableValue<T>):
  %1 = alloc_stack $CopyableValue<T>
  copy_addr [take] %0 to [init] %1
  %3 = function_ref @borrowing_closure : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %4 = alloc_stack $CopyableValue<T>
  copy_addr %1 to [init] %4
  %6 = partial_apply [called_once] %3<T>(%4) : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %7 = convert_escape_to_noescape %6 to $@noescape @once @callee_owned () -> ()
  dealloc_stack %4
  destroy_addr %1
  dealloc_stack %1
  %11 = function_ref @use_called_exactly_once : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  %12 = apply %11(%7) : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  %13 = tuple ()
  return %13
}

// The value outlives the closure, so the closure can borrow it directly.
//
// CHECK-LABEL: sil [ossa] @test_original_destroyed_after_closure_lifetime :
// CHECK:         [[ORIG:%.*]] = alloc_stack $CopyableValue<T>
// CHECK-NOT:     alloc_stack
// CHECK:         [[CLOSURE:%.*]] = partial_apply [on_stack] [called_once] {{%.*}}<T>([[ORIG]])
// CHECK:         apply
// CHECK:         destroy_addr [[ORIG]]
// CHECK:       } // end sil function 'test_original_destroyed_after_closure_lifetime'
sil [ossa] @test_original_destroyed_after_closure_lifetime : $@convention(thin) <T> (@in CopyableValue<T>) -> () {
bb0(%0 : $*CopyableValue<T>):
  %1 = alloc_stack $CopyableValue<T>
  copy_addr [take] %0 to [init] %1
  %3 = function_ref @borrowing_closure : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %4 = alloc_stack $CopyableValue<T>
  copy_addr %1 to [init] %4
  %6 = partial_apply [called_once] %3<T>(%4) : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %7 = convert_escape_to_noescape %6 to $@noescape @once @callee_owned () -> ()
  dealloc_stack %4
  %9 = function_ref @use_called_exactly_once : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  %10 = apply %9(%7) : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  destroy_addr %1
  dealloc_stack %1
  %13 = tuple ()
  return %13
}

sil [ossa] @use_called_exactly_once_and_inout : $@convention(thin) <T> (@owned @noescape @once @callee_owned () -> (), @inout CopyableValue<T>) -> ()
sil [ossa] @read_value : $@convention(thin) <T> (@in_guaranteed CopyableValue<T>) -> ()

// The apply that ends the closure's lifetime also modifies the value.
//
// CHECK-LABEL: sil [ossa] @test_original_modified_by_closure_lifetime_end :
// CHECK:         [[ORIG:%.*]] = alloc_stack $CopyableValue<T>
// CHECK:         [[COPY:%.*]] = alloc_stack $CopyableValue<T>
// CHECK:         copy_addr [[ORIG]] to [init] [[COPY]]
// CHECK:         partial_apply [on_stack] [called_once] {{%.*}}<T>([[COPY]])
// CHECK:       } // end sil function 'test_original_modified_by_closure_lifetime_end'
sil [ossa] @test_original_modified_by_closure_lifetime_end : $@convention(thin) <T> (@in CopyableValue<T>) -> () {
bb0(%0 : $*CopyableValue<T>):
  %1 = alloc_stack $CopyableValue<T>
  copy_addr [take] %0 to [init] %1
  %3 = function_ref @borrowing_closure : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %4 = alloc_stack $CopyableValue<T>
  copy_addr %1 to [init] %4
  %6 = partial_apply [called_once] %3<T>(%4) : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %7 = convert_escape_to_noescape %6 to $@noescape @once @callee_owned () -> ()
  dealloc_stack %4
  %9 = function_ref @use_called_exactly_once_and_inout : $@convention(thin) <τ_0_0> (@owned @noescape @once @callee_owned () -> (), @inout CopyableValue<τ_0_0>) -> ()
  %10 = apply %9<T>(%7, %1) : $@convention(thin) <τ_0_0> (@owned @noescape @once @callee_owned () -> (), @inout CopyableValue<τ_0_0>) -> ()
  destroy_addr %1
  dealloc_stack %1
  %13 = tuple ()
  return %13
}

// An escaping closure takes the value while the closure is alive.
//
// CHECK-LABEL: sil [ossa] @test_original_taken_by_escaping_closure :
// CHECK:         [[ORIG:%.*]] = alloc_stack $CopyableValue<T>
// CHECK:         [[COPY:%.*]] = alloc_stack $CopyableValue<T>
// CHECK:         copy_addr [[ORIG]] to [init] [[COPY]]
// CHECK:         partial_apply [on_stack] [called_once] {{%.*}}<T>([[COPY]])
// CHECK:       } // end sil function 'test_original_taken_by_escaping_closure'
sil [ossa] @test_original_taken_by_escaping_closure : $@convention(thin) <T> (@in CopyableValue<T>) -> () {
bb0(%0 : $*CopyableValue<T>):
  %1 = alloc_stack $CopyableValue<T>
  copy_addr [take] %0 to [init] %1
  %3 = function_ref @borrowing_closure : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %4 = alloc_stack $CopyableValue<T>
  copy_addr %1 to [init] %4
  %6 = partial_apply [called_once] %3<T>(%4) : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %7 = convert_escape_to_noescape %6 to $@noescape @once @callee_owned () -> ()
  dealloc_stack %4
  %9 = partial_apply [callee_guaranteed] %3<T>(%1) : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  destroy_value %9
  %11 = function_ref @use_called_exactly_once : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  %12 = apply %11(%7) : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  dealloc_stack %1
  %14 = tuple ()
  return %14
}

// Reading the value while the closure is alive doesn't modify it, so the
// closure can borrow it directly.
//
// CHECK-LABEL: sil [ossa] @test_original_read_during_closure_lifetime :
// CHECK:         [[ORIG:%.*]] = alloc_stack $CopyableValue<T>
// CHECK-NOT:     alloc_stack
// CHECK:         partial_apply [on_stack] [called_once] {{%.*}}<T>([[ORIG]])
// CHECK:       } // end sil function 'test_original_read_during_closure_lifetime'
sil [ossa] @test_original_read_during_closure_lifetime : $@convention(thin) <T> (@in CopyableValue<T>) -> () {
bb0(%0 : $*CopyableValue<T>):
  %1 = alloc_stack $CopyableValue<T>
  copy_addr [take] %0 to [init] %1
  %3 = function_ref @borrowing_closure : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %4 = alloc_stack $CopyableValue<T>
  copy_addr %1 to [init] %4
  %6 = partial_apply [called_once] %3<T>(%4) : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %7 = convert_escape_to_noescape %6 to $@noescape @once @callee_owned () -> ()
  dealloc_stack %4
  %9 = function_ref @read_value : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %10 = apply %9<T>(%1) : $@convention(thin) <τ_0_0> (@in_guaranteed CopyableValue<τ_0_0>) -> ()
  %11 = function_ref @use_called_exactly_once : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  %12 = apply %11(%7) : $@convention(thin) (@owned @noescape @once @callee_owned () -> ()) -> ()
  destroy_addr %1
  dealloc_stack %1
  %15 = tuple ()
  return %15
}
