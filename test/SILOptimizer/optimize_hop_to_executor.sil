}

// CHECK-LABEL: sil [ossa] @simpleNonisolatedNonsendingStopsDCE : $@convention(thin) @async (@guaranteed MyActor) -> () {
// CHECK: hop_to_executor
// CHECK: } // end sil function 'simpleNonisolatedNonsendingStopsDCE'
sil [ossa] @simpleNonisolatedNonsendingStopsDCE : $@convention(thin) @async (@guaranteed MyActor) -> () {
bb0(%0 : @guaranteed $MyActor):
  hop_to_executor %0
  %1 = unchecked_value_cast %0 to $Builtin.ImplicitActor
  %f = function_ref @nonisolatedNonsendingAsyncFunction : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  apply %f(%1) : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  %9999 = tuple ()
  return %9999 : $()
}

// CHECK-LABEL: sil [ossa] @nonisolatedNonsendingParameterStopsDCE : $@convention(thin) @async (@guaranteed MyActor, @guaranteed @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()) -> () {
// CHECK: hop_to_executor
// CHECK: } // end sil function 'nonisolatedNonsendingParameterStopsDCE'
sil [ossa] @nonisolatedNonsendingParameterStopsDCE : $@convention(thin) @async (@guaranteed MyActor, @guaranteed @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()) -> () {
bb0(%0 : @guaranteed $MyActor, %1 : @guaranteed $@caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()):
  hop_to_executor %0
  %2 = unchecked_value_cast %0 to $Builtin.ImplicitActor
  apply %1(%2) : $@caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  %9999 = tuple ()
  return %9999 : $()
}

// We should eliminate none of the hop_to_executor here since
// nonisolated(nonsending) @async apply sites do not cross isolation
// boundaries.
//
// CHECK-LABEL: sil [ossa] @simpleNonisolatedNonsendingStopsDCE2 : $@convention(thin) @async (@guaranteed MyActor, @guaranteed MyActor, @guaranteed MyActor) -> () {
// CHECK: hop_to_executor
// CHECK: hop_to_executor
// CHECK: hop_to_executor
// CHECK: } // end sil function 'simpleNonisolatedNonsendingStopsDCE2'
sil [ossa] @simpleNonisolatedNonsendingStopsDCE2 : $@convention(thin) @async (@guaranteed MyActor, @guaranteed MyActor, @guaranteed MyActor) -> () {
bb0(%0 : @guaranteed $MyActor, %1 : @guaranteed $MyActor, %2 : @guaranteed $MyActor):
  hop_to_executor %0
  %actor0 = unchecked_value_cast %0 to $Builtin.ImplicitActor
  %f = function_ref @nonisolatedNonsendingAsyncFunction : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  apply %f(%actor0) : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  hop_to_executor %1
  %actor1 = unchecked_value_cast %1 to $Builtin.ImplicitActor
  %f2 = function_ref @syncFunction : $@convention(thin) () -> ()
  apply %f2() : $@convention(thin) () -> ()
  apply %f(%actor1) : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  hop_to_executor %2
  %actor2 = unchecked_value_cast %2 to $Builtin.ImplicitActor
  apply %f2() : $@convention(thin) () -> () 
  apply %f(%actor2) : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  %9999 = tuple ()
  return %9999 : $()
}

// CHECK-LABEL: sil [ossa] @simpleWithoutCallerIsolationInheritingHaveDCE : $@convention(thin) @async (@guaranteed MyActor, @guaranteed MyActor, @guaranteed MyActor) -> () {
// CHECK: bb0([[ARG1:%.*]] : @guaranteed $MyActor, [[ARG2:%.*]] : @guaranteed $MyActor, [[ARG3:%.*]] : @guaranteed $MyActor):
// CHECK-NEXT:  // function_ref anotherAsyncFunction
// CHECK-NEXT:  [[FUNC:%.*]] = function_ref @anotherAsyncFunction : $@convention(thin) @async () -> ()
// CHECK-NEXT:  apply [[FUNC]]() : $@convention(thin) @async () -> ()
// CHECK-NEXT:  hop_to_executor [[ARG2]]
// CHECK-NEXT:  // function_ref syncFunction
// CHECK-NEXT:  [[FUNC2:%.*]] = function_ref @syncFunction : $@convention(thin) () -> ()
// CHECK-NEXT:  apply [[FUNC2]]() : $@convention(thin) () -> ()
// CHECK-NEXT:  apply [[FUNC]]() : $@convention(thin) @async () -> ()
// CHECK-NEXT:  hop_to_executor [[ARG3]]
// CHECK-NEXT:  apply [[FUNC2]]() : $@convention(thin) () -> () 
// CHECK-NEXT:  apply [[FUNC]]() : $@convention(thin) @async () -> ()
// CHECK-NEXT:  apply [[FUNC]]() : $@convention(thin) @async () -> ()
// CHECK: } // end sil function 'simpleWithoutCallerIsolationInheritingHaveDCE'
sil [ossa] @simpleWithoutCallerIsolationInheritingHaveDCE : $@convention(thin) @async (@guaranteed MyActor, @guaranteed MyActor, @guaranteed MyActor) -> () {
bb0(%0 : @guaranteed $MyActor, %1 : @guaranteed $MyActor, %2 : @guaranteed $MyActor):
  hop_to_executor %0
  %f = function_ref @anotherAsyncFunction : $@convention(thin) @async () -> ()
  apply %f() : $@convention(thin) @async () -> ()
  hop_to_executor %1
  %f2 = function_ref @syncFunction : $@convention(thin) () -> ()
  apply %f2() : $@convention(thin) () -> ()
  apply %f() : $@convention(thin) @async () -> ()
  hop_to_executor %2
  apply %f2() : $@convention(thin) () -> ()
  apply %f() : $@convention(thin) @async () -> ()
  hop_to_executor %2
  apply %f() : $@convention(thin) @async () -> ()
  %9999 = tuple ()
  return %9999 : $()
}

// We do not allow for these to be propagated yet through caller isolation
// inheriting, so we should have all of the hop_to_executor.
//
// CHECK-LABEL: sil [ossa] @nonisolatedNonsendingStopsAllowsPropagating : $@convention(thin) @async (@guaranteed MyActor, @guaranteed MyActor, @guaranteed MyActor) -> () {
// CHECK: bb0(
// CHECK: hop_to_executor
// CHECK-NOT: hop_to_executor
// CHECK: } // end sil function 'nonisolatedNonsendingStopsAllowsPropagating'
sil [ossa] @nonisolatedNonsendingStopsAllowsPropagating : $@convention(thin) @async (@guaranteed MyActor, @guaranteed MyActor, @guaranteed MyActor) -> () {
bb0(%0 : @guaranteed $MyActor, %1 : @guaranteed $MyActor, %2 : @guaranteed $MyActor):
  hop_to_executor %0
  %actor0 = unchecked_value_cast %0 to $Builtin.ImplicitActor
  %f = function_ref @nonisolatedNonsendingAsyncFunction : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  apply %f(%actor0) : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  hop_to_executor %0
  %f2 = function_ref @syncFunction : $@convention(thin) () -> ()
  apply %f2() : $@convention(thin) () -> ()
  apply %f(%actor0) : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  hop_to_executor %0
  apply %f2() : $@convention(thin) () -> () 
  apply %f(%actor0) : $@convention(thin) @caller_isolated @async (@sil_isolated @sil_implicit_leading_param @guaranteed Builtin.ImplicitActor) -> ()
  %9999 = tuple ()
  return %9999 : $()
}

// Since we are caller isolation inheriting, make sure that we leave around the
// hop_to_executor due to ehre elase. We do eliminate one of the hop_to_executor
// though.
//
// CHECK: sil [isolation "nonisolated(nonsending)"] [ossa] @nonisolatedNonsendingStopsReturnDeadEnd : $@convention(thin) @async (@sil_isolated @guaranteed MyActor) -> () {
// CHECK: bb0(
// CHECK-NEXT: tuple
// CHECK-NEXT: return
// CHECK: } // end sil function 'nonisolatedNonsendingStopsReturnDeadEnd'
sil [isolation "nonisolated(nonsending)"] [ossa] @nonisolatedNonsendingStopsReturnDeadEnd : $@convention(thin) @async (@sil_isolated @guaranteed MyActor) -> () {
bb0(%0 : @guaranteed $MyActor):
  hop_to_executor %0
  hop_to_executor %0
  %9999 = tuple ()
  return %9999 : $()
}

