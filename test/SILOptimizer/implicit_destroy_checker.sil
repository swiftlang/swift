// RUN: %target-sil-opt -implicit-destroy-checker -enable-experimental-feature NondeinitableTypes -enable-sil-verify-all %s -verify

// REQUIRES: swift_feature_NondeinitableTypes

// Instructions that the implicit destroy checker has to handle even though the
// move-only checker doesn't produce them from Swift code today.

sil_stage raw

import Swift
import Builtin

struct ND: ~Copyable, ~Deinitable {
  var x: Int
}

struct Holder: ~Copyable, ~Deinitable {
  var nd: ND
}

struct StringHolder: ~Copyable, ~Deinitable {
  var s: String
}

sil @consumeND : $@convention(thin) (@owned ND) -> ()

// An assignment over a value destroys the old value.

// expected-error@+2 {{'nd' is not consumed on all paths}}
// expected-note@+1 {{path exits here without a consume}}
sil [ossa] @storeAssign : $@convention(thin) (@owned ND, @owned ND) -> () {
bb0(%0 : @owned $ND, %1 : @owned $ND):
  %2 = alloc_stack $ND, var, name "nd"
  store %0 to [init] %2
  store %1 to [assign] %2
  %4 = function_ref @consumeND : $@convention(thin) (@owned ND) -> ()
  %5 = load [take] %2
  %6 = apply %4(%5) : $@convention(thin) (@owned ND) -> ()
  dealloc_stack %2
  %8 = tuple ()
  return %8
}

// expected-error@+2 {{value of type 'T' is not consumed on all paths}}
// expected-note@+1 {{path exits here without a consume}}
sil [ossa] @copyAddrAssign : $@convention(thin) <T: ~Copyable & ~Deinitable> (@inout T, @in T) -> () {
bb0(%0 : $*T, %1 : $*T):
  copy_addr [take] %1 to %0
  %3 = tuple ()
  return %3
}

// Assigning over a value that can be destroyed implicitly is fine.

sil [ossa] @storeAssignImplicitlyDestroyable : $@convention(thin) (@inout String, @owned String) -> () {
bb0(%0 : $*String, %1 : @owned $String):
  store %1 to [assign] %0
  %3 = tuple ()
  return %3
}

// `discard self` is only supported yet if every stored property can be destroyed implicitly.

sil [ossa] @dropDeinitNontrivialField : $@convention(method) (@owned Holder) -> () {
bb0(%0 : @owned $Holder):
  %1 = drop_deinit %0 // expected-error {{'discard' is not yet supported for nondeinitable type 'Holder'}}
  destroy_value %1
  %3 = tuple ()
  return %3
}

sil [ossa] @dropDeinitImplicitlyDestroyableField : $@convention(method) (@owned StringHolder) -> () {
bb0(%0 : @owned $StringHolder):
  %1 = drop_deinit %0
  destroy_value %1
  %3 = tuple ()
  return %3
}

sil [ossa] @dropDeinitTrivialField : $@convention(method) (@owned ND) -> () {
bb0(%0 : @owned $ND):
  %1 = drop_deinit %0
  destroy_value %1
  %3 = tuple ()
  return %3
}

// The rest of a function with an unsupported `discard self` is still checked.

// expected-error@+2 {{value of type 'ND' is not consumed on all paths}}
// expected-note@+1 {{path exits here without a consume}}
sil [ossa] @dropDeinitAndDrop : $@convention(method) (@owned Holder, @owned ND) -> () {
bb0(%0 : @owned $Holder, %1 : @owned $ND):
  %2 = drop_deinit %0 // expected-error {{'discard' is not yet supported for nondeinitable type 'Holder'}}
  destroy_value %2
  destroy_value %1
  %5 = tuple ()
  return %5
}
