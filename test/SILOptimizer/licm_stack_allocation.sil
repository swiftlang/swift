// RUN: %target-sil-opt -enforce-exclusivity=none -enable-sil-verify-all %s -loop-invariant-code-motion | %FileCheck %s

sil_stage canonical

import Builtin
import Swift

protocol Q : AnyObject {}

sil @use_inout : $@convention(thin) (@inout Int) -> ()
sil @use_in_guaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()
sil @get_Q : $@convention(thin) () -> @owned any Q

sil [ossa] @read_int : $@convention(thin) (@in_guaranteed Int) -> () {
[global: ]
[%0: read]
}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb3:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK:       } // end sil function 'hoist_alloc_stack'
sil [ossa] @hoist_alloc_stack : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  store %0 to [trivial] %1
  %3 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %4 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  dealloc_stack %1
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %8 = tuple ()
  return %8
}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_multiple_deallocs :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb6:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK-NEXT:    tuple
// CHECK:       } // end sil function 'hoist_alloc_stack_multiple_deallocs'
sil [ossa] @hoist_alloc_stack_multiple_deallocs : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  store %0 to [trivial] %1
  %3 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %4 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  cond_br undef, bb2, bb3

bb2:
  dealloc_stack %1
  br bb4

bb3:
  dealloc_stack %1
  br bb4

bb4:
  cond_br undef, bb5, bb6

bb5:
  br bb1

bb6:
  %12 = tuple ()
  return %12
}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_multiple_exits :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb4:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK-NEXT:    br bb6
// CHECK:       {{^}}bb5:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK-NEXT:    br bb6
// CHECK:       } // end sil function 'hoist_alloc_stack_multiple_exits'
sil [ossa] @hoist_alloc_stack_multiple_exits : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  store %0 to [trivial] %1
  %3 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %4 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  dealloc_stack %1
  cond_br undef, bb2, bb4

bb2:
  cond_br undef, bb3, bb5

bb3:
  br bb1

bb4:
  br bb6

bb5:
  br bb6

bb6:
  %12 = tuple ()
  return %12
}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_live_at_exit :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb4:
// CHECK-NEXT:    apply %{{[0-9]+}}([[A]])
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK-NEXT:    br bb6
// CHECK:       {{^}}bb5:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK-NEXT:    br bb6
// CHECK:       } // end sil function 'hoist_alloc_stack_live_at_exit'
sil [ossa] @hoist_alloc_stack_live_at_exit : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  store %0 to [trivial] %1
  %3 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %4 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  cond_br undef, bb2, bb4

bb2:
  dealloc_stack %1
  cond_br undef, bb3, bb5

bb3:
  br bb1

bb4:
  %9 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  dealloc_stack %1
  br bb6

bb5:
  br bb6

bb6:
  %13 = tuple ()
  return %13
}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_live_at_dead_end_exit :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb4:
// CHECK-NEXT:    apply {{%.*}}([[A]])
// CHECK-NEXT:    unreachable
// CHECK:       {{^}}bb5:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK:       } // end sil function 'hoist_alloc_stack_live_at_dead_end_exit'
sil [ossa] @hoist_alloc_stack_live_at_dead_end_exit : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  store %0 to [trivial] %1
  %3 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %4 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  cond_br undef, bb2, bb4

bb2:
  dealloc_stack %1
  cond_br undef, bb3, bb5

bb3:
  br bb1

bb4:
  %8 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  unreachable

bb5:
  %11 = tuple ()
  return %11
}

// CHECK-LABEL: sil [ossa] @dont_hoist_alloc_stack_in_conditional_block :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb2:
// CHECK-NEXT:    alloc_stack $Int
// CHECK:       {{^}}bb3:
// CHECK-NEXT:    dealloc_stack
// CHECK:       {{^}}bb4:
// CHECK-NEXT:    dealloc_stack
// CHECK:       } // end sil function 'dont_hoist_alloc_stack_in_conditional_block'
sil [ossa] @dont_hoist_alloc_stack_in_conditional_block : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  cond_br undef, bb2, bb5

bb2:
  %2 = alloc_stack $Int
  store %0 to [trivial] %2
  %4 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %5 = apply %4(%2) : $@convention(thin) (@inout Int) -> ()
  cond_br undef, bb3, bb4

bb3:
  dealloc_stack %2
  br bb1

bb4:
  dealloc_stack %2
  br bb6

bb5:
  br bb6

bb6:
  %12 = tuple ()
  return %12
}

// CHECK-LABEL: sil [ossa] @hoist_nested_alloc_stacks :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK-NEXT:    [[B:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb3:
// CHECK-NEXT:    dealloc_stack [[B]]
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK:       } // end sil function 'hoist_nested_alloc_stacks'
sil [ossa] @hoist_nested_alloc_stacks : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  %2 = alloc_stack $Int
  store %0 to [trivial] %1
  store %0 to [trivial] %2
  %5 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %6 = apply %5(%1) : $@convention(thin) (@inout Int) -> ()
  %7 = apply %5(%2) : $@convention(thin) (@inout Int) -> ()
  dealloc_stack %2
  dealloc_stack %1
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %12 = tuple ()
  return %12
}

// CHECK-LABEL: sil [ossa] @dont_hoist_alloc_stack_of_loop_variant_type :
// CHECK:       {{^}}bb0:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb1:
// CHECK:         [[A:%.*]] = alloc_stack $@opened(1, any Q) Self
// CHECK:         dealloc_stack [[A]]
// CHECK-NEXT:    cond_br
// CHECK:       } // end sil function 'dont_hoist_alloc_stack_of_loop_variant_type'
sil [ossa] @dont_hoist_alloc_stack_of_loop_variant_type : $@convention(thin) () -> () {
bb0:
  br bb1

bb1:
  %1 = function_ref @get_Q : $@convention(thin) () -> @owned any Q
  %2 = apply %1() : $@convention(thin) () -> @owned any Q
  %3 = open_existential_ref %2 to $@opened(1, any Q) Self
  %4 = alloc_stack $@opened(1, any Q) Self
  store %3 to [init] %4
  %6 = function_ref @use_in_guaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %7 = apply %6<@opened(1, any Q) Self>(%4) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  destroy_addr %4
  dealloc_stack %4
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %12 = tuple ()
  return %12
}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_nested_in_unhoistable_alloc_stack :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK:         [[B:%.*]] = alloc_stack $@opened(2, any Q) Self
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb2:
// CHECK-NEXT:    destroy_addr [[B]]
// CHECK-NEXT:    dealloc_stack [[B]]
// CHECK-NEXT:    br bb1
// CHECK:       {{^}}bb3:
// CHECK:         destroy_addr [[B]]
// CHECK-NEXT:    dealloc_stack [[B]]
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK:       } // end sil function 'hoist_alloc_stack_nested_in_unhoistable_alloc_stack'
sil [ossa] @hoist_alloc_stack_nested_in_unhoistable_alloc_stack : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = function_ref @get_Q : $@convention(thin) () -> @owned any Q
  %2 = apply %1() : $@convention(thin) () -> @owned any Q
  %3 = open_existential_ref %2 to $@opened(2, any Q) Self
  %4 = alloc_stack $@opened(2, any Q) Self
  store %3 to [init] %4
  %6 = alloc_stack $Int
  store %0 to [trivial] %6
  %8 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %9 = apply %8(%6) : $@convention(thin) (@inout Int) -> ()
  dealloc_stack %6
  cond_br undef, bb2, bb3

bb2:
  destroy_addr %4
  dealloc_stack %4
  br bb1

bb3:
  %15 = function_ref @use_in_guaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %16 = apply %15<@opened(2, any Q) Self>(%4) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  destroy_addr %4
  dealloc_stack %4
  %19 = tuple ()
  return %19
}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_out_of_nested_loops :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb6:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK:       } // end sil function 'hoist_alloc_stack_out_of_nested_loops'
sil [ossa] @hoist_alloc_stack_out_of_nested_loops : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  br bb2

bb2:
  %2 = alloc_stack $Int
  store %0 to [trivial] %2
  %4 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %5 = apply %4(%2) : $@convention(thin) (@inout Int) -> ()
  dealloc_stack %2
  cond_br undef, bb3, bb4

bb3:
  br bb2

bb4:
  cond_br undef, bb5, bb6

bb5:
  br bb1

bb6:
  %11 = tuple ()
  return %11
}

// The stored value only becomes loop invariant in the second round of hoisting.
//
// CHECK-LABEL: sil [ossa] @hoist_store_and_alloc_stack_speculatively :
// CHECK:       {{^}}bb0(%0 : $Builtin.Int64):
// CHECK-DAG:     [[V:%.*]] = struct $Int (%0)
// CHECK-DAG:     [[A:%.*]] = alloc_stack $Int
// CHECK:         store [[V]] to [trivial] [[A]]
// CHECK-NEXT:    br bb1
// CHECK-NOT:     store
// CHECK:       } // end sil function 'hoist_store_and_alloc_stack_speculatively'
sil [ossa] @hoist_store_and_alloc_stack_speculatively : $@convention(thin) (Builtin.Int64) -> () {
bb0(%0 : $Builtin.Int64):
  br bb1

bb1:
  %1 = alloc_stack $Int
  %2 = struct $Int (%0)
  cond_br undef, bb2, bb6

bb2:
  store %2 to [trivial] %1
  %5 = function_ref @read_int : $@convention(thin) (@in_guaranteed Int) -> ()
  %6 = apply %5(%1) : $@convention(thin) (@in_guaranteed Int) -> ()
  br bb3

bb6:
  br bb3

bb3:
  dealloc_stack %1
  cond_br undef, bb4, bb5

bb4:
  br bb1

bb5:
  %11 = tuple ()
  return %11
}

// CHECK-LABEL: sil @dont_hoist_alloc_stack_out_of_loop_without_exits :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb1:
// CHECK-NEXT:    [[A:%.*]] = alloc_stack $Int
// CHECK:         dealloc_stack [[A]]
// CHECK-NEXT:    br bb1
// CHECK:       } // end sil function 'dont_hoist_alloc_stack_out_of_loop_without_exits'
sil @dont_hoist_alloc_stack_out_of_loop_without_exits : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  store %0 to %1
  %3 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %4 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  dealloc_stack %1
  br bb1
}
