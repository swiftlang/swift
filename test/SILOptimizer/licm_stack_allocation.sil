}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_live_at_dead_end_exit :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:         apply
// CHECK:         [[T:%.*]] = alloc_stack $Int
// CHECK-NEXT:    copy_addr [[A]] to [init] [[T]]
// CHECK:       {{^}}bb4:
// CHECK-NEXT:    apply {{%.*}}([[A]])
// CHECK-NEXT:    unreachable
// CHECK:       {{^}}bb5:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK:       } // end sil function 'hoist_alloc_stack_live_at_dead_end_exit'
sil [ossa] @hoist_alloc_stack_live_at_dead_end_exit : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  store %0 to [trivial] %1
  %3 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %4 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  %5 = alloc_stack $Int
  copy_addr %1 to [init] %5
  %7 = function_ref @read_int : $@convention(thin) (@in_guaranteed Int) -> ()
  %8 = apply %7(%5) : $@convention(thin) (@in_guaranteed Int) -> ()
  dealloc_stack %5
  cond_br undef, bb2, bb4

bb2:
  dealloc_stack %1
  cond_br undef, bb3, bb5

bb3:
  br bb1

bb4:
  %14 = apply %3(%1) : $@convention(thin) (@inout Int) -> ()
  unreachable

bb5:
  %16 = tuple ()
  return %16
}

// The inner loop's exit bb5 is a dead-end block that leads back to the allocation.
//
// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_out_of_loop_inside_dead_end_loop :
// CHECK:       {{^}}bb2:
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK-NEXT:    br bb3
// CHECK:       {{^}}bb3:
// CHECK-NOT:     dealloc_stack [[A]]
// CHECK-NOT:     alloc_stack
// CHECK:         apply
// CHECK:         [[T:%.*]] = alloc_stack $Int
// CHECK-NEXT:    copy_addr [[A]] to [init] [[T]]
// CHECK-NOT:     dealloc_stack [[A]]
// CHECK:       {{^}}bb5:
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK-NEXT:    br bb7
// CHECK:       } // end sil function 'hoist_alloc_stack_out_of_loop_inside_dead_end_loop'
sil [ossa] @hoist_alloc_stack_out_of_loop_inside_dead_end_loop : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  cond_br undef, bb2, bb6

bb2:
  br bb3

bb3:
  %2 = alloc_stack $Int
  store %0 to [trivial] %2
  %4 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %5 = apply %4(%2) : $@convention(thin) (@inout Int) -> ()
  %6 = alloc_stack $Int
  copy_addr %2 to [init] %6
  %8 = function_ref @read_int : $@convention(thin) (@in_guaranteed Int) -> ()
  %9 = apply %8(%6) : $@convention(thin) (@in_guaranteed Int) -> ()
  dealloc_stack %6
  dealloc_stack %2
  cond_br undef, bb4, bb5

bb4:
  br bb3

bb5:
  br bb7

bb6:
  br bb7

bb7:
  cond_br undef, bb8, bb9

bb8:
  br bb1

bb9:
  unreachable
}

// CHECK-LABEL: sil [ossa] @dont_hoist_alloc_stack_in_conditional_block :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb2:
// CHECK-NEXT:    alloc_stack $Int
// CHECK:       {{^}}bb3:
// CHECK-NEXT:    dealloc_stack
// CHECK:       {{^}}bb4:
// CHECK-NEXT:    dealloc_stack
// CHECK:       } // end sil function 'dont_hoist_alloc_stack_in_conditional_block'
sil [ossa] @dont_hoist_alloc_stack_in_conditional_block : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  cond_br undef, bb2, bb5

bb2:
  %2 = alloc_stack $Int
  store %0 to [trivial] %2
  %4 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %5 = apply %4(%2) : $@convention(thin) (@inout Int) -> ()
  %6 = alloc_stack $Int
  copy_addr %2 to [init] %6
  %8 = function_ref @read_int : $@convention(thin) (@in_guaranteed Int) -> ()
  %9 = apply %8(%6) : $@convention(thin) (@in_guaranteed Int) -> ()
  dealloc_stack %6
  cond_br undef, bb3, bb4

bb3:
  dealloc_stack %2
  br bb1

bb4:
  dealloc_stack %2
  br bb6

bb5:
  br bb6

bb6:
  %17 = tuple ()
  return %17
}

// CHECK-LABEL: sil [ossa] @hoist_nested_alloc_stacks :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK-NEXT:    [[B:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK-NOT:     alloc_stack
// CHECK:         apply
// CHECK:         [[T1:%.*]] = alloc_stack $Int
// CHECK-NEXT:    copy_addr [[A]] to [init] [[T1]]
// CHECK:         [[T2:%.*]] = alloc_stack $Int
// CHECK-NEXT:    copy_addr [[B]] to [init] [[T2]]
// CHECK:       {{^}}bb3:
// CHECK-NEXT:    dealloc_stack [[B]]
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK:       } // end sil function 'hoist_nested_alloc_stacks'
sil [ossa] @hoist_nested_alloc_stacks : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = alloc_stack $Int
  %2 = alloc_stack $Int
  store %0 to [trivial] %1
  store %0 to [trivial] %2
  %5 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %6 = apply %5(%1) : $@convention(thin) (@inout Int) -> ()
  %7 = apply %5(%2) : $@convention(thin) (@inout Int) -> ()
  %8 = function_ref @read_int : $@convention(thin) (@in_guaranteed Int) -> ()
  %9 = alloc_stack $Int
  copy_addr %1 to [init] %9
  %11 = apply %8(%9) : $@convention(thin) (@in_guaranteed Int) -> ()
  dealloc_stack %9
  %13 = alloc_stack $Int
  copy_addr %2 to [init] %13
  %15 = apply %8(%13) : $@convention(thin) (@in_guaranteed Int) -> ()
  dealloc_stack %13
  dealloc_stack %2
  dealloc_stack %1
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %20 = tuple ()
  return %20
}

// CHECK-LABEL: sil [ossa] @dont_hoist_alloc_stack_of_loop_variant_type :
// CHECK:       {{^}}bb0:
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb1:
// CHECK:         [[A:%.*]] = alloc_stack $@opened(1, any Q) Self
// CHECK:         copy_addr [[A]] to [init]
// CHECK:         dealloc_stack [[A]]
// CHECK-NEXT:    cond_br
// CHECK:       } // end sil function 'dont_hoist_alloc_stack_of_loop_variant_type'
sil [ossa] @dont_hoist_alloc_stack_of_loop_variant_type : $@convention(thin) () -> () {
bb0:
  br bb1

bb1:
  %1 = function_ref @get_Q : $@convention(thin) () -> @owned any Q
  %2 = apply %1() : $@convention(thin) () -> @owned any Q
  %3 = open_existential_ref %2 to $@opened(1, any Q) Self
  %4 = alloc_stack $@opened(1, any Q) Self
  store %3 to [init] %4
  %6 = function_ref @use_in_guaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %7 = apply %6<@opened(1, any Q) Self>(%4) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %8 = alloc_stack $@opened(1, any Q) Self
  copy_addr %4 to [init] %8
  %10 = apply %6<@opened(1, any Q) Self>(%8) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  destroy_addr %8
  dealloc_stack %8
  destroy_addr %4
  dealloc_stack %4
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %18 = tuple ()
  return %18
}

// CHECK-LABEL: sil [ossa] @hoist_alloc_stack_nested_in_unhoistable_alloc_stack :
// CHECK:       {{^}}bb0(%0 : $Int):
// CHECK:         [[A:%.*]] = alloc_stack $Int
// CHECK:       {{^}}bb1:
// CHECK:         [[B:%.*]] = alloc_stack $@opened(2, any Q) Self
// CHECK-NOT:     alloc_stack
// CHECK:         apply
// CHECK:         [[T:%.*]] = alloc_stack $Int
// CHECK-NEXT:    copy_addr [[A]] to [init] [[T]]
// CHECK:       {{^}}bb2:
// CHECK-NEXT:    destroy_addr [[B]]
// CHECK-NEXT:    dealloc_stack [[B]]
// CHECK-NEXT:    br bb1
// CHECK:       {{^}}bb3:
// CHECK:         destroy_addr [[B]]
// CHECK-NEXT:    dealloc_stack [[B]]
// CHECK-NEXT:    dealloc_stack [[A]]
// CHECK:       } // end sil function 'hoist_alloc_stack_nested_in_unhoistable_alloc_stack'
sil [ossa] @hoist_alloc_stack_nested_in_unhoistable_alloc_stack : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  br bb1

bb1:
  %1 = function_ref @get_Q : $@convention(thin) () -> @owned any Q
  %2 = apply %1() : $@convention(thin) () -> @owned any Q
  %3 = open_existential_ref %2 to $@opened(2, any Q) Self
  %4 = alloc_stack $@opened(2, any Q) Self
  store %3 to [init] %4
  %6 = alloc_stack $Int
  store %0 to [trivial] %6
  %8 = function_ref @use_inout : $@convention(thin) (@inout Int) -> ()
  %9 = apply %8(%6) : $@convention(thin) (@inout Int) -> ()
  %10 = alloc_stack $Int
  copy_addr %6 to [init] %10
  %12 = function_ref @read_int : $@convention(thin) (@in_guaranteed Int) -> ()
  %13 = apply %12(%10) : $@convention(thin) (@in_guaranteed Int) -> ()
  dealloc_stack %10
  dealloc_stack %6
  cond_br undef, bb2, bb3

bb2:
  destroy_addr %4
  dealloc_stack %4
  br bb1

bb3:
  %21 = function_ref @use_in_guaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %22 = apply %21<@opened(2, any Q) Self>(%4) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  destroy_addr %4
  dealloc_stack %4
  %25 = tuple ()
  return %25
}

