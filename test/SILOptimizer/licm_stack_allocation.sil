// CHECK-LABEL: sil [ossa] @hoist_move_between_stack_slots :
// CHECK:       {{^}}bb0:
// CHECK:         [[T:%.*]] = alloc_stack $any Q
// CHECK-NEXT:    br bb1
// CHECK:       {{^}}bb1:
// CHECK-NEXT:    [[E:%.*]] = alloc_stack $any Q, let, name "e"
// CHECK:         copy_addr [take] [[T]] to [init] [[E]]
// CHECK-NOT:     dealloc_stack [[T]]
// CHECK:         dealloc_stack [[E]]
// CHECK-NEXT:    cond_br
// CHECK:       {{^}}bb3:
// CHECK-NEXT:    dealloc_stack [[T]]
// CHECK:       } // end sil function 'hoist_move_between_stack_slots'
sil [ossa] @hoist_move_between_stack_slots : $@convention(thin) () -> () {
bb0:
  br bb1

bb1:
  %1 = alloc_stack $any Q, let, name "e"
  %2 = alloc_stack $any Q
  %3 = function_ref @get_Q : $@convention(thin) () -> @owned any Q
  %4 = apply %3() : $@convention(thin) () -> @owned any Q
  store %4 to [init] %2
  copy_addr [take] %2 to [init] %1
  dealloc_stack %2
  %8 = function_ref @use_in_guaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %9 = apply %8<any Q>(%1) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  destroy_addr %1
  dealloc_stack %1
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %14 = tuple ()
  return %14
}

// The temporary is the source of the move, but also the destination of the copy from %0.
//
// CHECK-LABEL: sil [ossa] @dont_hoist_move_between_stack_slots_from_outside :
// CHECK:       {{^}}bb0(%0 : $*any Q):
// CHECK-NOT:     alloc_stack
// CHECK:       {{^}}bb1:
// CHECK-NEXT:    [[E:%.*]] = alloc_stack $any Q, let, name "e"
// CHECK-NEXT:    [[T:%.*]] = alloc_stack $any Q
// CHECK-NEXT:    copy_addr %0 to [init] [[T]]
// CHECK-NEXT:    copy_addr [take] [[T]] to [init] [[E]]
// CHECK-NEXT:    dealloc_stack [[T]]
// CHECK:         dealloc_stack [[E]]
// CHECK-NEXT:    cond_br
// CHECK:       } // end sil function 'dont_hoist_move_between_stack_slots_from_outside'
sil [ossa] @dont_hoist_move_between_stack_slots_from_outside : $@convention(thin) (@inout any Q) -> () {
bb0(%0 : $*any Q):
  br bb1

bb1:
  %1 = alloc_stack $any Q, let, name "e"
  %2 = alloc_stack $any Q
  copy_addr %0 to [init] %2
  copy_addr [take] %2 to [init] %1
  dealloc_stack %2
  %6 = function_ref @use_in_guaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %7 = apply %6<any Q>(%1) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  destroy_addr %1
  dealloc_stack %1
  cond_br undef, bb2, bb3

bb2:
  br bb1

bb3:
  %12 = tuple ()
  return %12
}

