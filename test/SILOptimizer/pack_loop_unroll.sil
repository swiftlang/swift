// RUN: %target-sil-opt -enable-sil-verify-all -pack-loop-unroll %s | %FileCheck %s

sil_stage canonical

import Builtin
import Swift

// Only unroll a loop if it contains a dynamic_pack_index instruction that uses
// the loop counter.
//
// CHECK-LABEL: sil [ossa] @dont_unroll_non_pack_loop :
// CHECK:       bb0
// CHECK:         br bb1
// CHECK:       bb1
// CHECK:         cond_br {{.*}}, bb3, bb2
// CHECK:       bb2
// CHECK:         br bb1
// CHECK:       bb3
// CHECK-NOT:     {{^bb}}
// CHECK-LABEL: } // end sil function 'dont_unroll_non_pack_loop'
sil [ossa] @dont_unroll_non_pack_loop : $@convention(thin) () -> () {
bb0:
 %0 = integer_literal $Builtin.Word, 0
 %1 = integer_literal $Builtin.Word, 1
 %2 = integer_literal $Builtin.Word, 2
 %3 = integer_literal $Builtin.Int1, 1
 br bb1(%0 : $Builtin.Word)

bb1(%4 : $Builtin.Word):
  %5 = builtin "sadd_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %6 = tuple_extract %5 : $(Builtin.Word, Builtin.Int1), 0
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb3, bb2

bb2:
  br bb1(%6 : $Builtin.Word)

bb3:
 %9 = tuple()
 return %9 : $()
}

// CHECK-LABEL: sil [ossa] @unroll_pack_loop :
// CHECK:       bb0
// CHECK:         br bb1
// CHECK:       bb1
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         cond_br {{.*}}, bb2, bb3
// CHECK:       bb2
// CHECK:         br bb6
// CHECK:       bb3
// CHECK:         br bb4
// CHECK:       bb4
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         br bb5
// CHECK:       bb5
// CHECK:         br bb6
// CHECK:       bb6
// CHECK-LABEL: } // end sil function 'unroll_pack_loop'
sil [ossa] @unroll_pack_loop : $@convention(thin) () -> () {
bb0:
 %0 = integer_literal $Builtin.Word, 0
 %1 = integer_literal $Builtin.Word, 1
 %2 = integer_literal $Builtin.Word, 2
 %3 = integer_literal $Builtin.Int1, 1
 br bb1(%0 : $Builtin.Word)

bb1(%4 : $Builtin.Word):
  %dpi = dynamic_pack_index %4 of $Pack{Int64, UInt64, Bool}
  %ope = open_pack_element %dpi of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 1
  %5 = builtin "sadd_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %6 = tuple_extract %5 : $(Builtin.Word, Builtin.Int1), 0
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb3, bb2

bb2:
  br bb1(%6 : $Builtin.Word)

bb3:
 %9 = tuple()
 return %9 : $()
}

// CHECK-LABEL: sil [ossa] @unroll_pack_loop_with_pack_pack_index :
// CHECK:       bb0
// CHECK:         br bb1
// CHECK:       bb1
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         cond_br {{.*}}, bb2, bb3
// CHECK:       bb2
// CHECK:         br bb6
// CHECK:       bb3
// CHECK:         br bb4
// CHECK:       bb4
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         br bb5
// CHECK:       bb5
// CHECK:         br bb6
// CHECK:       bb6
// CHECK-LABEL: } // end sil function 'unroll_pack_loop_with_pack_pack_index'
sil [ossa] @unroll_pack_loop_with_pack_pack_index : $@convention(thin) () -> () {
bb0:
 %0 = integer_literal $Builtin.Word, 0
 %1 = integer_literal $Builtin.Word, 1
 %2 = integer_literal $Builtin.Word, 2
 %3 = integer_literal $Builtin.Int1, 1
 br bb1(%0 : $Builtin.Word)

bb1(%4 : $Builtin.Word):
  %dpi = dynamic_pack_index %4 of $Pack{Int64, UInt64, Bool}
  %ppi = pack_pack_index 1, %dpi of $Pack{Int64, Int64, UInt64, Bool}
  %ope = open_pack_element %dpi of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 2
  %5 = builtin "sadd_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %6 = tuple_extract %5 : $(Builtin.Word, Builtin.Int1), 0
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb3, bb2

bb2:
  br bb1(%6 : $Builtin.Word)

bb3:
 %9 = tuple()
 return %9 : $()
}

// TODO: When a pack is homogeneous, we could specialize uses of the opened
// @pack_element type without unrolling the loop, since every element is the
// same type.
//
// CHECK-LABEL: sil [ossa] @unroll_homogeneous_pack_loop :
// CHECK:       bb0
// CHECK:         br bb1
// CHECK:       bb1
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         cond_br {{.*}}, bb2, bb3
// CHECK:       bb2
// CHECK:         br bb6
// CHECK:       bb3
// CHECK:         br bb4
// CHECK:       bb4
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         br bb5
// CHECK:       bb5
// CHECK:         br bb6
// CHECK:       bb6
// CHECK-LABEL: } // end sil function 'unroll_homogeneous_pack_loop'
sil [ossa] @unroll_homogeneous_pack_loop : $@convention(thin) () -> () {
bb0:
 %0 = integer_literal $Builtin.Word, 0
 %1 = integer_literal $Builtin.Word, 1
 %2 = integer_literal $Builtin.Word, 2
 %3 = integer_literal $Builtin.Int1, 1
 br bb1(%0 : $Builtin.Word)

bb1(%4 : $Builtin.Word):
  %dpi = dynamic_pack_index %4 of $Pack{Int64, Int64, Int64}
  %ope = open_pack_element %dpi of <each U> at <Pack{Int64, Int64, Int64}>, shape $each U, id 3
  %5 = builtin "sadd_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %6 = tuple_extract %5 : $(Builtin.Word, Builtin.Int1), 0
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb3, bb2

bb2:
  br bb1(%6 : $Builtin.Word)

bb3:
 %9 = tuple()
 return %9 : $()
}

