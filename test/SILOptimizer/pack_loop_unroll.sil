 %0 = integer_literal $Builtin.Word, 0
 %1 = integer_literal $Builtin.Word, 1
 %2 = integer_literal $Builtin.Word, 50
 %3 = integer_literal $Builtin.Int1, 1
 br bb1(%0 : $Builtin.Word)

bb1(%4 : $Builtin.Word):
  %dpi = dynamic_pack_index %4 of $Pack{UInt64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64}
  %ope = open_pack_element %dpi of <each U> at <Pack{UInt64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64}>, shape $each U, id 4
  %5 = builtin "sadd_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %6 = tuple_extract %5 : $(Builtin.Word, Builtin.Int1), 0
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb3, bb2

bb2:
  br bb1(%6 : $Builtin.Word)

bb3:
 %9 = tuple()
 return %9 : $()
}

// CHECK-LABEL:    sil [ossa] @unroll_expensive_pack_loop :
// CHECK-COUNT-100:   builtin "sadd_with_overflow_Word
// CHECK-LABEL:    } // end sil function 'unroll_expensive_pack_loop'
sil [ossa] @unroll_expensive_pack_loop : $@convention(thin) () -> () {
bb0:
 %0 = integer_literal $Builtin.Word, 0
 %1 = integer_literal $Builtin.Word, 1
 %2 = integer_literal $Builtin.Word, 50
 %3 = integer_literal $Builtin.Int1, 1
 br bb1(%0 : $Builtin.Word)

bb1(%4 : $Builtin.Word):
  %dpi = dynamic_pack_index %4 of $Pack{UInt64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64}
  %ope = open_pack_element %dpi of <each U> at <Pack{UInt64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64}>, shape $each U, id 5
  %5 = builtin "sadd_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %5a = builtin "sadd_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %6 = tuple_extract %5 : $(Builtin.Word, Builtin.Int1), 0
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb3, bb2

bb2:
  br bb1(%6 : $Builtin.Word)

bb3:
 %9 = tuple()
 return %9 : $()
}


// Normal LoopUnroll only attempts to unroll the innermost loops in a nest, but
// PackLoopUnroll must unroll pack loops, even if they contain sub-loops. In
// this case, it also must not unroll the inner loop, which is not a pack loop.
//
// CHECK-LABEL: sil [ossa] @unroll_outer_pack_loop :
// CHECK:       bb0
// CHECK:         br bb1
// CHECK:       bb1
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         br bb2
// CHECK:       bb2
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         cond_br {{.*}}, bb4, bb3
// CHECK:       bb3
// CHECK:         br bb2
// CHECK:       bb4
// CHECK:         cond_br {{.*}}, bb5, bb6
// CHECK:       bb5
// CHECK:         br bb12
// CHECK:       bb6
// CHECK:         br bb7
// CHECK:       bb7
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         br bb8
// CHECK:       bb8
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         cond_br {{.*}}, bb9, bb10
// CHECK:       bb9
// CHECK:         br bb11
// CHECK:       bb10
// CHECK:         br bb8
// CHECK:       bb11
// CHECK:         br bb12
// CHECK:       bb12
// CHECK-LABEL: } // end sil function 'unroll_outer_pack_loop'
sil [ossa] @unroll_outer_pack_loop : $@convention(thin) () -> () {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Word, 1
  %2 = integer_literal $Builtin.Word, 2
  %3 = integer_literal $Builtin.Int1, -1
  br bb1(%0)

bb1(%5 : $Builtin.Word):
  %6 = dynamic_pack_index %5 of $Pack{Int64, UInt64, Bool}
  %ope = open_pack_element %6 of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 6
  %7 = builtin "sadd_with_overflow_Word"(%5, %1, %3) : $(Builtin.Word, Builtin.Int1)
  %8 = tuple_extract %7, 0
  %9 = builtin "cmp_eq_Word"(%8, %2) : $Builtin.Int1
  br bb2(%0)

bb2(%11 : $Builtin.Word):
  %12 = builtin "sadd_with_overflow_Word"(%11, %1, %3) : $(Builtin.Word, Builtin.Int1)
  %13 = tuple_extract %12, 0
  %14 = builtin "cmp_eq_Word"(%13, %2) : $Builtin.Int1
  cond_br %14, bb4, bb3

bb3:
  br bb2(%13)

bb4:
  cond_br %9, bb6, bb5

bb5:
  br bb1(%8)

bb6:
  %19 = tuple ()
  return %19
}

// CHECK-LABEL:   sil [ossa] @unroll_nested_pack_loops : $@convention(thin) () -> () {
// CHECK-COUNT-4:   integer_literal $Builtin.Word, 2222
// CHECK-LABEL:   } // end sil function 'unroll_nested_pack_loops'
sil [ossa] @unroll_nested_pack_loops : $@convention(thin) () -> () {
bb0:
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Word, 1
  %2 = integer_literal $Builtin.Word, 2
  %3 = integer_literal $Builtin.Int1, -1
  br bb1(%0)

bb1(%5 : $Builtin.Word):
  %6 = dynamic_pack_index %5 of $Pack{Int64, UInt64, Bool}
  %ope = open_pack_element %6 of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 7
  %7 = builtin "sadd_with_overflow_Word"(%5, %1, %3) : $(Builtin.Word, Builtin.Int1)
  %8 = tuple_extract %7, 0
  %9 = builtin "cmp_eq_Word"(%8, %2) : $Builtin.Int1
  br bb2(%0)

bb2(%11 : $Builtin.Word):
  %dpi2 = dynamic_pack_index %11 of $Pack{Int64, UInt64, Bool}
  %ope2 = open_pack_element %dpi2 of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 8
  %marker = integer_literal $Builtin.Word, 2222
  %12 = builtin "sadd_with_overflow_Word"(%11, %1, %3) : $(Builtin.Word, Builtin.Int1)
  %13 = tuple_extract %12, 0
  %14 = builtin "cmp_eq_Word"(%13, %2) : $Builtin.Int1
  cond_br %14, bb4, bb3

bb3:
  br bb2(%13)

bb4:
  cond_br %9, bb6, bb5

bb5:
  br bb1(%8)

bb6:
  %19 = tuple ()
  return %19
}

// CHECK-LABEL: sil [ossa] @unroll_outer_pack_loop_with_unbounded_inner_pack_loop : $@convention(thin) (Builtin.Word) -> () {
// CHECK:       bb0
// CHECK:         br bb1
// CHECK:       bb1
// CHECK:         integer_literal $Builtin.Word, 1111
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         br bb2
// CHECK:       bb2
// CHECK:         integer_literal $Builtin.Word, 2222
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         cond_br {{.*}}, bb4, bb3
// CHECK:       bb3
// CHECK:         br bb2
// CHECK:       bb4
// CHECK:         cond_br {{.*}}, bb5, bb6
// CHECK:       bb5
// CHECK:         br bb12
// CHECK:       bb6
// CHECK:         br bb7
// CHECK:       bb7
// CHECK:         integer_literal $Builtin.Word, 1111
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         br bb8
// CHECK:       bb8
// CHECK:         integer_literal $Builtin.Word, 2222
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         cond_br {{.*}}, bb9, bb10
// CHECK:       bb9
// CHECK:         br bb11
// CHECK:       bb10
// CHECK:         br bb8
// CHECK:       bb11
// CHECK:         br bb12
// CHECK:       bb12
// CHECK-LABEL: } // end sil function 'unroll_outer_pack_loop_with_unbounded_inner_pack_loop'
sil [ossa] @unroll_outer_pack_loop_with_unbounded_inner_pack_loop : $@convention(thin) (Builtin.Word) -> () {
bb0(%n : $Builtin.Word):
  %0 = integer_literal $Builtin.Word, 0
  %1 = integer_literal $Builtin.Word, 1
  %2 = integer_literal $Builtin.Word, 2
  %3 = integer_literal $Builtin.Int1, -1
  br bb1(%0)

bb1(%5 : $Builtin.Word):
  %6 = dynamic_pack_index %5 of $Pack{Int64, UInt64, Bool}
  %ope = open_pack_element %6 of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 9
  %outerMarker = integer_literal $Builtin.Word, 1111
  %7 = builtin "sadd_with_overflow_Word"(%5, %1, %3) : $(Builtin.Word, Builtin.Int1)
  %8 = tuple_extract %7, 0
  %9 = builtin "cmp_eq_Word"(%8, %2) : $Builtin.Int1
  br bb2(%0)

bb2(%11 : $Builtin.Word):
  %dpi2 = dynamic_pack_index %11 of $Pack{Int64, UInt64, Bool}
  %ope2 = open_pack_element %dpi2 of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 10
  %innerMarker = integer_literal $Builtin.Word, 2222
  %12 = builtin "sadd_with_overflow_Word"(%11, %1, %3) : $(Builtin.Word, Builtin.Int1)
  %13 = tuple_extract %12, 0
  %14 = builtin "cmp_eq_Word"(%13, %n) : $Builtin.Int1
  cond_br %14, bb4, bb3

bb3:
  br bb2(%13)

bb4:
  cond_br %9, bb6, bb5

bb5:
  br bb1(%8)

bb6:
  %19 = tuple ()
  return %19
}

// CHECK-LABEL: sil [ossa] @unroll_pack_loop_multi_open :
// CHECK:       bb0
// CHECK:         br bb1
// CHECK:       bb1
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         cond_br {{.*}}, bb2, bb3
// CHECK:       bb2
// CHECK:         br bb6
// CHECK:       bb3
// CHECK:         br bb4
// CHECK:       bb4
// CHECK:         builtin "sadd_with_overflow_Word
// CHECK:         br bb5
// CHECK:       bb5
// CHECK:         br bb6
// CHECK:       bb6
// CHECK-LABEL: } // end sil function 'unroll_pack_loop_multi_open'
sil [ossa] @unroll_pack_loop_multi_open : $@convention(thin) () -> () {
bb0:
 %0 = integer_literal $Builtin.Word, 0
 %1 = integer_literal $Builtin.Word, 1
 %2 = integer_literal $Builtin.Word, 2
 %3 = integer_literal $Builtin.Int1, 1
 br bb1(%0 : $Builtin.Word)

bb1(%4 : $Builtin.Word):
  %dpi = dynamic_pack_index %4 of $Pack{Int64, UInt64, Bool}
  %ope = open_pack_element %dpi of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 11
  %ope2 = open_pack_element %dpi of <each U> at <Pack{Int64, UInt64, Bool}>, shape $each U, id 12
  %5 = builtin "sadd_with_overflow_Word"(%4 : $Builtin.Word, %1 : $Builtin.Word, %3 : $Builtin.Int1) : $(Builtin.Word, Builtin.Int1)
  %6 = tuple_extract %5 : $(Builtin.Word, Builtin.Int1), 0
  %7 = builtin "cmp_eq_Word"(%6 : $Builtin.Word, %2 : $Builtin.Word) : $Builtin.Int1
  cond_br %7, bb3, bb2

bb2:
  br bb1(%6 : $Builtin.Word)

bb3:
 %9 = tuple()
 return %9 : $()
}
