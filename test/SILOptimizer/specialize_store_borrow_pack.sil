// RUN: %target-sil-opt -enable-sil-verify-all -generic-specializer %s | %FileCheck %s

// Removing the pack rewires each pack_element_get to the stored address. If
// the store_borrow scope ends too early, the verifier then catches it.
//
// This needs two sil-opt invocations. In one invocation, function passes run
// bottom-up, so the pack is removed from @callee before @caller is
// specialized, and the specialized clone never contains a pack.
// RUN: %target-sil-opt -enable-sil-verify-all -generic-specializer %s | \
// RUN:   %target-sil-opt -enable-sil-verify-all -simplification \
// RUN:     -simplify-instruction=alloc_pack | \
// RUN:   %FileCheck --check-prefix=SIMPLIFIED %s

sil_stage canonical

import Builtin
import Swift

sil @use : $@convention(thin) <T> (@in_guaranteed T) -> ()

// Specializing T := String turns %0 into a store_borrow. Its address is stored
// into the pack and read back out after the pack_element_set, so the
// end_borrow must come after the pack_element_get's use.
//
// CHECK-LABEL: sil shared [ossa] @$s6calleeSS_Tg5 :
// CHECK:         [[SB:%.*]] = store_borrow %0 to
// CHECK:         pack_element_set [[SB]] into
// CHECK-NOT:     end_borrow
// CHECK:         [[GET:%.*]] = pack_element_get
// CHECK-NOT:     end_borrow
// CHECK:         apply {{%.*}}<String>([[GET]])
// CHECK:         end_borrow [[SB]]
// CHECK-LABEL: } // end sil function '$s6calleeSS_Tg5'

// SIMPLIFIED-LABEL: sil shared [ossa] @$s6calleeSS_Tg5 :
// SIMPLIFIED:         [[SB:%.*]] = store_borrow %0 to
// SIMPLIFIED-NOT:     alloc_pack
// SIMPLIFIED:         apply {{%.*}}<String>([[SB]])
// SIMPLIFIED:         end_borrow [[SB]]
// SIMPLIFIED-LABEL: } // end sil function '$s6calleeSS_Tg5'
sil [ossa] @callee : $@convention(thin) <T> (@in_guaranteed T) -> () {
bb0(%0 : $*T):
  %1 = alloc_pack $Pack{T}
  %2 = scalar_pack_index 0 of $Pack{T}
  pack_element_set %0 into %2 of %1
  br bb1

bb1:
  %4 = pack_element_get %2 of %1 as $*T
  %5 = function_ref @use : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %6 = apply %5<T>(%4) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  dealloc_pack %1
  %8 = tuple ()
  return %8
}

sil [ossa] @caller : $@convention(thin) (@guaranteed String) -> () {
bb0(%0 : @guaranteed $String):
  %1 = alloc_stack $String
  %2 = store_borrow %0 to %1
  %3 = function_ref @callee : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %4 = apply %3<String>(%2) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  end_borrow %2
  dealloc_stack %1
  %7 = tuple ()
  return %7
}
