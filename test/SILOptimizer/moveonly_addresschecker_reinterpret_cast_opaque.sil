// RUN: %target-sil-opt -sil-print-types -enable-sil-opaque-values -sil-move-only-address-checker -enable-sil-verify-all %s | %FileCheck %s

// With opaque values, a noncopyable value of generic type is an object, so
// SILGen's Builtin.reinterpretCast of it is a load of the marked memory whose
// value only feeds an unchecked_bitwise_cast. This is the shape that
// moveonly_addresschecker_reinterpret_cast.swift gets from a loadable type
// without opaque values. This test runs the checker directly on that shape, so
// it does not depend on where address lowering sits in the pipeline.

sil_stage raw

import Builtin
import Swift

// The load is a consume of the marked memory, so the checker accepts the cast
// and removes the mark.
// CHECK-LABEL: sil [ossa] {{.*}}@cast_generic :
// CHECK-NOT:     mark_unresolved_non_copyable_value
// CHECK:         [[LOAD:%[^,]+]] = load [take] {{%[^,]+}} : $*T
// CHECK:         [[CAST:%[^,]+]] = unchecked_bitwise_cast [[LOAD]] : $T to $U
// CHECK:         [[COPY:%[^,]+]] = copy_value [[CAST]] : $U
// CHECK:         destroy_value [[LOAD]] : $T
// CHECK:         return [[COPY]] : $U
// CHECK:       } // end sil function 'cast_generic'
sil [ossa] @cast_generic : $@convention(thin) <T, U where T : ~Copyable> (@in T) -> @out U {
bb0(%0 : @owned $T):
  %1 = alloc_box $<τ_0_0, τ_0_1 where τ_0_0 : ~Copyable> { var τ_0_0 } <T, U>, var, name "x"
  %2 = begin_borrow [lexical] [var_decl] %1 : $<τ_0_0, τ_0_1 where τ_0_0 : ~Copyable> { var τ_0_0 } <T, U>
  %3 = project_box %2 : $<τ_0_0, τ_0_1 where τ_0_0 : ~Copyable> { var τ_0_0 } <T, U>, 0
  store %0 to [init] %3 : $*T
  %5 = begin_access [deinit] [unknown] %3 : $*T
  %6 = mark_unresolved_non_copyable_value [assignable_but_not_consumable] %5 : $*T
  %7 = load [take] %6 : $*T
  %8 = unchecked_bitwise_cast %7 : $T to $U
  %9 = copy_value %8 : $U
  destroy_value %7 : $T
  end_access %5 : $*T
  end_borrow %2 : $<τ_0_0, τ_0_1 where τ_0_0 : ~Copyable> { var τ_0_0 } <T, U>
  destroy_value %1 : $<τ_0_0, τ_0_1 where τ_0_0 : ~Copyable> { var τ_0_0 } <T, U>
  return %9 : $U
}
