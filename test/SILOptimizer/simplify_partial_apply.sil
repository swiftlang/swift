// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all %s -onone-simplification -simplify-instruction=partial_apply | %FileCheck %s


import Swift
import Builtin

struct NoncopyableValue<T>: ~Copyable {
  var t: T
}

sil @closure_with_args : $@convention(thin) (Int, Bool) -> ()
sil @closure2_with_args : $@convention(thin) (Int, String) -> ()
sil @closure3_with_args : $@convention(thin) (String, Bool) -> ()
sil @generic_callee_inguaranteed : $@convention(thin) <T, U> (@in_guaranteed T, @in_guaranteed U) -> ()
sil @noncopyable_closure : $@convention(thin) <T> (@in NoncopyableValue<T>) -> ()

// CHECK-LABEL: sil @test_apply_of_partial_apply
// CHECK:         [[F:%.*]] = function_ref @closure_with_args
// CHECK-NOT:     partial_apply
// CHECK:         apply [[F]](%0, %1)
// CHECK:       } // end sil function 'test_apply_of_partial_apply'
sil @test_apply_of_partial_apply : $@convention(thin) (Int, Bool) -> () {
bb0(%0 : $Int, %1 : $Bool):
  %2 = function_ref @closure_with_args : $@convention(thin) (Int, Bool) -> ()
  %3 = partial_apply %2(%1) : $@convention(thin) (Int, Bool) -> ()
  apply %3(%0) : $@callee_owned (Int) -> ()
  %r = tuple()
  return %r : $()
}

// CHECK-LABEL: sil @test_generic_partial_apply_apply_inguaranteed
// CHECK:         [[F:%.*]] = function_ref @generic_callee_inguaranteed
// CHECK:         [[S:%.*]] = alloc_stack $T
// CHECK:         copy_addr [take] %1 to [init] [[S]]
// CHECK-NOT:     partial_apply
// CHECK:         apply [[F]]<T, T>(%0, [[S]])
// CHECK:         destroy_addr [[S]]
// CHECK:         destroy_addr %0
// CHECK:       } // end sil function 'test_generic_partial_apply_apply_inguaranteed'
sil @test_generic_partial_apply_apply_inguaranteed : $@convention(thin) <T> (@in T, @in T) -> () {
bb0(%0 : $*T, %1 : $*T):
  %f1 = function_ref @generic_callee_inguaranteed : $@convention(thin) <T, U> (@in_guaranteed T, @in_guaranteed U) -> ()
  %pa = partial_apply %f1<T, T>(%1) : $@convention(thin) <T, U> (@in_guaranteed T, @in_guaranteed U) -> ()
  %a1 = apply %pa(%0) : $@callee_owned (@in_guaranteed T) -> ()
  destroy_addr %0 : $*T
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil @test_non_trivial_pa_args
// CHECK:         [[F:%.*]] = function_ref @closure2_with_args
// CHECK-NOT:     partial_apply
// CHECK:         apply [[F]](%0, %1)
// CHECK:         release_value %1
// CHECK:       } // end sil function 'test_non_trivial_pa_args'
sil @test_non_trivial_pa_args : $@convention(thin) (Int, String) -> () {
bb0(%0 : $Int, %1 : $String):
  %2 = function_ref @closure2_with_args : $@convention(thin) (Int, String) -> ()
  %3 = partial_apply %2(%1) : $@convention(thin) (Int, String) -> ()
  apply %3(%0) : $@callee_owned (Int) -> ()
  %r = tuple()
  return %r : $()
}

// CHECK-LABEL: sil @test_non_trivial_apply_args
// CHECK:         [[F:%.*]] = function_ref @closure3_with_args
// CHECK-NOT:     partial_apply
// CHECK:         apply [[F]](%0, %1)
// CHECK:       } // end sil function 'test_non_trivial_apply_args'
sil @test_non_trivial_apply_args : $@convention(thin) (String, Bool) -> () {
bb0(%0 : $String, %1 : $Bool):
  %2 = function_ref @closure3_with_args : $@convention(thin) (String, Bool) -> ()
  %3 = partial_apply %2(%1) : $@convention(thin) (String, Bool) -> ()
  apply %3(%0) : $@callee_owned (String) -> ()
  %r = tuple()
  return %r : $()
}

// CHECK-LABEL: sil @test_delete_dead_closure
// CHECK-NOT:     function_ref
// CHECK-NOT:     partial_apply
// CHECK:         release_value %0 : $String
// CHECK:       } // end sil function 'test_delete_dead_closure'
sil @test_delete_dead_closure : $@convention(thin) (@owned String, Bool) -> () {
bb0(%0 : $String, %1 : $Bool):
  %2 = function_ref @closure3_with_args : $@convention(thin) (String, Bool) -> ()
  %3 = partial_apply %2(%0, %1) : $@convention(thin) (String, Bool) -> ()
  release_value %3 : $@callee_owned () -> ()
  %r = tuple()
  return %r : $()
}

// CHECK-LABEL: sil @test_dont_delete_dead_closure_with_debug_use
// CHECK:         [[F:%.*]] = function_ref @closure3_with_args
// CHECK:         [[C:%.*]] = partial_apply [[F]]
// CHECK:         release_value [[C]]
// CHECK:       } // end sil function 'test_dont_delete_dead_closure_with_debug_use'
sil @test_dont_delete_dead_closure_with_debug_use : $@convention(thin) (@owned String, Bool) -> () {
bb0(%0 : $String, %1 : $Bool):
  %2 = function_ref @closure3_with_args : $@convention(thin) (String, Bool) -> ()
  %3 = partial_apply %2(%0, %1) : $@convention(thin) (String, Bool) -> ()
  debug_value %3 : $@callee_owned () -> (), let, name "x"
  release_value %3 : $@callee_owned () -> ()
  %r = tuple()
  return %r : $()
}


sil @closure_without_args : $@convention(thin) () -> ()
sil @generic_closure_without_args : $@convention(thin) <T> () -> ()
sil @use_closure : $@convention(thin) (@guaranteed @callee_guaranteed () -> ()) -> ()
sil @use_noescape_closure : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> ()) -> ()
sil @use_called_at_most_once_closure : $@convention(thin) (@guaranteed @noescape @called(atMostOnce) @callee_guaranteed () -> ()) -> ()

// CHECK-LABEL: sil @test_partial_apply_without_args
// CHECK:         [[F:%.*]] = function_ref @closure_without_args
// CHECK:         [[C:%.*]] = thin_to_thick_function [[F]] : $@convention(thin) () -> () to $@callee_guaranteed () -> ()
// CHECK-NOT:     partial_apply
// CHECK:         apply {{%.*}}([[C]])
// CHECK:       } // end sil function 'test_partial_apply_without_args'
sil @test_partial_apply_without_args : $@convention(thin) () -> () {
bb0:
  %0 = function_ref @closure_without_args : $@convention(thin) () -> ()
  %1 = partial_apply [callee_guaranteed] %0() : $@convention(thin) () -> ()
  %2 = function_ref @use_closure : $@convention(thin) (@guaranteed @callee_guaranteed () -> ()) -> ()
  %3 = apply %2(%1) : $@convention(thin) (@guaranteed @callee_guaranteed () -> ()) -> ()
  strong_release %1 : $@callee_guaranteed () -> ()
  %r = tuple()
  return %r : $()
}

// CHECK-LABEL: sil @test_on_stack_partial_apply_without_args
// CHECK:         [[F:%.*]] = function_ref @closure_without_args
// CHECK:         [[C:%.*]] = thin_to_thick_function [[F]] : $@convention(thin) () -> () to $@noescape @callee_guaranteed () -> ()
// CHECK-NOT:     partial_apply
// CHECK-NOT:     dealloc_stack
// CHECK:         apply {{%.*}}([[C]])
// CHECK-NOT:     dealloc_stack
// CHECK:       } // end sil function 'test_on_stack_partial_apply_without_args'
sil @test_on_stack_partial_apply_without_args : $@convention(thin) () -> () {
bb0:
  %0 = function_ref @closure_without_args : $@convention(thin) () -> ()
  %1 = partial_apply [callee_guaranteed] [on_stack] %0() : $@convention(thin) () -> ()
  %2 = function_ref @use_noescape_closure : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> ()) -> ()
  %3 = apply %2(%1) : $@convention(thin) (@guaranteed @noescape @callee_guaranteed () -> ()) -> ()
  dealloc_stack %1 : $@noescape @callee_guaranteed () -> ()
  %r = tuple()
  return %r : $()
}

// A partial_apply with substitutions still needs a context for the generic
// arguments.
// CHECK-LABEL: sil @test_generic_partial_apply_without_args
// CHECK:         partial_apply [callee_guaranteed] {{%.*}}<Int>()
// CHECK-NOT:     thin_to_thick_function
// CHECK:       } // end sil function 'test_generic_partial_apply_without_args'
sil @test_generic_partial_apply_without_args : $@convention(thin) () -> () {
bb0:
  %0 = function_ref @generic_closure_without_args : $@convention(thin) <T> () -> ()
  %1 = partial_apply [callee_guaranteed] %0<Int>() : $@convention(thin) <T> () -> ()
  %2 = function_ref @use_closure : $@convention(thin) (@guaranteed @callee_guaranteed () -> ()) -> ()
  %3 = apply %2(%1) : $@convention(thin) (@guaranteed @callee_guaranteed () -> ()) -> ()
  strong_release %1 : $@callee_guaranteed () -> ()
  %r = tuple()
  return %r : $()
}

// thin_to_thick_function can't produce a @called(atMostOnce) function type.
// CHECK-LABEL: sil @test_called_at_most_once_partial_apply_without_args
// CHECK:         partial_apply [callee_guaranteed] [on_stack] [called_at_most_once]
// CHECK-NOT:     thin_to_thick_function
// CHECK:       } // end sil function 'test_called_at_most_once_partial_apply_without_args'
sil @test_called_at_most_once_partial_apply_without_args : $@convention(thin) () -> () {
bb0:
  %0 = function_ref @closure_without_args : $@convention(thin) () -> ()
  %1 = partial_apply [callee_guaranteed] [on_stack] [called_at_most_once] %0() : $@convention(thin) () -> ()
  %2 = function_ref @use_called_at_most_once_closure : $@convention(thin) (@guaranteed @noescape @called(atMostOnce) @callee_guaranteed () -> ()) -> ()
  %3 = apply %2(%1) : $@convention(thin) (@guaranteed @noescape @called(atMostOnce) @callee_guaranteed () -> ()) -> ()
  dealloc_stack %1 : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  %r = tuple()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @test_partial_apply_without_args_ossa
// CHECK:         [[F:%.*]] = function_ref @closure_without_args
// CHECK:         [[C:%.*]] = thin_to_thick_function [[F]] : $@convention(thin) () -> () to $@callee_guaranteed () -> ()
// CHECK-NOT:     partial_apply
// CHECK:         apply {{%.*}}([[C]])
// CHECK:       } // end sil function 'test_partial_apply_without_args_ossa'
sil [ossa] @test_partial_apply_without_args_ossa : $@convention(thin) () -> () {
bb0:
  %0 = function_ref @closure_without_args : $@convention(thin) () -> ()
  %1 = partial_apply [callee_guaranteed] %0() : $@convention(thin) () -> ()
  %2 = function_ref @use_closure : $@convention(thin) (@guaranteed @callee_guaranteed () -> ()) -> ()
  %3 = apply %2(%1) : $@convention(thin) (@guaranteed @callee_guaranteed () -> ()) -> ()
  destroy_value %1 : $@callee_guaranteed () -> ()
  %r = tuple()
  return %r : $()
}

// The on-stack context of a closure that is called at most once owns the
// noncopyable address-only value that the closure consumes. Deleting the dead
// closure has to destroy the value.
//
// CHECK-LABEL: sil [ossa] @test_dead_called_at_most_once_owned_address
// CHECK:         [[TEMP:%.*]] = alloc_stack $NoncopyableValue<T>
// CHECK:         copy_addr [take] %0 to [init] [[TEMP]]
// CHECK-NOT:     partial_apply
// CHECK:         destroy_addr [[TEMP]]
// CHECK-NEXT:    dealloc_stack [[TEMP]]
// CHECK:       } // end sil function 'test_dead_called_at_most_once_owned_address'
sil [ossa] @test_dead_called_at_most_once_owned_address : $@convention(thin) <T> (@in NoncopyableValue<T>) -> () {
bb0(%0 : $*NoncopyableValue<T>):
  %1 = function_ref @noncopyable_closure : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>) -> ()
  %2 = alloc_stack $NoncopyableValue<T>
  copy_addr [take] %0 to [init] %2 : $*NoncopyableValue<T>
  %4 = partial_apply [callee_guaranteed] [on_stack] [called_at_most_once] %1<T>(%2) : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>) -> ()
  destroy_value %4 : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  dealloc_stack %2 : $*NoncopyableValue<T>
  %r = tuple()
  return %r : $()
}

// Folding the call into the closure would need a copy of the value to keep it
// alive until the closure is destroyed, and a noncopyable value can't be
// copied.
//
// CHECK-LABEL: sil [ossa] @test_apply_of_called_at_most_once_owned_address
// CHECK:         [[CLOSURE:%.*]] = partial_apply [callee_guaranteed] [on_stack] [called_at_most_once]
// CHECK-NEXT:    apply [[CLOSURE]]()
// CHECK-NEXT:    destroy_value [[CLOSURE]]
// CHECK:       } // end sil function 'test_apply_of_called_at_most_once_owned_address'
sil [ossa] @test_apply_of_called_at_most_once_owned_address : $@convention(thin) <T> (@in NoncopyableValue<T>) -> () {
bb0(%0 : $*NoncopyableValue<T>):
  %1 = function_ref @noncopyable_closure : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>) -> ()
  %2 = alloc_stack $NoncopyableValue<T>
  copy_addr [take] %0 to [init] %2 : $*NoncopyableValue<T>
  %4 = partial_apply [callee_guaranteed] [on_stack] [called_at_most_once] %1<T>(%2) : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>) -> ()
  apply %4() : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  destroy_value %4 : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  dealloc_stack %2 : $*NoncopyableValue<T>
  %r = tuple()
  return %r : $()
}

sil @noncopyable_inout_closure : $@convention(thin) <T> (@inout_aliasable NoncopyableValue<T>) -> ()
sil @noncopyable_consuming_and_inout_closure : $@convention(thin) <T> (@in NoncopyableValue<T>, @inout_aliasable NoncopyableValue<T>) -> ()

// Deleting the dead closure destroys the consumed value that the context owns,
// but not the value that the closure captures inout.
//
// CHECK-LABEL: sil [ossa] @test_dead_called_at_most_once_owned_and_inout_addresses
// CHECK:         [[TEMP:%.*]] = alloc_stack $NoncopyableValue<T>
// CHECK:         copy_addr [take] %0 to [init] [[TEMP]]
// CHECK-NOT:     partial_apply
// CHECK:         destroy_addr [[TEMP]]
// CHECK-NEXT:    dealloc_stack [[TEMP]]
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function 'test_dead_called_at_most_once_owned_and_inout_addresses'
sil [ossa] @test_dead_called_at_most_once_owned_and_inout_addresses : $@convention(thin) <T> (@in NoncopyableValue<T>, @inout NoncopyableValue<T>) -> () {
bb0(%0 : $*NoncopyableValue<T>, %1 : $*NoncopyableValue<T>):
  %2 = function_ref @noncopyable_consuming_and_inout_closure : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>, @inout_aliasable NoncopyableValue<τ_0_0>) -> ()
  %3 = alloc_stack $NoncopyableValue<T>
  copy_addr [take] %0 to [init] %3 : $*NoncopyableValue<T>
  %5 = partial_apply [callee_guaranteed] [on_stack] [called_at_most_once] %2<T>(%3, %1) : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>, @inout_aliasable NoncopyableValue<τ_0_0>) -> ()
  destroy_value %5 : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  dealloc_stack %3 : $*NoncopyableValue<T>
  %r = tuple()
  return %r : $()
}

// The context doesn't own a value that the closure captures inout, so the call
// can be folded into the closure.
//
// CHECK-LABEL: sil [ossa] @test_apply_of_called_at_most_once_inout_address
// CHECK:         [[F:%.*]] = function_ref @noncopyable_inout_closure
// CHECK-NOT:     partial_apply
// CHECK:         apply [[F]]<T>(%0)
// CHECK-NOT:     destroy_addr
// CHECK:       } // end sil function 'test_apply_of_called_at_most_once_inout_address'
sil [ossa] @test_apply_of_called_at_most_once_inout_address : $@convention(thin) <T> (@inout NoncopyableValue<T>) -> () {
bb0(%0 : $*NoncopyableValue<T>):
  %1 = function_ref @noncopyable_inout_closure : $@convention(thin) <τ_0_0> (@inout_aliasable NoncopyableValue<τ_0_0>) -> ()
  %2 = partial_apply [callee_guaranteed] [on_stack] [called_at_most_once] %1<T>(%0) : $@convention(thin) <τ_0_0> (@inout_aliasable NoncopyableValue<τ_0_0>) -> ()
  apply %2() : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  destroy_value %2 : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  %r = tuple()
  return %r : $()
}

// A value that the closure captures inout doesn't make folding possible when
// the context also owns a consumed value.
//
// CHECK-LABEL: sil [ossa] @test_apply_of_called_at_most_once_owned_and_inout_addresses
// CHECK:         [[CLOSURE:%.*]] = partial_apply [callee_guaranteed] [on_stack] [called_at_most_once] {{%.*}}<T>({{%.*}}, %1)
// CHECK-NEXT:    apply [[CLOSURE]]()
// CHECK-NEXT:    destroy_value [[CLOSURE]]
// CHECK:       } // end sil function 'test_apply_of_called_at_most_once_owned_and_inout_addresses'
sil [ossa] @test_apply_of_called_at_most_once_owned_and_inout_addresses : $@convention(thin) <T> (@in NoncopyableValue<T>, @inout NoncopyableValue<T>) -> () {
bb0(%0 : $*NoncopyableValue<T>, %1 : $*NoncopyableValue<T>):
  %2 = function_ref @noncopyable_consuming_and_inout_closure : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>, @inout_aliasable NoncopyableValue<τ_0_0>) -> ()
  %3 = alloc_stack $NoncopyableValue<T>
  copy_addr [take] %0 to [init] %3 : $*NoncopyableValue<T>
  %5 = partial_apply [callee_guaranteed] [on_stack] [called_at_most_once] %2<T>(%3, %1) : $@convention(thin) <τ_0_0> (@in NoncopyableValue<τ_0_0>, @inout_aliasable NoncopyableValue<τ_0_0>) -> ()
  apply %5() : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  destroy_value %5 : $@noescape @called(atMostOnce) @callee_guaranteed () -> ()
  dealloc_stack %3 : $*NoncopyableValue<T>
  %r = tuple()
  return %r : $()
}
