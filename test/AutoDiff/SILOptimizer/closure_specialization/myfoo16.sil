extension Dictionary : Differentiable where Value : Differentiable {
  public typealias TangentVector = [Key : Value.TangentVector]
  public mutating func move(by direction: [Key : Value.TangentVector])
  public var zeroTangentVectorInitializer: () -> [Key : Value.TangentVector] { get }
}

extension Dictionary : AdditiveArithmetic where Value : AdditiveArithmetic {
  public static func + (_ lhs: [Key : Value], _ rhs: [Key : Value]) -> [Key : Value]
  public static func - (_ lhs: [Key : Value], _ rhs: [Key : Value]) -> [Key : Value]
  public static var zero: [Key : Value] { get }
}

extension Dictionary where Value : Differentiable {
  @usableFromInline
  @derivative(of: subscript(_:))
  func vjpSubscriptGet(key: Key) -> (value: Value?, pullback: (Optional<Value>.TangentVector) -> [Key : Value.TangentVector])
}

extension Dictionary where Value : Differentiable {
  @differentiable(reverse, wrt: (self, newValue))
  public mutating func set(_ key: Key, to newValue: Value)

  @derivative(of: set)
  public mutating func vjpUpdated(_ key: Key, to newValue: Value) -> (value: (), pullback: (inout [Key : Value.TangentVector]) -> Value.TangentVector)
}

