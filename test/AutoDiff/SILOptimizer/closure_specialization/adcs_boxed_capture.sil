// RUN: %target-sil-opt -module-name BoxedCapture -enable-sil-verify-all %s -o /dev/null
// RUN: %target-sil-opt -module-name BoxedCapture -enable-sil-verify-all -autodiff-closure-specialization -dce %s -o - | %FileCheck %s
// RUN: %target-swift-frontend -O -sil-verify-all -sil-stop-optzns-before-lowering-ownership -emit-sil -D DEFINITIONS_ONLY -module-name BoxedCapture -Xllvm -sil-disable-pass=autodiff-closure-specialization %S/../../validation-test/closure_specialization/adcs_boxed_capture.swift -o %t.input.sil
// RUN: %target-sil-opt -module-name BoxedCapture -enable-sil-verify-all -autodiff-closure-specialization -dce %t.input.sil -o - | %FileCheck %s

// Generated from the validation-test source using the frontend command above.
// Retained the emitted enum declarations, branch VJP and pullback, boxedSquareVJP
// closure, and Float._vjpMultiply closure; removed unrelated declarations and
// functions. The retained SIL instructions and types are unmodified.
//
// Keep the boxed callback opaque while specializing the independent multiply
// callbacks. Running DCE exercises the Copyable conformance lookup that used to
// assert when the specialized enum's AST payload contained a SIL box type.

// CHECK: @frozen enum [[TAPE:_AD__[^ ]+_bb3__Pred__[^ ]+_spec_bb2_1_2_[^ ]+]] {
// CHECK-NEXT: case bb2((predecessor: {{[^,]+}}, (Float, Float), (Float, Float)))
// CHECK-NEXT: case bb1((predecessor: {{[^,]+}}, {{(@callee_guaranteed )?}}(Float) -> Float))

// CHECK-LABEL: sil [ossa] @$s12BoxedCapture6branchyS2f_SbtFTJrSUpSr :
// CHECK: [[BOX:%[0-9]+]] = alloc_box ${ var Float }
// CHECK: [[ROOT:%[0-9]+]] = function_ref @$s12BoxedCapture14boxedSquareVJPySf5value_S2fc8pullbacktSfFS2fcfU_
// CHECK-NEXT: [[COPY:%[0-9]+]] = copy_value [[BOX]]
// CHECK-NEXT: [[CALLBACK:%[0-9]+]] = partial_apply [callee_guaranteed] [[ROOT]]([[COPY]],
// CHECK: tuple {{.*}}[[CALLBACK]])
// CHECK: bb2:
// CHECK-NOT: partial_apply
// CHECK: enum $[[TAPE]], #{{[^ ]+}}.bb2!enumelt,
// CHECK: // function_ref specialized pullback of branch(_:_:)
// CHECK: return

// CHECK-LABEL: // specialized pullback of branch(_:_:)
// CHECK: [[MULTIPLY1:%[0-9]+]] = function_ref @$sSf16_DifferentiationE12_vjpMultiply
// CHECK-NEXT: {{%[0-9]+}} = apply [[MULTIPLY1]](
// CHECK: [[MULTIPLY2:%[0-9]+]] = function_ref @$sSf16_DifferentiationE12_vjpMultiply
// CHECK-NEXT: {{%[0-9]+}} = apply [[MULTIPLY2]](
// CHECK: ({{%[0-9]+}}, [[SAVED_CALLBACK:%[0-9]+]]) = destructure_tuple
// CHECK-NEXT: {{%[0-9]+}} = apply [[SAVED_CALLBACK]]({{%[0-9]+}}) : $@callee_guaranteed (Float) -> Float
// CHECK-NEXT: destroy_value [[SAVED_CALLBACK]]
// CHECK: } // end sil function

