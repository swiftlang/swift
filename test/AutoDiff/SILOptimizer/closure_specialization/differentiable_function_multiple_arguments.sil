// RUN: %target-sil-opt -enable-sil-verify-all -closure-specialization -module-name src %s -o %t
// RUN: %FileCheck %s --check-prefix=CHECK < %t
// RUN: %FileCheck %s --check-prefix=DISTINCT < %t
// RUN: %FileCheck %s --check-prefix=SPECIALIZED < %t

// EQUIRES: swift_in_compiler

// Derived from test/AutoDiff/validation-test/differentiable_function_specialization.swift.
// Capture command (with the runtime harness disabled, as in the supplied source):
//   swift-frontend -emit-sil -O -module-name=src \
//     -Xllvm -sil-print-around=closure-specialization \
//     differentiable_function_specialization.swift > dfs.sil 2> dfs.log
// The input below is extracted pre-pass SIL, not the final -O output.
// Only ClosureSpecialization (closure-specialization) snapshots are used here;
// AutodiffClosureSpecialization is a different pass also present in that log.
// Debug instructions and printed analysis summaries are omitted. Unneeded leaf
// bodies are declarations; all functions needed for applied-use analysis remain.
// Do not add SILCombine: dead differentiable_function instructions in callers
// are intentionally still present immediately after this pass.
// Keep -module-name src: the component types participate in specialization names.

// Test7 and Test7Distinct: keep both callers in one module. Their component
// types agree, but square/square and square/cube need different specializations.
// Check the six component expressions and the bundle-free call signatures.

