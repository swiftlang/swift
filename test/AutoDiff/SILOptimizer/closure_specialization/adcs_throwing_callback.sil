// PB: [[NORMAL_FN:%[0-9]+]] = function_ref @normalRoot
// PB-NEXT: {{.*}} = apply [[NORMAL_FN]](
// PB: destroy_value [[THROWING]]
// PB-NOT: function_ref @throwingRoot
// PB: } // end sil function

// PB-LABEL: // specialized pullback of bar(_:)
