  %n2 = enum $_AD__$s4test3fooyS2f_SbtF_bb2__Pred__src_0_wrt_0, #_AD__$s4test3fooyS2f_SbtF_bb2__Pred__src_0_wrt_0.bb0!enumelt, %npayload2 : $(Float, Optional<@callee_guaranteed (Float) -> Float>)
  br bb5(%n2 : $_AD__$s4test3fooyS2f_SbtF_bb2__Pred__src_0_wrt_0)
bb5(%nsaved : @owned $_AD__$s4test3fooyS2f_SbtF_bb2__Pred__src_0_wrt_0):
  %nonep = tuple $(predecessor: _AD__$s4test3fooyS2f_SbtF_bb2__Pred__src_0_wrt_0, Float) (%nsaved, %x)
  %noneTop = enum $_AD__$s4test3fooyS2f_SbtF_bb3__Pred__src_0_wrt_0, #_AD__$s4test3fooyS2f_SbtF_bb3__Pred__src_0_wrt_0.bb2!enumelt, %nonep : $(predecessor: _AD__$s4test3fooyS2f_SbtF_bb2__Pred__src_0_wrt_0, Float)
  br bb6(%noneTop : $_AD__$s4test3fooyS2f_SbtF_bb3__Pred__src_0_wrt_0)
bb6(%saved : @owned $_AD__$s4test3fooyS2f_SbtF_bb3__Pred__src_0_wrt_0):
  %pbfn = function_ref @$s4test3fooyS2f_SbtFTJpSpSr : $@convention(thin) (Float, @owned _AD__$s4test3fooyS2f_SbtF_bb3__Pred__src_0_wrt_0) -> Float
  %pb = partial_apply [callee_guaranteed] %pbfn(%saved) : $@convention(thin) (Float, @owned _AD__$s4test3fooyS2f_SbtF_bb3__Pred__src_0_wrt_0) -> Float
