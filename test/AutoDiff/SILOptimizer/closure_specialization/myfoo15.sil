    static func - (lhs: FloatPair.TangentVector, rhs: FloatPair.TangentVector) -> FloatPair.TangentVector
    static func == (lhs: FloatPair.TangentVector, rhs: FloatPair.TangentVector) -> Bool
  }
  mutating func move(by offset: FloatPair.TangentVector)
}

struct Pair<T, U> : Differentiable where T : Differentiable, U : Differentiable {
  @_hasStorage var first: T { get set }
  @_hasStorage var second: U { get set }
  init(_ first: T, _ second: U)
  struct TangentVector : AdditiveArithmetic, Differentiable where T : Differentiable, U : Differentiable {
    @_hasStorage var first: T.TangentVector { get set }
    @_hasStorage var second: U.TangentVector { get set }
    init(first: T.TangentVector, second: U.TangentVector)
    typealias TangentVector = Pair<T, U>.TangentVector
    static var zero: Pair<T, U>.TangentVector { get }
    static func + (lhs: Pair<T, U>.TangentVector, rhs: Pair<T, U>.TangentVector) -> Pair<T, U>.TangentVector
    static func - (lhs: Pair<T, U>.TangentVector, rhs: Pair<T, U>.TangentVector) -> Pair<T, U>.TangentVector
    static func == (lhs: Pair<T, U>.TangentVector, rhs: Pair<T, U>.TangentVector) -> Bool
  }
  mutating func move(by offset: Pair<T, U>.TangentVector)
}

