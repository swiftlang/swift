// RUN: %target-sil-opt -enable-sil-verify-all %s -o /dev/null
// RUN: %target-sil-opt -enable-sil-verify-all -autodiff-closure-specialization %s -o - | %FileCheck %s --implicit-check-not=_wrt_0_spec
// RUN: %target-sil-opt -enable-sil-verify-all -test-runner %s -o /dev/null 2>&1 | %FileCheck %s --check-prefix=ANALYSIS

sil_stage canonical
import Builtin
import Swift
import SwiftShims
import _Differentiation

// The returned pullback is a declaration whose body cannot be analyzed or
// cloned. Keep the callback and original tape intact. The function-test hooks
// also query specialization directly, bypassing the production eligibility check.
// CHECK-LABEL: enum _AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0 {
// CHECK-NEXT: case bb0((Float, (Float) -> Float))
enum _AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0 {
  case bb0((Float, (Float) -> Float))
}

enum _AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0 {
  case bb0((Float, (Float) -> Float))
}

sil @capture : $@convention(thin) (Float, Float) -> Float

// CHECK-LABEL: sil hidden_external @$s4test3fooyS2fFTJpSpSr :
sil hidden_external @$s4test3fooyS2fFTJpSpSr : $@convention(thin) (Float, @owned _AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0) -> Float

// CHECK-LABEL: sil hidden [ossa] @$s4test3fooyS2fFTJrSpSr :
// CHECK: [[ROOT:%[0-9]+]] = function_ref @capture
// CHECK-NEXT: [[CALLBACK:%[0-9]+]] = partial_apply [callee_guaranteed] [[ROOT]]
// CHECK-NEXT: [[PAYLOAD:%[0-9]+]] = tuple ({{.*}}[[CALLBACK]]{{.*}})
// CHECK-NEXT: enum $_AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0, {{.*}}[[PAYLOAD]]
// CHECK: [[PB:%[0-9]+]] = function_ref @$s4test3fooyS2fFTJpSpSr :
// CHECK-NEXT: partial_apply [callee_guaranteed] [[PB]]
// CHECK: return
sil hidden [ossa] @$s4test3fooyS2fFTJrSpSr : $@convention(thin) (Float) -> (Float, @owned @callee_guaranteed (Float) -> Float) {
bb0(%x : $Float):
  specify_test "autodiff_get_specialization_info"
  specify_test "autodiff_specialize_branch_tracing_enums"
  %fn = function_ref @capture : $@convention(thin) (Float, Float) -> Float
  %callback = partial_apply [callee_guaranteed] %fn(%x) : $@convention(thin) (Float, Float) -> Float
  %payload = tuple (%x : $Float, %callback : $@callee_guaranteed (Float) -> Float)
  %tape = enum $_AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0, #_AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0.bb0!enumelt, %payload
  br bb1(%tape : $_AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0)
bb1(%saved : @owned $_AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0):
  %pbfn = function_ref @$s4test3fooyS2fFTJpSpSr : $@convention(thin) (Float, @owned _AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0) -> Float
  %pb = partial_apply [callee_guaranteed] %pbfn(%saved) : $@convention(thin) (Float, @owned _AD__$s4test3fooyS2fF_bb1__Pred__src_0_wrt_0) -> Float
  %result = tuple (%x : $Float, %pb : $@callee_guaranteed (Float) -> Float)
  return %result
}

// A body without ownership information is also unsuitable for OSSA cloning.
// CHECK-LABEL: sil private @$s4test3baryS2fFTJpSpSr :
// CHECK: release_value
// CHECK: return
sil private @$s4test3baryS2fFTJpSpSr : $@convention(thin) (Float, @owned _AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0) -> Float {
bb0(%seed : $Float, %tape : $_AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0):
  release_value %tape : $_AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0
  return %seed
}

// CHECK-LABEL: sil hidden [ossa] @$s4test3baryS2fFTJrSpSr :
// CHECK: [[LEGACY_ROOT:%[0-9]+]] = function_ref @capture
// CHECK-NEXT: [[LEGACY_CALLBACK:%[0-9]+]] = partial_apply [callee_guaranteed] [[LEGACY_ROOT]]
// CHECK-NEXT: [[LEGACY_PAYLOAD:%[0-9]+]] = tuple ({{.*}}[[LEGACY_CALLBACK]]{{.*}})
// CHECK-NEXT: enum $_AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0, {{.*}}[[LEGACY_PAYLOAD]]
// CHECK: [[LEGACY_PB:%[0-9]+]] = function_ref @$s4test3baryS2fFTJpSpSr :
// CHECK-NEXT: partial_apply [callee_guaranteed] [[LEGACY_PB]]
// CHECK: return
sil hidden [ossa] @$s4test3baryS2fFTJrSpSr : $@convention(thin) (Float) -> (Float, @owned @callee_guaranteed (Float) -> Float) {
bb0(%x : $Float):
  specify_test "autodiff_get_specialization_info"
  specify_test "autodiff_specialize_branch_tracing_enums"
  %fn = function_ref @capture : $@convention(thin) (Float, Float) -> Float
  %callback = partial_apply [callee_guaranteed] %fn(%x) : $@convention(thin) (Float, Float) -> Float
  %payload = tuple (%x : $Float, %callback : $@callee_guaranteed (Float) -> Float)
  %tape = enum $_AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0, #_AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0.bb0!enumelt, %payload
  br bb1(%tape : $_AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0)
bb1(%saved : @owned $_AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0):
  %pbfn = function_ref @$s4test3baryS2fFTJpSpSr : $@convention(thin) (Float, @owned _AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0) -> Float
  %pb = partial_apply [callee_guaranteed] %pbfn(%saved) : $@convention(thin) (Float, @owned _AD__$s4test3baryS2fF_bb1__Pred__src_0_wrt_0) -> Float
  %result = tuple (%x : $Float, %pb : $@callee_guaranteed (Float) -> Float)
  return %result
}

// ANALYSIS-COUNT-4: Unsupported branch tracing enum specialization
// ANALYSIS-NOT: Unsupported branch tracing enum specialization
