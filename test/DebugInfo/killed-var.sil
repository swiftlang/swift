// RUN: %target-sil-opt --dce --sroa --copy-propagation -o /dev/null %s -sil-stats-degraded-variables 2>&1 | %FileCheck %s --check-prefixes=PASS,CHECK
// RUN: %target-sil-opt --dce --sroa --copy-propagation -o /dev/null %s -sil-stats-degraded-variables -sil-stats-subpass 2>&1 | %FileCheck %s --check-prefixes=SUBPASS,CHECK
// RUN: %target-sil-opt --dce --sroa --copy-propagation -o /dev/null %s -sil-stats-lost-variables 2>&1 | %FileCheck %s --allow-empty --check-prefix=NONE
// RUN: %target-sil-opt --dce --sroa --copy-propagation -o /dev/null %s 2>&1 | %FileCheck %s --allow-empty --check-prefix=NONE

// A variable is killed when everything describing it becomes `undef`, and
// degraded when only a part of it does. Both are reported by
// -sil-stats-degraded-variables. Neither is a lost variable: the variable is
// still there, it just describes less.

// DCE runs first, as OptimizerStats only run after a pass, so there is no
// baseline for the first pass.

sil_stage canonical

import Builtin
import Swift

class C {}

struct MyStruct {
  @_hasStorage var x: Int64 { get set }
  @_hasStorage var y: Int64 { get set }
  init(x: Int64, y: Int64)
}

sil_scope 1 { loc "file.swift":1:6 parent @reconstructed : $@convention(thin) (Int64) -> () }
sil_scope 2 { loc "other.swift":1:6 parent @plain : $@convention(thin) (@inout C) -> () }

sil @getC : $@convention(thin) () -> (@owned C)

// DCE needs a function to run on before the others, to establish the baseline.
sil private [ossa] @other : $@convention(thin) () -> () {
bb0:
  %v = tuple ()
  return %v : $()
}

// SROA replaces the allocation, which kills the operand of every debug value
// reconstructing a variable from it. "k" ends up fully undef, "p" keeps the
// half which does not come from the allocation, and "c" is a constant which
// never depended on it.
// CHECK: function, killedvars, {{.*}}, SROA, {{[0-9]+}}, 1, {{[0-9]+}}, reconstructed
// CHECK: function, degradedvars, {{.*}}, SROA, {{[0-9]+}}, 1, {{[0-9]+}}, reconstructed

sil private @reconstructed : $@convention(thin) (Int64) -> () {
bb0(%0 : $Int64):
  %1 = alloc_stack $MyStruct, loc "file.swift":2:5, scope 1
  %2 = struct_element_addr %1 : $*MyStruct, #MyStruct.x, loc "file.swift":2:5, scope 1
  store %0 to %2 : $*Int64, loc "file.swift":2:5, scope 1
  %3 = struct_element_addr %1 : $*MyStruct, #MyStruct.y, loc "file.swift":2:5, scope 1
  store %0 to %3 : $*Int64, loc "file.swift":2:5, scope 1

  // Everything this reconstructs comes from the allocation.
  debug_value %1 : $*MyStruct, let, name "k", type $Int64, transform {
  bb0(%a : $*MyStruct):
    %4 = struct_element_addr %a : $*MyStruct, #MyStruct.x
    %5 = load %4 : $*Int64
    return %5 : $Int64
  }, loc "file.swift":3:5, scope 1

  // Only the first half of this comes from the allocation.
  debug_value (%1 : $*MyStruct, %0 : $Int64), let, name "p", type $MyStruct, transform {
  bb0(%a : $*MyStruct, %b : $Int64):
    %6 = struct_element_addr %a : $*MyStruct, #MyStruct.x
    %7 = load %6 : $*Int64
    %8 = struct $MyStruct (%7 : $Int64, %b : $Int64)
    return %8 : $MyStruct
  }, loc "file.swift":4:5, scope 1

  // This is a constant: the allocation has nothing to do with it.
  debug_value %1 : $*MyStruct, let, name "c", type $Builtin.Int64, transform {
  bb0(%a : $*MyStruct):
    %9 = integer_literal $Builtin.Int64, 42
    return %9 : $Builtin.Int64
  }, loc "file.swift":5:5, scope 1

  dealloc_stack %1 : $*MyStruct, loc "file.swift":6:5, scope 1
  %r = tuple (), loc "file.swift":7:5, scope 1
  return %r : $(), loc "file.swift":7:5, scope 1
} // end sil function 'reconstructed'

// CopyPropagation shortens the lifetime of the value describing "v", which
// leaves a plain `debug_value undef` behind. It reports subpasses, so with
// -sil-stats-subpass the counter is attributed to the step which killed it.
// PASS: function, killedvars, {{.*}}, CopyPropagation, {{[0-9]+}}, 1, {{[0-9]+}}, plain
// SUBPASS: function, killedvars, {{.*}}, CopyPropagation apply, {{[0-9]+}}.0, 1, {{[0-9]+}}, plain

sil private [ossa] @plain : $@convention(thin) (@inout C) -> () {
bb0(%addr : $*C):
  %f = function_ref @getC : $@convention(thin) () -> (@owned C), loc "other.swift":2:5, scope 2
  %arg = apply %f() : $@convention(thin) () -> (@owned C), loc "other.swift":2:5, scope 2
  %copy = copy_value %arg : $C, loc "other.swift":2:5, scope 2
  store %copy to [assign] %addr : $*C, loc "other.swift":3:5, scope 2
  debug_value %arg : $C, let, name "v", loc "other.swift":4:5, scope 2
  destroy_value %arg : $C, loc "other.swift":5:5, scope 2
  %r = tuple (), loc "other.swift":6:5, scope 2
  return %r : $(), loc "other.swift":6:5, scope 2
} // end sil function 'plain'

// Nothing else is dropped, and a killed variable is never a lost one.
// CHECK-NOT: lostvars
// CHECK-NOT: killedvars
// CHECK-NOT: degradedvars

// Neither counter is reported when it is not asked for.
// NONE-NOT: vars
