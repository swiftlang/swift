// CHECK: debug_value (), let, name "size", type $Builtin.Word, transform {
// CHECK:   bb0:
// CHECK-NEXT: %0 = integer_literal $Builtin.Word, 8
// CHECK-NEXT: return %0 : $Builtin.Word
// CHECK-NEXT: }
sil hidden @test_builtin_sizeof_undef_metatype : $@convention(thin) () -> () {
bb0:
  debug_value undef : $@thick Int64.Type, let, name "size", type $Builtin.Word, transform {
  bb0(%a : $@thick Int64.Type):
    %1 = builtin "sizeof"<Int64>(%a : $@thick Int64.Type) : $Builtin.Word
    return %1 : $Builtin.Word
  }
  %r = tuple ()
  return %r : $()
}

// The following are folded by the C++ instruction simplifications.

// CHECK-LABEL: sil {{.+}} @test_upcast_of_ref_cast
// CHECK: debug_value %0 : $Base, let, name "base"
// CHECK-NOT: transform {
sil hidden @test_upcast_of_ref_cast : $@convention(thin) (@guaranteed Base) -> () {
bb0(%0 : $Base):
  debug_value %0 : $Base, let, name "base", transform {
  bb0(%a : $Base):
    %1 = unchecked_ref_cast %a : $Base to $Derived
    %2 = upcast %1 : $Derived to $Base
    return %2 : $Base
  }
  %r = tuple ()
  return %r : $()
}

