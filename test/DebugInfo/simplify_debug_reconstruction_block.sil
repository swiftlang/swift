// A sum with an undefined value is undefined.
// CHECK-LABEL: sil {{.+}} @test_builtin_add_one_undef
// CHECK: debug_value undef : $Builtin.Int64, let, name "sum"
// CHECK-NOT: transform {
sil hidden @test_builtin_add_one_undef : $@convention(thin) (Builtin.Int64) -> () {
bb0(%0 : $Builtin.Int64):
  debug_value (%0 : $Builtin.Int64, undef : $Builtin.Int64), let, name "sum", type $Builtin.Int64, transform {
  bb0(%a : $Builtin.Int64, %b : $Builtin.Int64):
    %1 = integer_literal $Builtin.Int1, -1
    %2 = builtin "sadd_with_overflow_Int64"(%a : $Builtin.Int64, %b : $Builtin.Int64, %1 : $Builtin.Int1) : $(Builtin.Int64, Builtin.Int1)
    %3 = tuple_extract %2 : $(Builtin.Int64, Builtin.Int1), 0
    return %3 : $Builtin.Int64
  }
  %r = tuple ()
  return %r : $()
}

