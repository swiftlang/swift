// RUN: %target-swift-frontend %s -g -emit-sil -sil-verify-all -Xllvm -verify-continue-on-failure -o /dev/null 2>&1 | %FileCheck %s
import Swift

func foo(_ x: Int)
func bar(_ x: Int)

sil_scope 1 { loc "file.swift":2:6 parent @foo : $@convention(thin) (Int) -> () }
sil_scope 2 { loc "file.swift":6:2 parent @bar : $@convention(thin) (Int) -> () }

// The scope of the instruction needs to belong to the correct function.
// CHECK:      Begin Error in function foo
// CHECK-NEXT: SIL verification failed: debug scope of instruction belongs to a different function
// CHECK:      End Error in function foo
sil hidden @foo : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  debug_value %0 : $Int, let, (name "x", loc "file.swift":8:7, scope 1), loc "file.swift":9:4, scope 2
  %r = tuple()
  return %r : $()
}

// The scope of the debug variable needs to belong to the correct function.
// CHECK:      Begin Error in function bar
// CHECK-NEXT: SIL verification failed: debug variable scope belongs to a different function
// CHECK:      End Error in function bar
sil hidden @bar : $@convention(thin) (Int) -> () {
bb0(%0 : $Int):
  debug_value %0 : $Int, let, (name "x", loc "file.swift":8:7, scope 1), loc "file.swift":9:4, scope 2
  %r = tuple()
  return %r : $()
}
