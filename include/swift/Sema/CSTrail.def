//===----------------------------------------------------------------------===//
///
/// This file enumerates the kinds of SolverTrail::Change.
///
//===----------------------------------------------------------------------===//

#ifndef CHANGE
#define CHANGE(Name)
#endif

#ifndef LOCATOR_CHANGE
#define LOCATOR_CHANGE(Name, Map) CHANGE(Name)
#endif

#ifndef EXPR_CHANGE
#define EXPR_CHANGE(Name) CHANGE(Name)
#endif

#ifndef CLOSURE_CHANGE
#define CLOSURE_CHANGE(Name) CHANGE(Name)
#endif

#ifndef CONSTRAINT_CHANGE
#define CONSTRAINT_CHANGE(Name) CHANGE(Name)
#endif

#ifndef GRAPH_NODE_CHANGE
#define GRAPH_NODE_CHANGE(Name) CHANGE(Name)
#endif

#ifndef BINDING_CONSTRAINT_ADDITION
#define BINDING_CONSTRAINT_ADDITION(PropertyName, Storage)             \
  GRAPH_NODE_CHANGE(Added##PropertyName)
#endif

#ifndef BINDING_CONSTRAINT_RETRACTION
#define BINDING_CONSTRAINT_RETRACTION(PropertyName, Storage)           \
  GRAPH_NODE_CHANGE(Retracted##PropertyName)
#endif

#ifndef BINDING_VAR_RELATION_CHANGE
#define BINDING_VAR_RELATION_CHANGE(Name) CHANGE(Name)
#endif

#ifndef BINDING_VAR_RELATION_ADDITION
#define BINDING_VAR_RELATION_ADDITION(RelationName, Storage)           \
  BINDING_VAR_RELATION_CHANGE(Added##RelationName)
#endif

#ifndef BINDING_VAR_RELATION_RETRACTION
#define BINDING_VAR_RELATION_RETRACTION(RelationName, Storage)         \
  BINDING_VAR_RELATION_CHANGE(Retracted##RelationName)
#endif

#ifndef BINDING_TYPE_RELATION_CHANGE
#define BINDING_TYPE_RELATION_CHANGE(Name) CHANGE(Name)
#endif

#ifndef BINDING_TYPE_RELATION_ADDITION
#define BINDING_TYPE_RELATION_ADDITION(RelationName, Storage)          \
  BINDING_TYPE_RELATION_CHANGE(Added##RelationName)
#endif

#ifndef BINDING_TYPE_RELATION_RETRACTION
#define BINDING_TYPE_RELATION_RETRACTION(RelationName, Storage)        \
  BINDING_TYPE_RELATION_CHANGE(Retracted##RelationName)
#endif

#ifndef SCORE_CHANGE
#define SCORE_CHANGE(Name) CHANGE(Name)
#endif

#ifndef LAST_CHANGE
#define LAST_CHANGE(Name)
#endif

LOCATOR_CHANGE(RecordedDisjunctionChoice, DisjunctionChoices)
LOCATOR_CHANGE(RecordedAppliedDisjunction, AppliedDisjunctions)
LOCATOR_CHANGE(RecordedMatchCallArgumentResult, argumentMatchingChoices)
LOCATOR_CHANGE(RecordedOpenedTypes, OpenedTypes)
LOCATOR_CHANGE(RecordedOpenedExistentialType, OpenedExistentialTypes)
LOCATOR_CHANGE(RecordedDefaultedConstraint, DefaultedConstraints)
LOCATOR_CHANGE(ResolvedOverload, ResolvedOverloads)
LOCATOR_CHANGE(RecordedArgumentList, ArgumentLists)
LOCATOR_CHANGE(RecordedImplicitCallAsFunction, ImplicitCallAsFunctions)
LOCATOR_CHANGE(RecordedSynthesizedConformance, SynthesizedConformances)

EXPR_CHANGE(AppliedPropertyWrapper)
EXPR_CHANGE(RecordedImpliedResult)
EXPR_CHANGE(RecordedExprPattern)

CLOSURE_CHANGE(RecordedClosureType)
CLOSURE_CHANGE(RecordedPreconcurrencyClosure)

CONSTRAINT_CHANGE(DisabledConstraint)
CONSTRAINT_CHANGE(FavoredConstraint)
CONSTRAINT_CHANGE(GeneratedConstraint)

GRAPH_NODE_CHANGE(AddedConstraint)
GRAPH_NODE_CHANGE(RemovedConstraint)
GRAPH_NODE_CHANGE(AddedConstraintToInference)
GRAPH_NODE_CHANGE(RetractedConstraintFromInference)
GRAPH_NODE_CHANGE(AddedLiteral)
GRAPH_NODE_CHANGE(RetractedLiteral)

BINDING_CONSTRAINT_ADDITION(DelayedBy, DelayedBy)
BINDING_CONSTRAINT_RETRACTION(DelayedBy, DelayedBy)

BINDING_CONSTRAINT_ADDITION(Protocol, Protocols)
BINDING_CONSTRAINT_RETRACTION(Protocol, Protocols)

BINDING_CONSTRAINT_ADDITION(Default, Defaults)
BINDING_CONSTRAINT_RETRACTION(Default, Defaults)

BINDING_CONSTRAINT_ADDITION(LValueOf, LValueOf)
BINDING_CONSTRAINT_RETRACTION(LValueOf, LValueOf)

BINDING_VAR_RELATION_ADDITION(AdjacentVar, AdjacentVars)
BINDING_VAR_RELATION_RETRACTION(AdjacentVar, AdjacentVars)

BINDING_VAR_RELATION_ADDITION(SubtypeOf, SubtypeOf)
BINDING_VAR_RELATION_RETRACTION(SubtypeOf, SubtypeOf)

BINDING_VAR_RELATION_ADDITION(SubtypeDelay, SubtypeDelay)
BINDING_VAR_RELATION_RETRACTION(SubtypeDelay, SubtypeDelay)

BINDING_VAR_RELATION_ADDITION(SupertypeOf, SupertypeOf)
BINDING_VAR_RELATION_RETRACTION(SupertypeOf, SupertypeOf)

BINDING_VAR_RELATION_ADDITION(SupertypeDelay, SupertypeDelay)
BINDING_VAR_RELATION_RETRACTION(SupertypeDelay, SupertypeDelay)

BINDING_VAR_RELATION_ADDITION(EquivalentTo, EquivalentTo)
BINDING_VAR_RELATION_RETRACTION(EquivalentTo, EquivalentTo)

BINDING_TYPE_RELATION_ADDITION(ElementType, ElementTypes)
BINDING_TYPE_RELATION_RETRACTION(ElementType, ElementTypes)

SCORE_CHANGE(IncreasedScore)
SCORE_CHANGE(DecreasedScore)

CHANGE(AddedTypeVariable)
CHANGE(ExtendedEquivalenceClass)
CHANGE(RelatedTypeVariables)
CHANGE(UpdatedTypeVariable)
CHANGE(AddedConversionRestriction)
CHANGE(AddedFix)
CHANGE(AddedFixedRequirement)
CHANGE(RecordedOpenedPackExpansionType)
CHANGE(RecordedPackElementExpansion)
CHANGE(RecordedPackExpansionEnvironment)
CHANGE(RecordedNodeType)
CHANGE(RecordedKeyPathComponentType)
CHANGE(RecordedResultBuilderTransform)
CHANGE(RecordedContextualInfo)
CHANGE(RecordedTarget)
CHANGE(RecordedCaseLabelItemInfo)
CHANGE(RecordedPotentialThrowSite)
CHANGE(RecordedIsolatedParam)
CHANGE(RecordedKeyPath)
CHANGE(RetiredConstraint)
CHANGE(AddedBinding)
CHANGE(RetractedBinding)
CHANGE(PrunedDisjunction)

LAST_CHANGE(PrunedDisjunction)

#undef LOCATOR_CHANGE
#undef EXPR_CHANGE
#undef CLOSURE_CHANGE
#undef CONSTRAINT_CHANGE
#undef GRAPH_NODE_CHANGE
#undef BINDING_CONSTRAINT_ADDITION
#undef BINDING_CONSTRAINT_RETRACTION
#undef BINDING_VAR_RELATION_CHANGE
#undef BINDING_VAR_RELATION_ADDITION
#undef BINDING_VAR_RELATION_RETRACTION
#undef BINDING_TYPE_RELATION_CHANGE
#undef BINDING_TYPE_RELATION_ADDITION
#undef BINDING_TYPE_RELATION_RETRACTION
#undef SCORE_CHANGE
#undef LAST_CHANGE
#undef CHANGE
