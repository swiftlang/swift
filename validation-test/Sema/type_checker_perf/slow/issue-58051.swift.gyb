// RUN: %scale-test --invert-result --begin 3 --end 10 --step 1 --select NumConstraintScopes %s -Xfrontend=-typecheck
// REQUIRES: asserts,no_asan

// https://github.com/swiftlang/swift/issues/49221 and https://github.com/swiftlang/swift/issues/58051

struct Date {}

struct S {
  var x: Date?
}

extension S {
  var y: Date? {
    x
%for i in range(0, N):
      ?? x
%end
  }
}
